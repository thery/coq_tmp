% prooftext: formulas and justifications inside the text of a node.
% (load after lexicon/lexicon.elpi, which defines the roles)
%
% A formula is written between backticks, in Rocq syntax, with its role
% as a Pandoc class right after it: `n + 0 = n`{.claim}.  A justification
% is an emphasised name with the class just, *Nat.add_comm*{.just}: a
% hypothesis, a node, a lemma, a rule or a tactic (tactics.elpi).  The
% form of the texts written before the tree, *by X*, is still read, as
% the justification X (README, "The transition").

namespace prooftext {

% [role-tag Role Tag]: the class of a formula of role Role.  A backward
% claim (a role of the lexicon that the format no longer has) has the
% class of a claim: reading the class claim gives rclaim, the first role
% with that class.
pred role-tag o:role, o:string.
role-tag rvar "var".
role-tag rhyp "hyp".
role-tag rclaim "claim".
role-tag rgoal "goal".
role-tag rfact "fact".
role-tag rback "claim".

% [justification-class C]: C is the class of a justification, *X*{.C}
pred justification-class o:string.
justification-class "just".

% [formula Role F S]: the formula F (its text in Rocq syntax) with the
% class of Role
pred formula i:role, i:string, o:string.
formula Role F S :- role-tag Role Tag, !, S is "`" ^ F ^ "`{." ^ Tag ^ "}".

% [untagged-formula F S]: the formula F with no class, `F`: plain text,
% shown and not used by a checker
pred untagged-formula i:string, o:string.
untagged-formula F S :- S is "`" ^ F ^ "`".

% [justification-name J S]: the justification J, *J*{.just}
pred justification-name i:string, o:string.
justification-name J S :- justification-class C, S is "*" ^ J ^ "*{." ^ C ^ "}".

% [is-justification S]: S is a justification in the form *by J*
pred is-justification i:string.
is-justification S :- rex.match "^[*]by .*[*]$" S.

% [is-name S]: S has the form of a name, possibly qualified: h4,
% Nat.add_comm, Corelib.Init.Logic.conj, x'
pred is-name i:string.
is-name S :- rex.match "^[A-Za-z_][A-Za-z0-9_']*\\([.][A-Za-z_][A-Za-z0-9_']*\\)*$" S.

% [is-word S]: S has the form of a justification word: a name (is-name),
% or several words separated by single spaces, each of letters, digits,
% _, ' and - (*mean value inequality*{.just}).  A word of several words
% is no name of Rocq: it can only be a declared word (CypJustification)
pred is-word i:string.
is-word S :- is-name S, !.
is-word S :- rex.match "^[A-Za-z0-9_'-]+\\( [A-Za-z0-9_'-]+\\)+$" S.

% [normal-word S W]: the justification S as a word: without the blanks
% (spaces, tabs, newlines) at its ends, each run of blanks inside it one
% space (a name is unchanged)
pred normal-word i:string, o:string.
normal-word S W :-
  rex.replace "[ \t\n\r]+" " " S S1,
  rex.replace "^ " "" S1 S2, rex.replace " $" "" S2 W.

% ------------------------------------------------------------------
% Reading the text of a node: its parts, for every reader (cyp, the
% Typst writer).  A formula is between backticks (a backtick with no
% other after it is text); right after it may come its class, {.tag},
% then, after spaces, the name given to it, (h).  An emphasised text
% followed by a class, *X*{.tag}, is a tagged name.

% a part of the text of a node, as it is written
kind text-part type.
type plain string -> text-part.         % words
type formula-part string -> string -> option string -> text-part.
                                        % a formula: its class ("" for
                                        % none), its text, the name (h)
                                        % written after it (none for none)
type term-part string -> term -> option string -> text-part.
                                        % a formula given as a Rocq term
                                        % (cyp's Cyp Lemma): its class,
                                        % the term, its name
type tagged-name string -> string -> text-part.
                                        % *X*{.tag}: the class and X; a
                                        % justification for the class just
type by-part string -> text-part.       % *by X*, the justification X of
                                        % the texts written before the tree

% [text-parts Text Parts]: the parts of Text, in order: each formula
% (with what follows it, after-formula) and the text between them, where
% the tagged names and the justifications are (plain-parts)
pred text-parts i:string, o:list text-part.
text-parts Text Parts :-
  rex.match "^[^`]*`[^`]*`" Text, !,
  rex.replace "^\\([^`]*\\)`.*" "\\1" Text Before,
  rex.replace "^[^`]*`\\([^`]*\\)`.*" "\\1" Text F,
  rex.replace "^[^`]*`[^`]*`" "" Text After,
  after-formula After Class Name After1,
  plain-parts Before BeforeParts,
  text-parts After1 Rest,
  std.append BeforeParts [formula-part Class F Name | Rest] Parts.
text-parts Text Parts :- plain-parts Text Parts.

% [after-formula S Class Name Rest]: what S, the text right after a
% formula, gives it: its class {.tag} ("" if there is none; a class that
% is no role's tag is read all the same), then the name (h) after
% spaces (none if there is none); Rest is the text after them
pred after-formula i:string, o:string, o:option string, o:string.
after-formula S Class Name Rest :- formula-class S Class S1, formula-name S1 Name Rest.

% [formula-class S Class Rest]: the class {.tag} at the start of S ("" if
% there is none) and the text after it
pred formula-class i:string, o:string, o:string.
formula-class S Class Rest :-
  rex.match "^{[.][A-Za-z]+}" S, !,
  rex.replace "^{[.]\\([A-Za-z]+\\)}.*" "\\1" S Class,
  rex.replace "^{[.][A-Za-z]+}" "" S Rest.
formula-class S "" S.

% [formula-name S Name Rest]: the name (h), an identifier in parentheses,
% at the start of S after spaces (none if there is none) and the text
% after it
pred formula-name i:string, o:option string, o:string.
formula-name S (some N) Rest :-
  rex.match "^ *([A-Za-z_][A-Za-z0-9_']*)" S, !,
  rex.replace "^ *(\\([A-Za-z_][A-Za-z0-9_']*\\)).*" "\\1" S N,
  rex.replace "^ *([A-Za-z_][A-Za-z0-9_']*)" "" S Rest.
formula-name S none S.

% [plain-parts Text Parts]: a text without formulas: plain text, the
% tagged names *X*{.tag} and the justifications *by X* in it (no part for
% an empty text)
pred plain-parts i:string, o:list text-part.
plain-parts "" [] :- !.
plain-parts Text Parts :-
  rex.match "^.*[*][^*]+[*]{[.][A-Za-z]+}" Text, !,
  rex.replace "^\\(.*\\)[*][^*]+[*]{[.][A-Za-z]+}.*" "\\1" Text Before,
  rex.replace "^.*[*]\\([^*]+\\)[*]{[.][A-Za-z]+}.*" "\\1" Text X0,
  rex.replace "^.*[*][^*]+[*]{[.]\\([A-Za-z]+\\)}.*" "\\1" Text Class,
  rex.replace "^.*[*][^*]+[*]{[.][A-Za-z]+}" "" Text After,
  (if (justification-class Class) (normal-word X0 X) (X = X0)),
  plain-parts Before BeforeParts,
  plain-parts After AfterParts,
  std.append BeforeParts [tagged-name Class X | AfterParts] Parts.
plain-parts Text Parts :-
  rex.match "^.*[*]by [^*]+[*]" Text, !,
  rex.replace "^\\(.*\\)[*]by [^*]+[*].*" "\\1" Text Before,
  rex.replace "^.*[*]by \\([^*]+\\)[*].*" "\\1" Text J0,
  rex.replace "^.*[*]by [^*]+[*]" "" Text After,
  normal-word J0 J,
  plain-parts Before BeforeParts,
  plain-parts After AfterParts,
  std.append BeforeParts [by-part J | AfterParts] Parts.
plain-parts Text [plain Text].

% ------------------------------------------------------------------
% Plain text: a text without its markup (write-document-as untagged,
% document.elpi), for a reader: each formula as it is written, without
% its backticks and its class (the name given to it stays, (h)), each
% tagged name and justification without its emphasis

shown-text prooftext.untagged Text Shown :- plain-text Text Shown.

% [plain-text Text Shown]: the text Text of a node without its markup
pred plain-text i:string, o:string.
plain-text Text Shown :-
  text-parts Text Parts, std.map Parts plain-part Ss, std.string.concat "" Ss Shown.

% [plain-part P S]: the part P without its markup
pred plain-part i:text-part, o:string.
plain-part (plain S) S.
plain-part (formula-part _ F none) F.
plain-part (formula-part _ F (some N)) S :- S is F ^ " (" ^ N ^ ")".
plain-part (term-part _ T N) S :- coq.term->string T F, plain-part (formula-part "" F N) S.
plain-part (tagged-name _ X) X.
plain-part (by-part J) S :- S is "by " ^ J.

}

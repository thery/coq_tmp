% prooftext: the writer of a proof text in Typst, for a PDF.
% (load after document.elpi, formulas.elpi, checked.elpi, maths.elpi and
% links.elpi, and the tables of the lexicon, lang_xx.elpi)
%
% [write-typst D Text] gives the Typst source of the document D: calls of
% the functions of the template typst/local/prooftext/0.1.0/prooftext.typ
% (the Typst package @local/prooftext), which gives each role, step and
% status its look:
%
%   #import "@local/prooftext:0.1.0": *
%   #show: proof-text.with(lang: "en", numbers: false)
%
%   #title-block("and_swap", (
%     ("require", "From Stdlib Require Import Lia."),
%   ))
%
%   #statement[#"Let "#var($A, B : "Prop"$)#". We prove "#claim($A ∧ B → B ∧ A$)#"."]
%
%   #steps((
%     step("1", [#"Assume "#hyp($A ∧ B$)#" "#name("h", label: "1:h")#"."], (
%       step("1.1", [#"By "#named("h", "1:h")#" we have "#claim($B ∧ A$)#" "#by("tauto")#"."], ()),
%     )),
%   ))
%
%   #legend((("var", "variable"), ("hyp", "hypothesis"), ...))
%
% The text of a statement or of a step is cut into its parts (text-parts,
% formulas.elpi): the formulas with their roles (a formula without a class is
% shown without a role), the name (h) given to a formula, right after
% it, the justification *by X*, and the plain text between them, each
% written as a Typst string, so that no character of the text is read as
% Typst markup.  A formula is mathematics, $...$, printed from its Rocq
% term (maths.elpi), or, in the code style or when it does not
% elaborate, its Rocq text as a string, shown as code:
% #claim("A /\\ B -> B /\\ A").  The names and the lemmas are links
% (links.elpi): a name given to a formula is a label, its uses link to
% it; a lemma links to its documentation.  In a text checked by cyp
% (checked.elpi), the status of each text, the conditions left and cyp's
% message become arguments of statement and step, and the steps are
% numbered as cyp numbers them.  The legend at the end gives the words
% of the roles (and of the statuses) in the language of the text.

namespace prooftext {

% ------------------------------------------------------------------
% The document

% how the formulas of a text are shown
kind formula-style type.
type maths formula-style.     % mathematics, from their terms (maths.elpi)
type code formula-style.      % Rocq code, as written

% what the writer knows of the formulas while it goes through a text: the
% style; for mathematics, the notation scope of the text and the
% declarations of the Lets before the current formula, under which it is
% elaborated
kind formulas type.
type in-code formulas.
type in-maths string -> list string -> formulas.

% what the writer knows while it goes through a text: its formulas (above),
% the names in scope, each with the label of the step that introduced it
% (the latest first), and the words of the lexicon of the text's
% language, which are never names (links.elpi)
kind context type.
type context formulas -> list (pair string string) -> list string -> context.

% [write-typst D Text]: the Typst source of the document D, its formulas
% in mathematics
pred write-typst i:prooftext.document, o:string.
write-typst D Text :- write-typst-in maths D Text.

% [write-typst-in Style D Text]: the Typst source of the document D, its
% formulas in the style Style
pred write-typst-in i:formula-style, i:prooftext.document, o:string.
write-typst-in Style (prooftext.document Fields Name _ Statement Steps) Text :-
  prooftext.header-lang Fields Lang,
  (if (text-is-checked Statement) (Checked = tt, Numbers = "true") (Checked = ff, Numbers = "false")),
  prooftext.typst-string Name TName,
  std.map Fields typst-field FieldLines,
  first-context Style Fields Lang C0,
  statement-typst C0 Statement StatementLine C1,
  steps-typst C1 "  " "" 1 Steps StepLines,
  legend-typst Lang Checked LegendLine,
  std.append [
    {calc ("// The proof text " ^ Name ^ ", written by prooftext (write-typst).")},
    "// Its PDF: prooftext/pdf.sh, or typst compile --package-path prooftext/typst.",
    "#import \"@local/prooftext:0.1.0\": *",
    {calc ("#show: proof-text.with(lang: \"" ^ Lang ^ "\", numbers: " ^ Numbers ^ ")")},
    "",
    {calc ("#title-block(" ^ TName ^ ", (")} | FieldLines]
    ["))", "", StatementLine, "", "#steps((" | StepLines] Lines0,
  std.append Lines0 ["))", "", LegendLine] Lines,
  std.string.concat "\n" Lines Text0,
  Text is Text0 ^ "\n".

% [first-context Style Fields Lang C]: the context at the start of a text
% in the language Lang: its first formulas (first-formulas), no names, the
% words of the lexicon of Lang
pred first-context i:formula-style, i:list prooftext.field, i:string, o:context.
first-context Style Fields Lang (context F [] Words) :-
  first-formulas Style Fields F,
  prooftext.lexicon-words Lang Words.

% [first-formulas Style Fields F]: the formulas at the start of a text:
% in mathematics, in the scope of its header (none if it has no scope
% field), without declarations
pred first-formulas i:formula-style, i:list prooftext.field, o:formulas.
first-formulas code _ in-code.
first-formulas maths Fields (in-maths Scope []) :-
  prooftext.field-value Fields "scope" Scope.

% [text-is-checked Statement]: the text was checked (by cyp): its
% statement has a status mark
pred text-is-checked i:string.
text-is-checked Statement :- prooftext.split-checked Statement _ _.

% a field of the header, a pair (key, value)
pred typst-field i:prooftext.field, o:string.
typst-field (prooftext.field Key Value) Line :-
  Line is "  (" ^ {prooftext.typst-string Key} ^ ", " ^ {prooftext.typst-string Value} ^ "),".

% [statement-typst C0 Statement Line C]: the call of statement; C, the
% context after it (with its declarations and its names)
pred statement-typst i:context, i:string, o:string, o:context.
statement-typst C0 Statement Line C :-
  checked-text Statement Check Text, check-arguments Check Arguments,
  (if (Arguments = "") (Call = "#statement") (Call is "#statement(" ^ Arguments ^ ")")),
  text-content C0 "statement" Text Content C,
  Line is Call ^ Content.

% [steps-typst C Indent Prefix K Steps Lines]: the calls of step for
% Steps, the K-th, K+1-th, ... of their list, numbered in Dewey notation
% after Prefix ("" at the top: 1, 2, ...; 2.1 is the first sub-step of 2,
% as cyp numbers its conditions); each one's sub-steps in its list,
% indented.  The declarations and the names of a step hold in its
% sub-steps and in the steps after it in its list, as in cyp (the scope
% of a Let)
pred steps-typst i:context, i:string, i:string, i:int, i:list prooftext.step, o:list string.
steps-typst _ _ _ _ [] [].
steps-typst C0 Indent Prefix K [prooftext.step _ Text0 Sub | Steps] Lines :-
  prooftext.step-number Prefix K Number,
  checked-text Text0 Check Text, check-arguments Check Arguments,
  (if (Arguments = "") (Tail = "") (Tail is ", " ^ Arguments)),
  text-content C0 Number Text Content C,
  Head is Indent ^ "step(" ^ {prooftext.typst-string Number} ^ ", " ^ Content ^ ", (",
  (if (Sub = [])
     (Own = [{calc (Head ^ ")" ^ Tail ^ "),")}])
     (steps-typst C {calc (Indent ^ "  ")} Number 1 Sub SubLines,
      std.append [Head | SubLines] [{calc (Indent ^ ")" ^ Tail ^ "),")}] Own)),
  K1 is K + 1,
  steps-typst C Indent Prefix K1 Steps Next,
  std.append Own Next Lines.

% ------------------------------------------------------------------
% Checked texts

% [checked-text Text Check Rest]: the status, conditions and message of a
% checked text (some C), none for a text that is not checked; Rest is the
% text without them
pred checked-text i:string, o:option prooftext.check, o:string.
checked-text Text (some C) Rest :- prooftext.split-checked Text C Rest, !.
checked-text Text none Text.

% [check-arguments Check Arguments]: the named arguments of statement or
% step that give a status, its conditions and its message ("" for none)
pred check-arguments i:option prooftext.check, o:string.
check-arguments none "".
check-arguments (some (prooftext.checked Status Conditions Message)) Arguments :-
  optional-argument "conditions" Conditions C,
  optional-argument "message" Message M,
  std.filter [{calc ("status: " ^ {prooftext.typst-string Status})}, C, M] (a\ not (a = "")) As,
  std.string.concat ", " As Arguments.

pred optional-argument i:string, i:option string, o:string.
optional-argument _ none "".
optional-argument Name (some V) A :- A is Name ^ ": " ^ {prooftext.typst-string V}.

% ------------------------------------------------------------------
% The legend

% [legend-typst Lang Checked Line]: the call of legend: the words of the
% roles in the language Lang, and of the statuses for a checked text
% (Checked = tt); the words of the lexicon, legend-var, legend-ok, ...
pred legend-typst i:string, i:bool, o:string.
legend-typst Lang Checked Line :-
  std.map ["var", "hyp", "claim", "fact"] (legend-pair Lang) Roles,
  (if (Checked = tt)
     (std.map ["ok", "ko", "todo", "none"] (legend-pair Lang) Statuses,
      Tail is ", statuses: (" ^ {std.string.concat ", " Statuses} ^ ",)")
     (Tail = "")),
  Line is "#legend((" ^ {std.string.concat ", " Roles} ^ ",)" ^ Tail ^ ")".

% [legend-pair Lang Key Pair]: the pair (Key, word of Key) of the legend,
% the word legend-Key of the lexicon (Key itself when the language has
% none)
pred legend-pair i:string, i:string, o:string.
legend-pair Lang Key Pair :-
  (write-word Lang {calc ("legend-" ^ Key)} Word, ! ; Word = Key),
  Pair is "(" ^ {prooftext.typst-string Key} ^ ", " ^ {prooftext.typst-string Word} ^ ")".

% ------------------------------------------------------------------
% The parts of a text (text-parts, formulas.elpi)

% [text-content C0 Where Text Content C]: the Typst content of the text
% of the statement (Where = "statement") or of the step numbered Where,
% [...] with one call per part; C, the context after it
pred text-content i:context, i:string, i:string, o:string, o:context.
text-content C0 Where Text Content C :-
  prooftext.text-parts Text Parts,
  parts-typst C0 Where Parts Calls C,
  std.string.concat "" Calls Inner,
  Content is "[" ^ Inner ^ "]".

% [parts-typst C0 Where Parts Calls C]: the Typst code of each part, in
% order, each formula under the declarations before it, each name under
% the names introduced before it
pred parts-typst i:context, i:string, i:list prooftext.text-part, o:list string, o:context.
parts-typst C _ [] [] C.
parts-typst C0 Where [P | Ps] [Call | Calls] C :-
  part-typst C0 Where P Call C1, parts-typst C1 Where Ps Calls C.

% [part-typst C0 Where Part Call C]: the Typst code of a part.  A formula
% whose class is a role's tag is shown with that role (var, hyp, claim,
% fact), other formulas without a role (formula), followed by the name
% written after it (name-typst); a justification and the words of the
% text link to what they name
pred part-typst i:context, i:string, i:prooftext.text-part, o:string, o:context.
part-typst C _ (prooftext.plain S) Call C :- plain-typst C S Call.
part-typst (context F0 Names Words) Where (prooftext.formula-part Tag Formula Name) Call C :-
  formula-typst F0 Tag Formula Shown F,
  (if (prooftext.role-tag _ Tag) (Role = Tag) (Role = "formula")),
  name-typst (context F Names Words) Where Tag Name NameCall C,
  Call is "#" ^ Role ^ "(" ^ Shown ^ ")" ^ NameCall.
part-typst (context F Names Words) _ (prooftext.by-part J) Call (context F Names Words) :-
  justification-link Names J Arguments,
  Call is "#by(" ^ {prooftext.typst-string J} ^ Arguments ^ ")".

% [name-typst C0 Where Tag Name Call C]: the Typst code of the name (h)
% written after a formula of class Tag, after one space ("" for none).
% After a fact (a mention), it is the name of the hypothesis the fact
% is, a link to it; after another formula (a hypothesis, or a claim that
% a later step names), it is introduced: labelled Where:h, and put in
% scope
pred name-typst i:context, i:string, i:string, i:option string, o:string, o:context.
name-typst C _ _ none "" C.
name-typst (context F Names Words) _ "fact" (some N) Call (context F Names Words) :- !,
  (if (prooftext.name-in-scope Names N Label)
     (Arguments is ", target: " ^ {prooftext.typst-string Label})
     (Arguments = "")),
  Call is "#\" \"#name(" ^ {prooftext.typst-string N} ^ Arguments ^ ")".
name-typst (context F Names Words) Where _ (some N) Call (context F Names1 Words) :-
  prooftext.name-label Where N Label,
  (if (std.mem! Names (pr N Label))
     % the same name given twice in one text: the first one is the label
     (Names1 = Names, Arguments = "")
     (Names1 = [pr N Label | Names], Arguments is ", label: " ^ {prooftext.typst-string Label})),
  Call is "#\" \"#name(" ^ {prooftext.typst-string N} ^ Arguments ^ ")".

% [justification-link Names J Arguments]: the link of the justification J,
% as arguments of by: to the documentation of a lemma, or to the step that
% introduced the name J ("" for none)
pred justification-link i:list (pair string string), i:string, o:string.
justification-link _ J Arguments :- prooftext.documentation-url J Url, !,
  Arguments is ", url: " ^ {prooftext.typst-string Url}.
justification-link Names J Arguments :- prooftext.name-in-scope Names J Label, !,
  Arguments is ", target: " ^ {prooftext.typst-string Label}.
justification-link _ _ "".

% [plain-typst C Text Call]: the Typst code of a plain text: its words that
% are names in scope link to the steps that introduced them (named), the
% words that name a lemma with a documentation link to it (cited), the
% rest is strings.  A word of the lexicon is neither
pred plain-typst i:context, i:string, o:string.
plain-typst C Text Call :-
  prooftext.text-pieces Text Pieces,
  std.map Pieces (piece-typst C) Shown,
  joined-strings Shown Calls,
  std.string.concat "" Calls Call.

% a piece of plain text, as the writer shows it
kind shown-piece type.
type as-text string -> shown-piece.        % text, written as a string
type as-call string -> shown-piece.        % a call (a link)

% [piece-typst C Piece Shown]: a word as a link to its step or to its
% documentation, or as text
pred piece-typst i:context, i:prooftext.text-piece, o:shown-piece.
piece-typst (context _ Names Words) (prooftext.word W) (as-call Call) :-
  not (prooftext.lexicon-word Words W),
  prooftext.name-in-scope Names W Label, !,
  Call is "#named(" ^ {prooftext.typst-string W} ^ ", " ^ {prooftext.typst-string Label} ^ ")".
piece-typst (context _ _ Words) (prooftext.word W) (as-call Call) :-
  not (prooftext.lexicon-word Words W),
  prooftext.documentation-url W Url, !,
  Call is "#cited(" ^ {prooftext.typst-string W} ^ ", " ^ {prooftext.typst-string Url} ^ ")".
piece-typst _ (prooftext.word W) (as-text W).
piece-typst _ (prooftext.other S) (as-text S).

% [joined-strings Pieces Calls]: the pieces in order, the texts next to
% each other joined in one string #"..."
pred joined-strings i:list shown-piece, o:list string.
joined-strings [] [].
joined-strings [as-text A, as-text B | Ps] Calls :- !,
  joined-strings [as-text {calc (A ^ B)} | Ps] Calls.
joined-strings [as-text A | Ps] [C | Calls] :- !,
  C is "#" ^ {prooftext.typst-string A}, joined-strings Ps Calls.
joined-strings [as-call C | Ps] [C | Calls] :- joined-strings Ps Calls.

% [formula-typst F0 Tag Formula Shown F]: the formula of class Tag as the
% argument of its role's function: mathematics $...$, or its Rocq text
% as a string (shown as code) in the code style or when it does not
% elaborate.  A declaration (a Let) is added to the declarations of the
% formulas after it
pred formula-typst i:formulas, i:string, i:string, o:string, o:formulas.
formula-typst in-code _ Formula Shown in-code :- prooftext.typst-string Formula Shown.
formula-typst (in-maths Scope Ds) Tag Formula Shown (in-maths Scope Ds1) :-
  prooftext.is-declaration Tag Formula, !,
  std.append Ds [Formula] Ds1,
  maths-or-code (prooftext.declaration-maths Scope Ds Formula) Formula Shown.
formula-typst (in-maths Scope Ds) _ Formula Shown (in-maths Scope Ds) :-
  maths-or-code (prooftext.formula-maths Scope Ds Formula) Formula Shown.

% [maths-or-code Print Formula Shown]: $M$ when Print E gives the formula
% tree E of the formula (M, its Typst code), else its text as a Typst
% string
pred maths-or-code i:(prooftext.mexp -> prop), i:string, o:string.
maths-or-code Print _ Shown :- Print E, !, Shown is "$" ^ {prooftext.maths-typst E} ^ "$".
maths-or-code _ Formula Shown :- prooftext.typst-string Formula Shown.

% ------------------------------------------------------------------
% Choosing the writer

% [write-as File D Text]: the text of D in the format of the file File:
% Typst for a file .typ, Markdown otherwise
pred write-as i:string, i:prooftext.document, o:string.
write-as File D Text :- rex.match ".*[.]typ$" File, !, write-typst D Text.
write-as _ D Text :- prooftext.write-document D Text.

}

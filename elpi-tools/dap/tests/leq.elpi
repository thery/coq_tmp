% CHR: the order constraint leq X Y on unknown integers, with a
% simplification rule (reflexivity), a simplification that removes two
% constraints (antisymmetry) and a propagation rule (transitivity) whose
% guard fails on leq X Y, leq Y X.

constraint leq {
  rule \ (leq X Y) | (X == Y) <=> true.
  rule \ (leq X Y) (leq Y X) <=> (X = Y).
  rule (leq X Y) (leq Y Z) | (not (X == Z)) <=> (leq X Z).
}

func leq int, int.
leq X Y :- var X, var Y, !, declare_constraint (leq X Y) [X, Y].
leq X Y :- var X, !, declare_constraint (leq X Y) [X].
leq X Y :- var Y, !, declare_constraint (leq X Y) [Y].
leq X Y :- X =< Y.

% [chain N Xs]: leq X1 X2, ..., leq Xn-1 Xn on N new variables.
pred chain i:int, o:list int.
chain 1 [_] :- !.
chain N [X, Y | Xs] :- M is N - 1, chain M [Y | Xs], leq X Y.

% debug.elpi: a debugger for standalone Elpi, written as a meta-interpreter
% in Elpi.
%
% [debug.run Options Goal] runs Goal (a goal, a term of type (pred)) by
% interpreting the clauses of the debugged program, which are given as data
% (section 1).  Along the way it shows the four ports of each call (call,
% exit, redo, fail), stops at breakpoints, counts calls and time per
% predicate, and when Goal fails it explains the deepest failing goal: the
% clauses tried and why each one did not apply.
%
% The design and its limits are described in README.md.

namespace debug {

% ===== 1. The debugged program, as data ==================================
%
% The program is read by elpi-tools/reflect (../reflect/README.md): its
% rules are the facts [reflect.clause P Index Loc Attributes Head Body] and
% its declarations the facts [reflect.signature Name P F Args Variadic Loc].

% [program-clause P Head Body Origin]: by backtracking, the rules of P in
% Elpi's order, with fresh variables, and where each one comes from.
pred program-clause i:any, o:(pred), o:(pred), o:origin.
program-clause P Head Body Origin :-
  reflect.clause P _ Loc Attrs Head Body,
  constant Head Q _, same_term Q P,     % (overloaded rules have no index)
  Origin = at Loc Attrs.

% Where a candidate clause comes from: a rule of the program, at a source
% location, or a hypothetical clause, added by a call.  Turned into text
% only when shown.
data origin.
symb at reflect.srcloc -> list reflect.attribute -> origin.
symb added-by string -> int -> origin.   % its text, a number of its own

func origin-string origin -> string.
origin-string (added-by S _) S.
origin-string (at (reflect.srcloc File Line _) _) S :-
  rex.replace "^.*/" "" File Base,
  S is Base ^ ":" ^ {std.any->string Line}.

% The mode of an argument: [i] (input: the goal argument is matched, its
% variables are not assigned) or [o] (output: it is unified).
data mode.
symb i mode.
symb o mode.

% [declared P Modes]: P is a predicate of the program, declared with these
% modes.  [run] installs one such local clause per signature, indexed by P.
% A predicate that is declared with no rule is reported as such when called.
pred declared o:any, o:list mode.

% [declarations Ds]: the [declared] clauses of the program's signatures.
pred declarations o:list (pred).
declarations Ds :-
  std.findall (reflect.signature _ _ _ _ _ _) Sigs,
  std.fold Sigs [] add-declaration Ds.

func add-declaration (pred), list (pred) -> list (pred).
add-declaration (reflect.signature _ P _ Args _ Loc) Ds [declared P Modes | Ds] :-
  not (var P), not (builtin-loc Loc), !, std.map Args arg-mode Modes.
add-declaration _ Ds Ds.

% [builtin-loc Loc]: a declaration of Elpi's builtins or standard library
% (printed by elpi-reflect -builtins), which runs natively.
pred builtin-loc i:reflect.srcloc.
builtin-loc (reflect.srcloc File _ _) :- rex.match "^builtin[a-z_]*\\.elpi$" File.

func arg-mode reflect.arg -> mode.
arg-mode (reflect.arg reflect.in _) i.
arg-mode (reflect.arg reflect.out _) o.

% [write-bridges File]: write to File the bridge of each declared predicate
% (see section 6); the driver accumulates File before the program.
pred write-bridges i:string.
write-bridges File :-
  open_out File Out,
  output Out "% Bridges: the first native clause of each program predicate (see debug.elpi).\n",
  std.findall (reflect.signature _ _ _ _ ff _) Sigs,
  std.fold Sigs [] (write-bridge Out) _,
  close_out Out.

% [write-bridge Out Sig Done Done1]: one bridge per predicate name.
func write-bridge out_stream, (pred), list string -> list string.
write-bridge _ (reflect.signature Name _ _ _ _ _) Done Done :- std.mem! Done Name, !.
write-bridge Out (reflect.signature Name P _ Args _ Loc) Done [Name|Done] :- not (var P), not (builtin-loc Loc), !,
  std.length Args N, std.iota N Is,
  std.map Is (i\ s\ s is " X" ^ {std.any->string i}) Vars,
  std.string.concat "" Vars Xs,
  Goal is "(" ^ Name ^ Xs ^ ")",
  output Out {calc (Goal ^ " :- !, debug.bridge " ^ Goal ^ ".\n")}.
write-bridge _ _ Done Done.

% ===== 2. Options and state ===============================================

data option.
symb trace option.             % show every port of every call
symb builtins option.          % also show the calls to builtins
symb break string -> option.   % breakpoint on the predicate of this name
symb interactive option.       % at a stop, read commands from stdin
symb profile option.           % counts and time per predicate
symb no-explain option.        % do not explain the final failure
% The strategy (the defaults are Elpi's: rules in order, with backtracking):
symb random-order option.      % try the candidate clauses in a random order
symb seed int -> option.       % seed of the random order
symb first-solution option.    % keep the first solution of each call (no redo)
symb max-depth int -> option.  % calls deeper than this fail
symb ignore-cut option.        % a cut does nothing (every clause is a candidate)
symb echo option.             % print each command read (scripted sessions)

% [opt O]: option O is on (a local clause installed by [run]).
pred opt o:option.

% [quiet]: no option shows or records ports (installed by [run]), so the
% ports do nothing: the fast path.
pred quiet.

% [seed-random Options]: initialise the random generator with option seed N;
% without it the generator is left as it is (a caller such as a property
% checker seeds it itself).
pred seed-random i:list option.
seed-random Options :- std.mem Options (seed N), !, random.init N.
seed-random _.

pred quiet-flag i:list option, o:list (pred).
quiet-flag Options [] :- std.exists! Options noisy, !.
quiet-flag _ [quiet].

pred noisy i:option.
noisy trace.
noisy builtins.
noisy (break _).
noisy interactive.
noisy profile.

% [state Name S]: the safes holding what must survive backtracking:
% "deepest" (the deepest failure so far), "mode" (the stepping mode chosen
% at a stop), "request" (a retry or fail asked at a stop), "breaks" (the
% breakpoints set or removed at a stop), "profile" (the port events),
% "warned" (the predicates already reported as having no clause), "eigen"
% and "suspension" (counters for the names of eigenvariables and delays).
pred state o:string, o:safe.

% A box is one call of a predicate: its invocation number, its depth, its
% predicate, the goal, the boxes it is called from (the nearest first) and
% how it was entered ("call", or "wake" for a goal resumed by CHR).
data box.
symb box int -> int -> any -> (pred) -> list frame -> string -> box.

% A frame is what a box leaves on the stack of the calls below it: its
% invocation number, depth, predicate and goal.  A frame does not hold the
% frames above it, so a stack is a flat list (a stack of boxes holding
% their own ancestors would be a DAG, which Elpi copies as a tree).
data frame.
symb frame int -> int -> any -> (pred) -> frame.

% A context is where a goal runs: its depth and the frames above it.
data ctx.
symb ctx int -> list frame -> ctx.

% [current-ctx K Ctx]: the context of the innermost builtin call, so that a
% program predicate called back from native code (from [std.map], [not], a
% woken constraint...) gets a box at the right place; K is "call", or
% "wake" for a goal suspended by declare_constraint.
:nooc
pred current-ctx o:string, o:ctx.

% ===== 3. Entry point =====================================================

% [run Options Goal] interprets Goal under Options.  It succeeds once per
% solution; on final failure it explains the deepest failing goal.
pred run i:list option, o:(pred).
run Options Goal :-
  declarations Decls,
  seed-random Options,
  new_safe Deepest, new_safe Mode, new_safe Prof, new_safe Warned,
  new_safe Request, new_safe Breaks, new_safe Eigens, new_safe Suspensions,
  stash_in_safe Mode {initial-mode Options},
  std.map Options (o\ c\ c = opt o) OptClauses,
  quiet-flag Options Quiet,
  std.append OptClauses
    [state "deepest" Deepest, state "mode" Mode, state "profile" Prof,
     state "warned" Warned, state "request" Request, state "breaks" Breaks,
     state "eigen" Eigens, state "suspension" Suspensions,
     current-ctx "call" (ctx 0 []) | {std.append Quiet Decls}]
    Local,
  Local => run-top Goal.

% [run-top Goal]: the query, with its outcome reported.
pred run-top o:(pred).
run-top Goal :- compile (ctx 0 []) [] Goal Code _, Code, report-solution.
run-top _ :- report-final-failure, fail.

% ===== 4. Clause bodies, and the cut ======================================
%
% The cut is the classic difficulty of a meta-interpreter: a cut in the
% body of a clause must discard the remaining clauses of the goal being
% solved and the choice points of the goals before it, but those choice
% points belong to the interpreter, and Elpi has no "cut to here".
%
% Our solution: a body is not interpreted goal by goal, it is *compiled*
% into a native Elpi goal in which each atomic goal G becomes
% [debug.goal Ctx G] while the connectives (conjunction, pi, sigma, =>, ;)
% and the cut itself stay native.  [backchain] calls the compiled body as
% the last goal of its own clause: there, the native cut discards exactly
% the remaining candidate clauses of [backchain] (the other clauses of the
% user's goal) and the choice points of the goals before it in the body,
% which is Elpi's semantics.  Elpi's cut is transparent through pi, sigma
% and => and local to ; (checked on elpi 4.0.0), and keeping these
% connectives native keeps that behaviour too.

% [compile Ctx Names Body Code Names1]: Code runs Body in context Ctx.
% Names are the source names of the binders of Body, in textual order (from
% reflect; [] when unknown), Names1 those left after Body: a pi names its
% eigenvariable with the first one.  Outside the fast path, pi and =>
% have their ports (still in line, so that the cut goes through them).
:nooc
pred compile o:ctx, i:list string, i:(pred), o:(pred), o:list string.
compile Ctx Ns G (debug.goal Ctx G) Ns :- var G, !.
compile _ Ns ! true Ns :- opt ignore-cut, !.
compile Ctx Ns ! (debug.cut-port Ctx, !) Ns :- !.
compile _ Ns true true Ns :- !.
compile Ctx Ns G Code Ns1 :- conjuncts G Gs, !, compile-all Ctx Ns Gs Codes Ns1, mk-conj Codes Code.
compile Ctx Ns (pi x\ F x) (pi x\ Code x) Ns1 :- quiet, !,
  next-name Ns _ Ns0, pi x\ compile Ctx Ns0 (F x) (Code x) Ns1.
compile Ctx Ns (pi x\ F x) (pi x\ debug.pi-port Ctx Name x (F x) N, (debug.eigen x N => Code x)) Ns1 :- !,
  next-name Ns Name Ns0, pi x\ compile Ctx Ns0 (F x) (Code x) Ns1.
compile Ctx Ns (sigma x\ F x) Code Ns1 :- !, next-name Ns _ Ns0, compile Ctx Ns0 (F _) Code Ns1.
compile Ctx Ns (H => B) (debug.assume Ctx H B Hyps, Hyps => Code) Ns1 :- !,
  drop-names H Ns Ns0, compile Ctx Ns0 B Code Ns1.
compile Ctx Ns (A ; B) (CA ; CB) Ns2 :- !, compile Ctx Ns A CA Ns1, compile Ctx Ns1 B CB Ns2.
compile Ctx Ns (declare_constraint G Keys) (debug.delay Ctx G Keys) Ns1 :- !, drop-names G Ns Ns1.
compile Ctx Ns G (debug.goal Ctx G) Ns1 :- drop-names G Ns Ns1.

% [next-name Ns Name Ns1]: the name of the next binder ("x" when unknown).
pred next-name i:list string, o:string, o:list string.
next-name [N|Ns] N Ns :- !.
next-name [] "x" [].

% [drop-names T Ns Ns1]: the names of the binders of T are skipped.
pred drop-names i:any, i:list string, o:list string.
drop-names _ [] [] :- !.
drop-names T Ns Ns1 :- lambda-count T N, std.length Ns L, N =< L, !, std.drop N Ns Ns1.
drop-names _ _ [].

:nooc
pred compile-all o:ctx, i:list string, i:list (pred), o:list (pred), o:list string.
compile-all _ Ns [] [] Ns.
compile-all Ctx Ns [G|Gs] [C|Cs] Ns2 :- compile Ctx Ns G C Ns1, compile-all Ctx Ns1 Gs Cs Ns2.

% [mk-conj Goals G]: G is the conjunction of Goals.
:nooc
pred mk-conj i:list (pred), o:(pred).
mk-conj [] true.
mk-conj [G] G :- !.
mk-conj [G|Gs] (G, C) :- mk-conj Gs C.

% [conjuncts G Gs]: G is a conjunction of the goals Gs.  Elpi represents
% (A, B, C) as one n-ary node and has no builtin to take it apart, so each
% arity needs its own pattern; up to 16 goals at the same level.
pred conjuncts i:(pred), o:list (pred).
conjuncts (A1,A2) [A1,A2].
conjuncts (A1,A2,A3) [A1,A2,A3].
conjuncts (A1,A2,A3,A4) [A1,A2,A3,A4].
conjuncts (A1,A2,A3,A4,A5) [A1,A2,A3,A4,A5].
conjuncts (A1,A2,A3,A4,A5,A6) [A1,A2,A3,A4,A5,A6].
conjuncts (A1,A2,A3,A4,A5,A6,A7) [A1,A2,A3,A4,A5,A6,A7].
conjuncts (A1,A2,A3,A4,A5,A6,A7,A8) [A1,A2,A3,A4,A5,A6,A7,A8].
conjuncts (A1,A2,A3,A4,A5,A6,A7,A8,A9) [A1,A2,A3,A4,A5,A6,A7,A8,A9].
conjuncts (A1,A2,A3,A4,A5,A6,A7,A8,A9,A10) [A1,A2,A3,A4,A5,A6,A7,A8,A9,A10].
conjuncts (A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11) [A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11].
conjuncts (A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12) [A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12].
conjuncts (A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13) [A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13].
conjuncts (A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13,A14) [A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13,A14].
conjuncts (A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13,A14,A15) [A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13,A14,A15].
conjuncts (A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13,A14,A15,A16) [A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13,A14,A15,A16].

% [structural G]: G is a connective, handled by [compile].
pred structural i:(pred).
structural ! :- !.
structural G :- conjuncts G _, !.
structural (pi x\ F_ x) :- !.
structural (sigma x\ F_ x) :- !.
structural (H_ => B_) :- !.
structural (A_ ; B_) :- !.

% ===== 5. Goals: program predicates and builtins ==========================

% [goal Ctx G]: run the atomic goal G (or a goal only known at run time).
:nooc
pred goal o:ctx, i:(pred).
goal _ G :- var G, !, std.fatal-error "debug: the goal is a variable".
% A connective known only at run time (a goal passed in a variable) is
% compiled now; a cut in it is local to this goal (see README).
goal Ctx G :- structural G, !, compile Ctx [] G Code _, Code.
goal Ctx G :- program-goal G P, !, call Ctx P G "call".
goal Ctx G :- native Ctx G.

% [program-goal G P]: G is a call to the predicate P of the program (it
% has clauses, a declaration, or hypothetical clauses in scope).
pred program-goal i:(pred), o:any.
program-goal G P :- constant G P _, bridged P.

% [native Ctx G]: run the builtin (or external) goal G natively.  Program
% predicates it calls back reach [bridge] with context Ctx.
:nooc
pred native o:ctx, i:(pred).
native Ctx G :-
  native-port "call" Ctx G,
  new_safe Exited,
  native-ports Exited Ctx G.

% (The alternatives of a box are clauses, not ; whose arguments are inputs
% that Elpi would match, walking the whole stack of frames at each call.)
:nooc
pred native-ports i:safe, o:ctx, i:(pred).
native-ports Exited Ctx G :- run-native Ctx G, native-port "exit" Ctx G, stash_in_safe Exited "exited".
native-ports Exited Ctx G :- native-port "fail" Ctx G, note-native-failure-if-first Exited Ctx G, fail.

% [run-native Ctx G]: run G, with Ctx as the context of the program goals
% it may call back.  Elpi copies a local clause, and Ctx holds the goals of
% all the calls above, so Ctx is installed only when G may call back.
:nooc
pred run-native o:ctx, i:(pred).
run-native Ctx G :- may-call-back G, !, (current-ctx "call" Ctx => G).
run-native _ G :- G.

% [may-call-back T]: T mentions a program predicate or a λ-term (a
% predicate argument such as x\ y\ rev x y), which native code may call.
pred may-call-back i:any.
may-call-back T :- var T, !, fail.
may-call-back T :- is_cdata T _, !, fail.
may-call-back T :- constant T P Args, !, (bridged P ; std.exists Args may-call-back).
may-call-back T :- name T _ Args, !, std.exists Args may-call-back.
may-call-back T :- T = [], !, fail.
may-call-back T :- T = [X|L], !, (may-call-back X ; may-call-back L).
may-call-back _.      % a λ-term, or a connective (,), =, pi...: assume it may

% [delay Ctx G Keys]: suspend G on Keys with the real declare_constraint,
% so that the CHR rules and the resumption are the engine's own; when G is
% woken, its program predicate reaches [bridge], which gives it a box
% entered through the resume port, with the number of the suspension.
:nooc
pred delay o:ctx, i:(func), i:any.
delay Ctx G Keys :-
  suspension-number K,
  delay-port Ctx G Keys K,
  Entry is "wake " ^ {std.any->string K},
  ( (current-ctx Entry Ctx => declare_constraint G Keys)
  ; note-goal-failure Ctx G
      ["declare_constraint failed: adding this constraint fired a CHR rule that failed"],
    fail ).

% [suspension-number K]: the number of a new suspension (0 when no port is
% shown).
pred suspension-number o:int.
suspension-number 0 :- quiet, !.
suspension-number K :- new-number "suspension" K.

% ===== 6. Bridges from native code back to the interpreter ===============
%
% Native code (std.map, not, findall, a woken constraint...) calls program
% predicates natively.  Each program predicate P gets, as its first native
% clause, the bridge  [P X1..XN :- !, debug.bridge (P X1..XN)],  which
% sends such a call back to the interpreter; the cut makes the program's
% own native clauses (loaded for their declarations) dead code.
%
% The bridges of the declared predicates are static clauses, written by
% [write-bridges] (section 1) and accumulated by the driver before the
% program.  They could be built here as
% local clauses [pi x1..xN\ ...], and they are for the predicates that only
% have hypothetical clauses, but elpi 4.0.0 crashes ("index out of bounds")
% when a CHR rule fires on a constraint whose predicate has such a local
% clause in scope (LPCIC/elpi#505, https://github.com/LPCIC/elpi/issues/505;
% tests/elpi-bugs/chr-pi-local-clause.elpi).

% [bridged P]: P is a predicate of the program (it has a bridge): a
% declared predicate, or one given a bridge by [assume].
pred bridged o:any.
bridged P :- declared P _.

pred bridge i:(pred).
bridge G :- current-ctx Kind Ctx, !, program-goal G P, call Ctx P G Kind.

% [bridge-clause P Args N C]: C is the local bridge of P applied to Args
% and to N more arguments.
func bridge-clause any, list any, int -> (pred).
bridge-clause P Acc 0 (G :- debug.bridge G) :- !, std.rev Acc Args, constant G P Args.
bridge-clause P Acc N (pi x\ C x) :- M is N - 1, pi x\ bridge-clause P [x|Acc] M (C x).

% ===== 7. Calls: the box and backchaining =================================

% [note-failure-if-first Exited Box]: record the failure of Box if it never
% exited (and likewise for a builtin goal).
:nooc
pred note-failure-if-first i:safe, o:box.
note-failure-if-first Exited Box :- never Exited, !,
  box-goal Box P G, warn-if-no-clause P G, note-failure Box.
note-failure-if-first _ _.

:nooc
pred note-native-failure-if-first i:safe, o:ctx, i:(pred).
note-native-failure-if-first Exited Ctx G :- never Exited, !, note-native-failure Ctx G.
note-native-failure-if-first _ _ _.

% [never S]: nothing was stashed in S.
pred never i:safe.
never S :- open_safe S [].

% [call Ctx P G Kind]: the box of a call of the program predicate P, with
% its four ports.  The redo port is the classic trick: once the box has
% exited, backtracking into it first runs [port "redo"] and then fails into
% the choice points left inside.  Only a call that fails without ever
% exiting is a candidate for the failure explanation: a fail after a redo
% is the normal end of an enumeration.  The safe Exited remembers the
% exits across backtracking.
:nooc
pred call o:ctx, i:any, i:(pred), i:string.
call (ctx D Above) P G Kind :-
  new_int Id,
  run-box (box Id D P G Above Kind) G.

% [run-box Box G]: the ports around backchaining.  (The box is built as an
% argument, not with =, which would run the occurs check on it.)
:nooc
pred run-box o:box, i:(pred).
run-box Box G :-
  new_safe Exited,
  attempt Exited Box G.

% [attempt Exited Box G]: the call; its second clause is the choice point
% that a retry or fail command of the stepper unwinds to (see section 11).
:nooc
pred attempt i:safe, o:box, i:(pred).
attempt Exited Box G :- box-ports Exited Box G.
attempt Exited Box G :- resumed-by-request Exited Box G.

:nooc
pred resumed-by-request i:safe, o:box, i:(pred).
resumed-by-request Exited Box G :-
  box-id-goal Box Id _, take-request Id R, after-request R Exited Box G.

:nooc
pred after-request i:request, i:safe, o:box, i:(pred).
after-request (retry _) Exited Box G :- attempt Exited Box G.
after-request (fail-call _) Exited Box G :- forced-fail Exited Box G.

% [forced-fail Exited Box G]: the fail port of a call made to fail (where
% a retry may still be asked).
:nooc
pred forced-fail i:safe, o:box, i:(pred).
forced-fail _ Box _ :- port "fail" Box, fail.
forced-fail Exited Box G :- resumed-by-request Exited Box G.

% [box-ports Exited Box G]: the call port, backchaining and then the exit
% port; on backtracking, the redo port; when all is exhausted, the fail
% port.  (Alternatives as clauses, not ;, see [native-ports].)
:nooc
pred box-ports i:safe, o:box, i:(pred).
box-ports Exited Box G :-
  port "call" Box, solutions Box G, stash_in_safe Exited "exited", exit-or-redo Box.
box-ports Exited Box _ :- port "fail" Box, note-failure-if-first Exited Box, fail.

% [solutions Box G]: the solutions of G by backchaining, or only the first
% one with option first-solution (a cut here discards those choice points).
:nooc
pred solutions o:box, i:(pred).
solutions Box G :- opt first-solution, !, backchain Box G, !.
solutions Box G :- backchain Box G.

:nooc
pred exit-or-redo o:box.
exit-or-redo Box :- port "exit" Box.
exit-or-redo Box :- port "redo" Box, fail.

% [backchain Box G]: try the candidate clauses of G in Elpi's order (the
% hypothetical clauses, most recent first, then the program clauses) and
% run the body of each one whose head applies.  The compiled body is the
% last goal, so that a cut in it is the native cut of this clause.
:nooc
pred backchain o:box, i:(pred).
backchain Box G :-
  box-parts Box Id D P Above,
  modes-of P G Modes,
  within-depth D,
  strategy-candidate P G Origin Head Body,
  try-port Box Origin Head,
  body-names Origin Head Body Names,
  match-and-port Modes Box Origin G Head,
  D1 is D + 1,
  compile (ctx D1 [frame Id D P G | Above]) Names Body Code _,
  Code.

% [body-names Origin Head Body Names]: the source names of the binders of
% the body of a rule (none for a hypothetical clause, or on the fast path).
pred body-names i:origin, i:(pred), i:(pred), o:list string.
body-names _ _ _ [] :- quiet, !.
body-names (at _ Attrs) Head Body Names :- !,
  binder-strings Attrs All, binder-names Head Body All Names.
body-names _ _ _ [].

% [box-parts Box Id Depth P Above]: the parts of a box (by head
% unification: an as-pattern would be an equation, with an occurs check).
:nooc
pred box-goal o:box, o:any, o:(pred).
box-goal (box _ _ P G _ _) P G.

:nooc
pred box-id-goal o:box, o:int, o:(pred).
box-id-goal (box Id _ _ G _ _) Id G.

:nooc
pred box-parts o:box, o:int, o:int, o:any, o:list frame.
box-parts (box Id D P _ Above _) Id D P Above.

% [within-depth D]: a call at depth D may run (option max-depth).
pred within-depth i:int.
within-depth D :- opt (max-depth N), !, D =< N.
within-depth _.

% [strategy-candidate P G Origin Head Body]: the candidates of G in the
% order of the strategy: Elpi's, or random (option random-order).
pred strategy-candidate i:any, i:(pred), o:origin, o:(pred), o:(pred).
strategy-candidate P G Origin Head Body :- opt random-order, !,
  candidate-refs P Refs, shuffle Refs Shuffled,
  std.mem Shuffled Ref, candidate-of-ref P Ref Origin Head Body.
strategy-candidate P G Origin Head Body :- candidate P G Origin Head Body.

% A reference to a candidate: a hypothetical clause by its number, or a
% rule of the program by its index.  (References, since std.findall would
% copy the hypothetical clauses and cut their variables off.)
data candidate-ref.
symb hyp-ref int -> candidate-ref.
symb rule-ref int -> candidate-ref.

pred candidate-refs i:any, o:list candidate-ref.
candidate-refs P Refs :-
  std.findall (hyp P (added-by _ _) _) Hs,
  std.map Hs (h\ r\ sigma K\ h = hyp _ (added-by _ K) _, r = hyp-ref K) HRefs,
  std.findall (reflect.clause P _ _ _ _ _) Rs,
  std.map Rs (c\ r\ sigma I\ c = reflect.clause _ I _ _ _ _, r = rule-ref I) RRefs,
  std.append HRefs RRefs Refs.

pred candidate-of-ref i:any, i:candidate-ref, o:origin, o:(pred), o:(pred).
candidate-of-ref P (hyp-ref K) (added-by S K) Head Body :-
  hyp P (added-by S K) C, !, clause-parts C Head Body.
candidate-of-ref P (rule-ref I) (at Loc Attrs) Head Body :-
  reflect.clause P I Loc Attrs Head Body, constant Head Q _, same_term Q P, !.

% [shuffle L S]: S is L in a random order.
pred shuffle i:list A, o:list A.
shuffle [] [] :- !.
shuffle L [X|S] :- std.length L N, random.int N K, take-nth K L X Rest, shuffle Rest S.

pred take-nth i:int, i:list A, o:A, o:list A.
take-nth 0 [X|L] X L :- !.
take-nth K [Y|L] X [Y|R] :- K1 is K - 1, take-nth K1 L X R.

% [candidate P G Origin Head Body]: by backtracking, the clauses that may
% apply to G (a goal of P), with fresh variables.
pred candidate i:any, i:(pred), o:origin, o:(pred), o:(pred).
candidate P _ Origin Head Body :- hyp P Origin C, clause-parts C Head Body.
candidate P _ Origin Head Body :- program-clause P Head Body Origin.

% [clause-parts C Head Body]: the head and body of the clause C, with
% fresh variables for its pi-bound variables.
pred clause-parts i:(pred), o:(pred), o:(pred).
clause-parts (pi x\ F x) H B :- !, clause-parts (F _) H B.
clause-parts (H :- B) H B :- !.
clause-parts H H true.

% [warn-if-no-clause P G]: say once per predicate that P has no clause at
% all; in Elpi such a call just fails, silently.
pred warn-if-no-clause i:any, i:(pred).
warn-if-no-clause P G :- candidate P G _ _ _, !.
warn-if-no-clause P _ :- term_to_string P Name, state "warned" S, open_safe S L, std.mem! L Name, !.
warn-if-no-clause P _ :-
  term_to_string P Name, state "warned" S, stash_in_safe S Name,
  say 0 ["debug warning: ", Name, " has no clause at all (in the program or in the hypotheses in scope); its calls fail"].

% ===== 8. Head matching, with modes =======================================

% [modes-of P G Modes]: the modes of P (all outputs when undeclared).
pred modes-of i:any, i:(pred), o:list mode.
modes-of P _ Modes :- declared P Modes, !.
modes-of _ G Modes :- constant G _ Args, std.map Args (_\ m\ m = o) Modes.

% [head-matches Modes G H]: the clause head H applies to the goal G.
pred head-matches i:list mode, i:(pred), i:(pred).
head-matches Modes G H :- constant G _ GArgs, constant H _ HArgs, args-match Modes GArgs HArgs.

pred args-match i:list mode, i:list any, i:list any.
args-match _ [] [].
args-match Ms [A|As] [B|Bs] :- first-mode Ms M Ms1, arg-match M A B, args-match Ms1 As Bs.

% [first-mode Ms M Rest]: the mode of the next argument (an output when the
% declaration has no more modes).
pred first-mode i:list mode, o:mode, o:list mode.
first-mode [] o [].
first-mode [M|Ms] M Ms.

% [arg-match M A B]: the goal argument A and the head argument B agree in
% mode M; for an input only the variables of the head are assigned.  The
% head patterns uvar and (P as X) come from reflect as uvar-pattern and
% as-pattern (only at the top of an argument).
pred arg-match i:mode, i:any, i:any.
arg-match _ A reflect.uvar-pattern :- !, var A.
arg-match M A (reflect.as-pattern P X) :- !, arg-match M A P, X = A.
arg-match i A B :- pattern_match A B.
arg-match o A B :- A = B.

% ===== 9. Hypothetical clauses ============================================

% [hyp P Origin C]: the hypothetical clause C of the predicate P, added by
% [=>]; Origin says which box added it.  The real [=>] installs these
% facts, so they have Elpi's own scope and order.
pred hyp o:any, o:origin, o:(pred).

% [assume Ctx H B Hyps]: Hyps are the local clauses that represent the
% hypothesis H (a clause or a list of clauses) for the goal B: one [hyp]
% fact per clause, and a bridge for a predicate that had none.
:nooc
pred assume o:ctx, i:any, i:(pred), o:list (pred).
assume Ctx H B Hyps :-
  assume-port Ctx H B,
  hyp-list H Cs, hyp-origin Ctx Origin,
  std.fold Cs [] (hyp-facts Origin) Hyps.

pred hyp-list i:any, o:list (pred).
hyp-list [] [] :- !.
hyp-list [C|Cs] [C|Cs] :- !.
hyp-list C [C].

:nooc
func hyp-origin ctx -> string.
hyp-origin (ctx _ [frame Id _ _ _|_]) S :- !, std.any->string Id I, S is "hypothesis added by #" ^ I.
hyp-origin _ "hypothesis added by the query".

func hyp-facts string, (pred), list (pred) -> list (pred).
hyp-facts Origin C Hs Hs2 :-
  clause-parts C H _, constant H P Args, !,
  std.length Args N,
  hyp-number K,
  hyp-facts-of P N [hyp P (added-by Origin K) C | Hs] Hs2.
hyp-facts _ C _ _ :- std.fatal-error-w-data "debug: unsupported hypothetical clause" C.

% [hyp-number K]: a number of its own for a hypothetical clause, used by
% the random order only (elsewhere 0, so that the boxes keep consecutive
% numbers).
func hyp-number -> int.
hyp-number K :- opt random-order, !, new_int K.
hyp-number 0.

% [hyp-facts-of P N Hs Hs1]: adds the bridge of P when it has none yet.
func hyp-facts-of any, int, list (pred) -> list (pred).
hyp-facts-of P _ Hs Hs :- bridged P, !.
hyp-facts-of P N Hs [bridged P, B | Hs] :- bridge-clause P [] N B.

% ===== 10. λProlog in view: eigenvariables, scopes, logic variables ======
%
% Elpi prints an eigenvariable as c0, c1... (its level).  Each pi entered
% by the interpreter names its eigenvariable after the binder of the source
% (from reflect's binders attribute) and a number, x#3, with a local clause
% [eigen X "x#3"] in the scope of the pi; printing replaces c<level> by that
% name.  A logic variable may depend on the eigenvariables in scope when it
% was created; [can-depend V E] tests it by trying V = E without keeping
% the binding (it fails when E was introduced after V).

% [eigen X Name]: the eigenvariable X is shown as Name.
pred eigen o:any, o:string.

% [show-term T S]: T printed, with the names of its eigenvariables.
func show-term any -> string.
show-term T S :- term_to_string T S0, rex.replace "\n *" " " S0 S1, names Es, rename-eigens Es 0 S1 S.

% [rename-eigens Es L S0 S]: Es are the eigenvariables in scope from level
% L on, the oldest first (as [names] gives them, whatever its documentation
% says: its code is list_init 0 depth).
func rename-eigens list any, int, string -> string.
rename-eigens [] _ S S.
rename-eigens [E|Es] L S0 S :-
  rename-eigen E L S0 S1, L1 is L + 1, rename-eigens Es L1 S1 S.

func rename-eigen any, int, string -> string.
rename-eigen E L S0 S :- eigen E Name, !,
  Rex is "\\bc" ^ {std.any->string L} ^ "\\b", rex.replace Rex Name S0 S.
rename-eigen _ _ S S.

% [eigen-name E S]: the name of the eigenvariable E.
pred eigen-name i:any, o:string.
eigen-name E S :- show-term E S.

pred eigen-names i:list any, o:list string.
eigen-names [] [].
eigen-names [E|Es] [N|Ns] :- eigen-name E N, eigen-names Es Ns.

% [can-depend V E]: the logic variable V may be assigned a term mentioning
% the eigenvariable E.
pred can-depend i:any, i:any.
can-depend V E :- not (not (V = E)).

% [visible-eigens V Es]: the eigenvariables in scope that V may depend on.
pred visible-eigens i:any, o:list any.
visible-eigens V Es :- names All, keep-visible V All Es.

pred keep-visible i:any, i:list any, o:list any.
keep-visible _ [] [].
keep-visible V [E|Es] [E|Vs] :- can-depend V E, !, keep-visible V Es Vs.
keep-visible V [_|Es] Vs :- keep-visible V Es Vs.

% [new-number Counter K]: the next number of a counter ("eigen" for
% eigenvariables, "suspension" for delayed goals), kept across backtracking.
pred new-number i:string, o:int.
new-number Counter K :-
  state Counter S, open_safe S L, std.length L N, K is N + 1, stash_in_safe S K.

% --- walking terms (Elpi has no builtin to take a λ-term apart) ---

% The shape of a term: a logic variable (its head, for an applied one), a
% leaf, a node with its immediate subterms in textual order, or a binder
% (pi, sigma, λ) with its body as a function.
data shape.
symb flexible any -> shape.
symb leaf shape.
symb node list any -> shape.
symb binder any -> shape.

pred shape-of i:any, o:shape.
shape-of T (flexible H) :- var T H _, !.
shape-of T leaf :- is_cdata T _, !.
shape-of (pi x\ F x) (binder F) :- !.
shape-of (sigma x\ F x) (binder F) :- !.
shape-of G (node Gs) :- conjuncts G Gs, !.
shape-of (A => B) (node [A, B]) :- !.
shape-of (A :- B) (node [A, B]) :- !.
shape-of (A = B) (node [A, B]) :- !.
shape-of (pattern_match A B) (node [A, B]) :- !.
shape-of (findall_solutions A B) (node [A, B]) :- !.
shape-of (declare_constraint G K) (node [G, K]) :- !.
shape-of ! leaf :- !.
shape-of T (node Args) :- constant T _ Args, !.
shape-of T (node Args) :- name T _ Args, !.
shape-of [] leaf :- !.
shape-of T (node [X, L1]) :- T = [X|L], !, std.unsafe-cast L L1.
shape-of T (binder T) :- is-lambda T, !.
shape-of _ leaf.             % an application of a builtin (var X...): not inspected

% [is-lambda T]: T is a λ-term.  Elpi has no builtin for it, and unifying
% T with x\ F x would eta-expand anything; a λ-term prints as "cN \ ...".
pred is-lambda i:any.
is-lambda T :- term_to_string T S, rex.match "^c[0-9]+ \\\\" S.

% [binder-body F G]: G is the body of the binder F under the eigenvariable
% x (F is a λ-term, applied to x).
pred binder-body i:any, i:any, o:any.
:untyped
binder-body F X (F X).

% [lambda-count T N]: the number of binders (pi, sigma, λ) in T, in the
% order reflect lists their source names.
pred lambda-count i:any, o:int.
lambda-count T N :- shape-of T S, shape-lambda-count S N.

pred shape-lambda-count i:shape, o:int.
shape-lambda-count (flexible _) 0.
shape-lambda-count leaf 0.
shape-lambda-count (node Ts) N :- lambda-counts Ts N.

pred lambda-counts i:list any, o:int.
lambda-counts [] 0.
lambda-counts [T|Ts] N :- lambda-count T A, lambda-counts Ts B, N is A + B.
shape-lambda-count (binder F) N :- pi x\ sigma B\ binder-body F x B, lambda-count B M, N is M + 1.

% [logic-vars T Vs]: the logic variables of T (their heads, once each).
pred logic-vars i:any, o:list any.
logic-vars T Vs :- logic-vars-acc T [] Vs1, std.rev Vs1 Vs.

pred logic-vars-acc i:any, i:list any, o:list any.
logic-vars-acc T Acc Acc1 :- shape-of T S, shape-vars S Acc Acc1.

pred shape-vars i:shape, i:list any, o:list any.
shape-vars (flexible H) Acc Acc :- std.exists Acc (same_var H), !.
shape-vars (flexible H) Acc [H|Acc].
shape-vars leaf Acc Acc.
shape-vars (node Ts) Acc Acc1 :- logic-vars-all Ts Acc Acc1.

pred logic-vars-all i:list any, i:list any, o:list any.
logic-vars-all [] Acc Acc.
logic-vars-all [T|Ts] Acc Acc2 :- logic-vars-acc T Acc Acc1, logic-vars-all Ts Acc1 Acc2.
shape-vars (binder F) Acc Acc1 :- pi x\ sigma B\ binder-body F x B, logic-vars-acc B Acc Acc1.

% [mentions-var T V]: the logic variable V occurs in T.
pred mentions-var i:any, i:any.
mentions-var T V :- logic-vars T Vs, std.exists Vs (same_var V).

% [binder-names Head Body Names BodyNames]: the source names of the
% binders of the body, given those of the whole rule (Names); none when
% they do not add up.
pred binder-names i:(pred), i:(pred), i:list string, o:list string.
binder-names Head Body Names BodyNames :-
  lambda-count Head NH, lambda-count Body NB, std.length Names N, N is NH + NB, !,
  std.drop NH Names BodyNames.
binder-names _ _ _ [].

func binder-strings list reflect.attribute -> list string.
binder-strings Attrs Names :- std.mem! Attrs (reflect.binders Bs), !,
  std.map Bs (b\ s\ b = reflect.binder s _) Names.
binder-strings _ [].

% [show-scope G]: the eigenvariables in force and, for each logic
% variable of G, the ones it may depend on.
pred show-scope i:(pred).
show-scope G :-
  names Es, eigen-names Es Ns,
  say 1 ["eigenvariables in force (oldest first): ", {std.string.concat ", " Ns}],
  logic-vars G Vs,
  show-var-scopes Vs.

pred show-var-scopes i:list any.
show-var-scopes [].
show-var-scopes [V|Vs] :- show-var-scope V, show-var-scopes Vs.

pred show-var-scope i:any.
show-var-scope V :-
  visible-eigens V Es, eigen-names Es Ns,
  say 1 ["  ", {show-term V}, " may depend on: ", {names-or-none Ns}].

func names-or-none list string -> string.
names-or-none [] "no eigenvariable" :- !.
names-or-none Ns S :- std.string.concat ", " Ns S.

% ===== 11. Ports: trace, breakpoints, interactive stepping ===============
%
% An event is a port of a call (call, exit, redo, fail; a woken goal
% enters through resume) or a step of λProlog inside a call: the head
% unification of the selected clause (unify), the entry into pi (pi) or
% into H => G (assume), the suspension of a goal (delay), a cut.  Each
% event is shown when tracing, and in interactive mode the interpreter
% stops there, as the box-model tracers of Prolog, and reads a command.
%
% The commands act on the focus of the event: the call whose port it is,
% or whose body runs the pi, => or cut.
%
% retry and fail.  Each call is run by [attempt], whose second clause is a
% choice point placed just before the call port.  The command records the
% request (retry N or fail-call N) in a safe, which survives backtracking,
% and fails.  While a request is pending every event fails at once, so
% backtracking goes quickly through the choice points inside call N
% (bindings undone by Elpi as usual) and reaches the second clause of
% [attempt] for N, which takes the request and runs call N again, or shows
% its fail port and fails.  The local program and the eigenvariables are
% restored as well: the clauses added by => and the eigenvariables of pi
% are Elpi's own (the interpreter keeps => and pi native), so going back to
% the choice point before the call port leaves their scopes, exactly as it
% undoes the bindings.  The cut does not get in the way: a cut in a body is
% the cut of [backchain], below [attempt], so it never removes the choice
% point of [attempt] of its own call or of the calls above.
%
% skip.  A stepping mode (skip N), kept in a safe: no event is shown or
% stops until the exit or fail port of call N (breakpoints still stop).
% Nothing is undone or changed in the run, the local program and scope
% included: the call runs as without the debugger, only unseen.

% [say Depth Parts]: print the concatenation of Parts, indented by Depth.
func say int, list string.
say D Parts :- indent D Ind, std.string.concat "" [Ind|Parts] S, print S.

func indent int -> string.
indent N "" :- N =< 0, !.
indent N S :- M is N - 1, indent M S1, S is S1 ^ "  ".

:nooc
func box-name int -> string.
box-name Id S :- std.any->string Id I, S is "#" ^ I.

% The focus of an event: invocation number, depth, predicate and goal of a
% call, and the frames above it (invocation number 0: the query itself).
data focus.
symb focus int -> int -> any -> (pred) -> list frame -> focus.

:nooc
func box-focus box -> focus.
box-focus (box Id D P G Above _) (focus Id D P G Above).

:nooc
func ctx-depth ctx -> int.
ctx-depth (ctx D _) D.

:nooc
func ctx-focus ctx -> focus.
ctx-focus (ctx _ [frame Id D P G | Above]) (focus Id D P G Above) :- !.
ctx-focus _ (focus 0 0 query true []).

% the predicate of the focus of the query
symb query any.

% --- stepping modes and requests (kept in safes) ---

data stepping.
symb creep stepping.        % stop at every event
symb skip int -> stepping.  % stop at nothing until call N exits or fails
symb leap stepping.         % stop at breakpoints only
symb tracing stepping.      % show every event, stop at breakpoints only
symb nodebug stepping.      % show nothing, stop nowhere

data request.
symb no-request request.
symb retry int -> request.
symb fail-call int -> request.

% [last-of L X]: X is the last element of L (fails on the empty list, unlike
% std.last).
pred last-of i:list A, o:A.
last-of [X] X :- !.
last-of [_|L] X :- last-of L X.

pred current-mode o:stepping.
current-mode M :- state "mode" S, open_safe S L, last-of L M1, !, M = M1.
current-mode leap.

pred set-mode i:stepping.
set-mode M :- state "mode" S, stash_in_safe S M.

% [initial-mode Options M]: interactive without breakpoints starts by
% creeping (as Prolog's trace), otherwise it leaps to the first breakpoint.
func initial-mode list option -> stepping.
initial-mode Options creep :- std.mem! Options interactive, not (std.exists Options is-break), !.
initial-mode _ leap.

pred is-break i:option.
is-break (break _).

pred current-request o:request.
current-request R :- state "request" S, open_safe S L, last-of L R1, !, R = R1.
current-request no-request.

pred set-request i:request.
set-request R :- state "request" S, stash_in_safe S R.

% [pending]: a retry or fail is unwinding the run.
pred pending.
pending :- current-request R, not (R = no-request).

% [take-request Id R]: the pending request R concerns call Id; it is taken.
pred take-request i:int, o:request.
take-request Id (retry Id) :- current-request (retry Id), !, set-request no-request.
take-request Id (fail-call Id) :- current-request (fail-call Id), !, set-request no-request.

% --- breakpoints: the options, then the ones set or removed at a stop ---

pred breakpoint-on i:any.
breakpoint-on P :- term_to_string P Name, breakpoint-named Name.

pred breakpoint-named i:string.
breakpoint-named Name :- state "breaks" S, open_safe S L, last-break-change L Name C, !, C = "+".
breakpoint-named Name :- opt (break Name), !.

% [last-break-change L Name C]: C is the last change ("+" or "-") of the
% breakpoint Name in L (changes [pr C Name], oldest first).
pred last-break-change i:list (pair string string), i:string, o:string.
last-break-change L Name C :- std.rev L R, find-change R Name C.

% (a search, not std.mem!, whose element is an input: it would not bind C)
pred find-change i:list (pair string string), i:string, o:string.
find-change [pr C Name | _] Name C :- !.
find-change [_ | L] Name C :- find-change L Name C.

pred change-breakpoint i:string, i:string.
change-breakpoint C Name :- state "breaks" S, stash_in_safe S (pr C Name).

% --- events ---

% [event Kind Indent Focus Text]: the event Kind (call, exit, redo, fail,
% resume, unify, pi, assume, delay, cut) at indentation Indent, about
% Focus; Text is printed after the label.  It fails while a retry or fail
% is pending (to unwind), and when the command at the stop asks for it.
:nooc
pred event i:string, i:int, o:focus, i:list string.
event _ _ _ _ :- pending, !, fail.
event Kind Ind F Text :-
  show-event-if-shown Kind Ind F Text,
  stop-if-stopping Kind F.

% (The hot paths use clauses rather than std.if: its arguments are inputs,
% and the goals passed to it hold the whole stack of frames.)
:nooc
pred show-event-if-shown i:string, i:int, o:focus, i:list string.
show-event-if-shown Kind Ind F Text :- event-shown Kind F, !,
  say Ind [{event-label Kind}, " " | Text].
show-event-if-shown _ _ _ _.

:nooc
pred stop-if-stopping i:string, o:focus.
stop-if-stopping Kind F :- stops-at Kind F, !, stop Kind F.
stop-if-stopping _ _.

func event-label string -> string.
event-label "call" "Call:" :- !.
event-label "exit" "Exit:" :- !.
event-label "redo" "Redo:" :- !.
event-label "fail" "Fail:" :- !.
event-label "resume" "Resume:" :- !.
event-label "unify" "Unify:" :- !.
event-label "pi" "Pi:" :- !.
event-label "assume" "Assume:" :- !.
event-label "delay" "Delay:" :- !.
event-label "cut" "Cut:" :- !.
event-label K L :- L is K ^ ":".

% [event-shown Kind F]: the event is printed.
:nooc
pred event-shown i:string, o:focus.
event-shown _ _ :- opt trace, !.
event-shown Kind F :- opt interactive, current-mode M, !, shown-in-mode M Kind F.
event-shown Kind (focus _ _ P _ _) :- box-port Kind, breakpoint-on P.

:nooc
pred shown-in-mode i:stepping, i:string, o:focus.
shown-in-mode creep _ _.
shown-in-mode tracing _ _.
shown-in-mode (skip Id) Kind (focus Id _ _ _ _) :- end-port Kind.
shown-in-mode _ Kind (focus _ _ P _ _) :- box-port Kind, breakpoint-on P.

pred box-port i:string.
box-port "call". box-port "exit". box-port "redo". box-port "fail". box-port "resume".

pred entry-port i:string.
entry-port "call". entry-port "resume".

pred end-port i:string.
end-port "exit". end-port "fail".

% [stops-at Kind F]: the interpreter stops at the event: a breakpoint, or
% (interactive) creeping, or the end of a skipped call.
:nooc
pred stops-at i:string, o:focus.
stops-at Kind (focus _ _ P _ _) :- entry-port Kind, breakpoint-on P, not (current-mode nodebug), !.
stops-at Kind F :- opt interactive, current-mode M, stops-in-mode M Kind F.

:nooc
pred stops-in-mode i:stepping, i:string, o:focus.
stops-in-mode creep _ _.
stops-in-mode (skip Id) Kind (focus Id _ _ _ _) :- end-port Kind.

% --- the ports of calls ---

% [port Kind Box]: Box passes the port Kind ("call", "exit", "redo",
% "fail"; "call" is shown as resume for a woken goal).
:nooc
pred port i:string, o:box.
port _ _ :- quiet, !.
port Kind Box :-
  record-event Kind Box,
  box-port-event Kind Box.

:nooc
pred box-port-event i:string, o:box.
box-port-event Kind (box Id D P G Above Entry) :-
  entry-kind Kind Entry Kind1 Tag,
  event Kind1 D (focus Id D P G Above) [Tag, {box-name Id}, " ", {show-term G}].

% [entry-kind Kind Entry Kind1 Tag]: a woken goal enters through resume,
% tagged with the number of its suspension (as ECLiPSe's DELAY/RESUME).
func entry-kind string, string -> string, string.
entry-kind "call" Entry "resume" Tag :- rex.match "^wake" Entry, !,
  rex.replace "^wake " "" Entry N, Tag is "[S" ^ N ^ "] ".
entry-kind Kind Entry Kind Tag :- rex.match "^wake" Entry, !,
  rex.replace "^wake " "" Entry N, Tag is "[S" ^ N ^ "] ".
entry-kind Kind _ Kind "".

% [try-port Box Origin Head]: a candidate clause is tried (for the profile).
:nooc
pred try-port o:box, i:origin, i:(pred).
try-port _ _ _ :- quiet, !.
try-port Box _ _ :- record-event "try" Box.

% [unify-port Box Origin Head Bindings]: the head of the clause from Origin
% unified with the goal; Bindings are the assignments of the goal's
% variables it made.
:nooc
pred unify-port o:box, i:origin, i:(pred), i:list string.
unify-port (box Id D P G Above _) Origin Head Bindings :-
  event "unify" D (focus Id D P G Above)
    [{box-name Id}, " with ", {origin-string Origin}, ": ", {show-term Head} | Bindings].

% [match-and-port Modes Box Origin G Head]: head matching, with the unify
% port when it is shown: the variables of G are looked at before and after.
:nooc
pred match-and-port i:list mode, o:box, i:origin, i:(pred), i:(pred).
match-and-port Modes _ _ G Head :- quiet, !, head-matches Modes G Head.
match-and-port Modes Box _ G Head :- box-focus Box F, not (event-shown "unify" F), !,
  head-matches Modes G Head.
match-and-port Modes Box Origin G Head :-
  logic-vars G Vs, snapshot Vs Before,
  head-matches Modes G Head,
  bindings-text Before Lines,
  unify-port Box Origin Head Lines.

% A logic variable before the unification: itself, as printed, and the
% eigenvariables it may depend on.
data snap.
symb snap any -> string -> list any -> snap.

pred snapshot i:list any, o:list snap.
snapshot [] [].
snapshot [V|Vs] [snap V Name Vis | Ss] :- show-term V Name, visible-eigens V Vis, snapshot Vs Ss.

% [bindings-text Before Lines]: one line per variable assigned, with
% pruning when the variable lost eigenvariables it could depend on.
pred bindings-text i:list snap, o:list string.
bindings-text [] [].
bindings-text [snap V Name Vis | Ss] [Line | Ls] :-
  show-term V Now, not (Now = Name), !,
  pruning V Vis Pruned,
  std.string.concat "" ["\n      ", Name, " := ", Now, Pruned] Line,
  bindings-text Ss Ls.
bindings-text [_ | Ss] Ls :- bindings-text Ss Ls.

% [pruning V Vis S]: V is now (headed by) a variable that may depend on
% fewer eigenvariables than Vis: Elpi pruned it.
pred pruning i:any, i:list any, o:string.
pruning V _ S :- not (var V), pruned-arguments V S, !.
pruning V Vis S :- var V H _, visible-eigens H Now,
  lost-eigens Vis Now Lost, not (Lost = []), !,
  eigen-names Lost Ns,
  S is "   (pruned: may no longer depend on " ^ {std.string.concat ", " Ns} ^ ")".
pruning _ _ "".

% [pruned-arguments V S]: V is now x1..xn\ H a1..ak with H a new variable
% and k < n: H does not get all the arguments (Elpi pruned the others).
pred pruned-arguments i:any, o:string.
pruned-arguments V S :- lambda-prefix V 0 N K H, N > 0, K < N,
  S is "   (pruned: " ^ {show-term H} ^ " gets " ^ {std.any->string K} ^ " of the "
       ^ {std.any->string N} ^ " arguments)".

% [lambda-prefix T N0 N K H]: T is N-N0 binders around H a1..ak, H a
% variable and k = K; the test is made under the binders, where the body
% lives (H itself is older, so it can be returned).
pred lambda-prefix i:any, i:int, o:int, o:int, o:any.
lambda-prefix T N0 N K H :- shape-of T S, S = binder F, !, N1 is N0 + 1,
  pi x\ sigma Bd\ binder-body F x Bd, lambda-prefix Bd N1 N K H.
lambda-prefix T N N K H :- var T H Args, std.length Args K.

pred lost-eigens i:list any, i:list any, o:list any.
lost-eigens [] _ [].
lost-eigens [E|Es] Now Lost :- std.exists Now (same_term E), !, lost-eigens Es Now Lost.
lost-eigens [E|Es] Now [E|Lost] :- lost-eigens Es Now Lost.

% [cut-port Ctx]: a cut commits the call above Ctx to its current clause.
:nooc
pred cut-port o:ctx.
cut-port _ :- quiet, !.
cut-port Ctx :- ctx-focus Ctx (focus Id D P G Above), Id > 0, !,
  event "cut" D (focus Id D P G Above) [{box-name Id}, " commits to its current clause"].
cut-port _.

% [pi-port Ctx Name X Body N]: entering pi: X is a new eigenvariable, named
% N (the source name and a number), whose scope is Body.
:nooc
pred pi-port o:ctx, i:string, i:any, i:(pred), o:string.
pi-port _ Name _ _ Name :- quiet, !.
pi-port Ctx Name X Body N :-
  ctx-depth Ctx D,
  new-number "eigen" K, N is Name ^ "#" ^ {std.any->string K},
  ctx-focus Ctx F,
  (eigen X N => (show-term Body BS,
                 event "pi" D F [N, " is a new eigenvariable; its scope: ", BS])).

% [assume-port Ctx H B]: entering H => B: H is added to the local program
% for B only.
:nooc
pred assume-port o:ctx, i:any, i:(pred).
assume-port _ _ _ :- quiet, !.
assume-port Ctx H B :-
  ctx-depth Ctx D,
  ctx-focus Ctx F,
  event "assume" D F [{show-term H}, "   (added to the local program, for ", {show-term B}, " only)"].

% [native-port Kind Ctx G]: ports of builtins, shown with option builtins.
:nooc
pred native-port i:string, o:ctx, i:(pred).
native-port _ _ _ :- quiet, !.
native-port _ _ _ :- pending, !, fail.
native-port Kind Ctx G :-
  record-native-event Kind Ctx G,
  show-native-if-shown Kind Ctx G.

:nooc
pred show-native-if-shown i:string, o:ctx, i:(pred).
show-native-if-shown Kind Ctx G :- opt builtins, !, show-native Kind Ctx G.
show-native-if-shown _ _ _.

:nooc
pred show-native i:string, o:ctx, i:(pred).
show-native Kind (ctx D _) G :- say D ["(builtin) ", Kind, ": ", {show-term G}].

% [delay-port Ctx G Keys K]: G suspended on Keys, suspension number K.
:nooc
pred delay-port o:ctx, i:(pred), i:any, i:int.
delay-port _ _ _ _ :- quiet, !.
delay-port Ctx G Keys K :-
  ctx-depth Ctx D,
  ctx-focus Ctx F,
  event "delay" D F ["[S", {std.any->string K}, "] ", {show-term G}, " on ", {show-term Keys}].

% --- stops and commands ---

% [stop Kind F]: in interactive mode, read and run commands; otherwise (a
% breakpoint) show where we are.
:nooc
pred stop i:string, o:focus.
stop Kind F :- opt interactive, !, command-loop Kind F.
stop _ F :- show-context F.

:nooc
pred show-context o:focus.
show-context (focus Id _ _ G Above) :-
  say 0 ["--- breakpoint at ", {box-name Id}, ": ", {show-term G}],
  show-backtrace Above, show-hyps, show-eigenvariables.

:nooc
pred command-loop i:string, o:focus.
command-loop Kind F :-
  output std_out "   ? ", flush std_out,
  read-command C,
  echo-command C,
  rex.split " +" C Words,
  run-command Words Kind F.

pred read-command o:string.
read-command "n" :- eof std_in, !.
read-command C :- input_line std_in C.

% [echo-command C]: with option echo (scripted sessions), the command read
% is printed, so that a transcript reads as a session.
pred echo-command i:string.
echo-command C :- opt echo, !, print C.
echo-command _.

% [run-command Words Kind F]: succeeds to go on, fails to unwind (retry,
% fail), loops for the commands that only show something.
:nooc
pred run-command i:list string, i:string, o:focus.
run-command [] _ _ :- !, set-mode creep.
run-command ["c"] _ _ :- !, set-mode creep.
run-command ["s"] Kind (focus Id _ _ _ _) :- not (end-port Kind), Id > 0, !, set-mode (skip Id).
run-command ["s"] _ _ :- !, set-mode creep.
run-command ["l"] _ _ :- !, set-mode leap.
run-command ["t"] _ _ :- !, set-mode tracing.
run-command ["n"] _ _ :- !, set-mode nodebug.
run-command ["r"] Kind (focus 0 _ _ _ _ as F) :- !, print "    (the query itself cannot be retried)", command-loop Kind F.
run-command ["r"] _ (focus Id _ _ _ _) :- !,
  say 0 ["    retry ", {box-name Id}, ": back to its call port"],
  set-request (retry Id), fail.
run-command ["f"] Kind (focus 0 _ _ _ _ as F) :- !, print "    (the query itself cannot be failed)", command-loop Kind F.
run-command ["f"] _ (focus Id _ _ _ _) :- !, set-request (fail-call Id), fail.
run-command ["p"] Kind F :- !, show-focus F, command-loop Kind F.
run-command ["g"] Kind (focus _ _ _ _ Above as F) :- !, show-backtrace Above, command-loop Kind F.
run-command ["scope"] Kind (focus _ _ _ G _ as F) :- !, show-scope G, command-loop Kind F.
run-command ["hyps"] Kind F :- !, show-hyps, command-loop Kind F.
run-command ["+", Name] Kind F :- !, change-breakpoint "+" Name,
  say 1 ["breakpoint on ", Name], command-loop Kind F.
run-command ["-", Name] Kind F :- !, change-breakpoint "-" Name,
  say 1 ["no breakpoint on ", Name], command-loop Kind F.
run-command ["e"] Kind F :- !, show-deepest-failure, command-loop Kind F.
run-command ["a"] _ _ :- !, halt "debug: aborted".
run-command ["h"] Kind F :- !, show-help, command-loop Kind F.
run-command ["?"] Kind F :- !, show-help, command-loop Kind F.
run-command _ Kind F :- print "    unknown command (h for help)", command-loop Kind F.

pred show-help.
show-help :- std.forall [
  "    c or return  creep: go to the next event",
  "    s            skip: run this call to its exit or fail without stopping inside",
  "    l            leap: run to the next breakpoint",
  "    t            trace: show every event, stop only at breakpoints",
  "    n            nodebug: run to the end without stopping",
  "    r            retry this call from its call port (bindings, local program, scope undone)",
  "    f            make this call fail",
  "    p            print the goal, the local program and the scope",
  "    g            the calls above (goals)",
  "    scope        the eigenvariables in force and what each logic variable may depend on",
  "    hyps         the local program: the clauses added by =>",
  "    + P, - P     set, remove a breakpoint on the predicate P",
  "    e            the deepest failure so far",
  "    a            abort"] (s\ print s).

:nooc
pred show-focus o:focus.
show-focus (focus Id _ _ G _) :-
  say 1 [{box-name Id}, " ", {show-term G}],
  show-hyps, show-scope G.

pred show-backtrace i:list frame.
show-backtrace Above :- print "  called from:", show-ancestors Above.

pred show-ancestors i:list frame.
show-ancestors [].
show-ancestors [Fr|Frs] :- say 2 [{ancestor-string Fr}], show-ancestors Frs.

pred show-hyps.
show-hyps :- print "  local program (clauses added by =>, most recent first):", fail.
show-hyps :- hyp _ Origin C, say 2 [{show-term C}, "    (", {origin-string Origin}, ")"], fail.
show-hyps.

pred show-eigenvariables.
show-eigenvariables :- names Es, eigen-names Es Ns,
  say 1 ["eigenvariables in scope: ", {names-or-none Ns}].

% ===== 12. Explaining failures ============================================
%
% Each failing box deeper than all the failures seen so far is recorded
% with its explanation, computed at the fail port, where the goal is back
% as it was called.  The safe keeps the record across backtracking.

data failure.
% [failure Depth Goal Above Reasons]: strings only (a safe keeps closed terms).
symb failure int -> string -> list string -> list string -> failure.

:nooc
pred note-failure o:box.
note-failure (box _ D _ _ _ _) :- deepest-depth M, D =< M, !.
note-failure (box Id D P G Above _) :-
  std.map Above ancestor-string AboveS,
  failure-reasons D P G Reasons,
  std.string.concat "" [{box-name Id}, " ", {show-term G}] S,
  state "deepest" Safe,
  stash_in_safe Safe (failure D S AboveS Reasons).

:nooc
pred note-native-failure o:ctx, i:(pred).
note-native-failure Ctx G :-
  note-goal-failure Ctx G ["a builtin (not a predicate of the program): it ran natively and failed"].

% [note-goal-failure Ctx G Reasons]: record the failure of the non-program
% goal G, if it is the deepest so far.
:nooc
pred note-goal-failure o:ctx, i:(pred), i:list string.
note-goal-failure (ctx D _) _ _ :- deepest-depth M, D =< M, !.
note-goal-failure (ctx D Above) G Reasons :-
  std.map Above ancestor-string AboveS,
  show-term G S,
  state "deepest" Safe,
  stash_in_safe Safe (failure D S AboveS Reasons).

:nooc
func ancestor-string frame -> string.
ancestor-string (frame Id _ _ G) S :- std.string.concat "" [{box-name Id}, " ", {show-term G}] S.

pred deepest-depth o:int.
deepest-depth D :- state "deepest" S, open_safe S L, last-of L (failure D1 _ _ _), !, D = D1.
deepest-depth -1.

% [failure-reasons D P G Reasons]: why the call G at depth D failed.
pred failure-reasons i:int, i:any, i:(pred), o:list string.
failure-reasons D _ _ [R] :- not (within-depth D), !, opt (max-depth N),
  R is "the depth bound stops it: calls deeper than " ^ {std.any->string N} ^ " fail (option max-depth)".
failure-reasons _ P G Reasons :- explain-candidates P G Reasons.

% [explain-candidates P G Reasons]: for each candidate clause of G, why it
% does not apply, or that its body failed.  The reasons are gathered by
% backtracking into a safe, not with std.findall, which would copy G and
% so cut its variables off from the hypothetical clauses that share them.
pred explain-candidates i:any, i:(pred), o:list string.
explain-candidates P G Reasons :-
  new_safe S,
  std.ignore-failure! (explain-candidate P G R, stash_in_safe S R, fail),
  open_safe S Rs,
  explain-list P Rs Reasons.

pred explain-list i:any, i:list string, o:list string.
explain-list P [] Reasons :- !, no-clause-reason P Reasons.
explain-list _ Rs ["clauses tried:" | Rs].

pred explain-candidate i:any, i:(pred), o:string.
explain-candidate P G Reason :-
  modes-of P G Modes,
  candidate P G Origin Head Body,
  show-term Head HS,
  candidate-verdict Modes G Head Body Verdict,
  std.string.concat "" ["  ", {origin-string Origin}, ": ", HS, "\n        ", Verdict] Reason.

pred candidate-verdict i:list mode, i:(pred), i:(pred), i:(pred), o:string.
candidate-verdict Modes G Head _ V :- head-mismatch Modes G Head Why, !, V is "does not match: " ^ Why.
candidate-verdict _ _ _ Body V :- show-term Body BS, V is "head matches; then its body failed: " ^ BS.

pred no-clause-reason i:any, o:list string.
no-clause-reason P [R] :- declared P _, !, term_to_string P S,
  R is S ^ " is declared but has no clause at all (in the program or in the hypotheses in scope)".
no-clause-reason P [R] :- term_to_string P S, R is S ^ " has no clause at all in scope".

% [head-mismatch Modes G H Why]: the head H does not apply to G; Why names
% the first argument that clashes and the smallest clashing subterms.
pred head-mismatch i:list mode, i:(pred), i:(pred), o:string.
head-mismatch Modes G H Why :-
  constant G _ GArgs, constant H _ HArgs,
  args-mismatch 1 Modes GArgs HArgs Why.

pred args-mismatch i:int, i:list mode, i:list any, i:list any, o:string.
args-mismatch N Ms [A|As] [B|Bs] Why :-
  first-mode Ms M Ms1, arg-match M A B, !, N1 is N + 1, args-mismatch N1 Ms1 As Bs Why.
args-mismatch N Ms [A|_] [B|_] Why :-
  first-mode Ms M _,
  clash M A B Clash,
  std.string.concat "" ["argument ", {std.any->string N}, " (", {mode-name M}, "): ",
    {show-term A}, " vs ", {show-term B}, Clash] Why.

func mode-name mode -> string.
mode-name i "input".
mode-name o "output".

% [clash M A B S]: S describes the smallest subterms of A and B that do not
% agree in mode M (only the reason when they are A and B themselves).
pred clash i:mode, i:any, i:any, o:string.
clash M A B S :-
  subterm-clash M A B A1 B1 Why, not (same_term A A1, same_term B B1), !,
  std.string.concat "" [", at ", {show-term A1}, " vs ", {show-term B1}, Why] S.
clash M A B Why :- subterm-clash M A B _ _ Why, !.
clash _ _ _ "".

% [subterm-clash M A B A1 B1 Why]: A1 and B1 are the clashing subterms.
pred subterm-clash i:mode, i:any, i:any, o:any, o:any, o:string.
subterm-clash i A B A B " (the goal has a variable where the clause expects a term: an input argument is only matched)" :-
  var A, not (var B), !.
subterm-clash _ A B A B Why :- var A, !, flex-clash A B Why.
subterm-clash _ A B A B Why :- var B, !, flex-clash B A Why.

% [flex-clash V T Why]: why the variable V cannot be assigned T: T contains
% V (occurs check), or an eigenvariable that V may not depend on (it was
% introduced by a pi after V was created).
pred flex-clash i:any, i:any, o:string.
flex-clash V T Why :- var V H _, mentions-var T H, !,
  Why is " (occurs check: " ^ {show-term H} ^ " occurs in " ^ {show-term T} ^ ")".
flex-clash V T Why :- names Es, std.exists Es (e\ occurs e T, not (can-depend V e)), !,
  out-of-scope V T Es E,
  Why is " (" ^ {show-term V} ^ " cannot depend on the eigenvariable " ^ {show-term E}
         ^ ", introduced by a pi after " ^ {show-term V} ^ " was created)".
flex-clash _ _ " (they do not unify)".

pred out-of-scope i:any, i:any, i:list any, o:any.
out-of-scope V T [E|_] E :- occurs E T, not (can-depend V E), !.
out-of-scope V T [_|Es] E :- out-of-scope V T Es E.
subterm-clash M A B A1 B1 Why :-
  rigid-parts A HA AArgs, rigid-parts B HB BArgs,
  same_term HA HB, std.length AArgs N, std.length BArgs N, !,
  args-clash M AArgs BArgs A1 B1 Why.
subterm-clash _ A B A B "".

pred args-clash i:mode, i:list any, i:list any, o:any, o:any, o:string.
args-clash M [A|As] [B|Bs] A1 B1 Why :- arg-match M A B, !, args-clash M As Bs A1 B1 Why.
args-clash M [A|_] [B|_] A1 B1 Why :- subterm-clash M A B A1 B1 Why.

% [rigid-parts T Head Args]: the head and arguments of a rigid term
% (constant, eigenvariable or list cell).
pred rigid-parts i:any, o:any, o:list any.
rigid-parts T H Args :- constant T H Args, !.
rigid-parts T H Args :- name T H Args, !.
rigid-parts T list-cell [X, L1] :- not (var T), T = [X|L], !, std.unsafe-cast L L1.

% the head that [rigid-parts] gives to list cells
symb list-cell any.

pred show-deepest-failure.
show-deepest-failure :-
  state "deepest" S, open_safe S L, last-of L (failure D G Above Reasons), !,
  say 0 ["Deepest failure (depth ", {std.any->string D}, "): ", G],
  show-above Above,
  std.forall Reasons (r\ say 1 [r]).
show-deepest-failure :- print "No goal failed at its first try: the query ran out of solutions by backtracking.".

pred show-above i:list string.
show-above [] :- !.
show-above Above :- say 1 ["called from:"], std.forall Above (a\ say 2 [a]).

% ===== 13. Outcome and profile ============================================

pred report-solution.
report-solution :- if (opt profile) show-profile true.

pred report-final-failure.
report-final-failure :-
  if (opt no-explain) true (print "debug: no (more) solution.", show-deepest-failure),
  if (opt profile) show-profile true.

data event.
% [event Kind Id Name Parent Time]: port Kind of box Id, of predicate Name,
% whose caller is of predicate Parent, at Time.
symb event string -> int -> string -> string -> float -> event.

:nooc
pred record-event i:string, o:box.
record-event Kind (box Id _ P _ Above _) :- opt profile, !,
  term_to_string P Name, parent-name Above Parent,
  gettimeofday T, state "profile" S, stash_in_safe S (event Kind Id Name Parent T).
record-event _ _.

:nooc
pred record-native-event i:string, o:ctx, i:(pred).
record-native-event Kind (ctx _ Above) G :- opt profile, not (Kind = "delay"), !,
  native-name G Name, parent-name Above Parent,
  gettimeofday T, state "profile" S, stash_in_safe S (event Kind -1 Name Parent T).
record-native-event _ _ _.

% [native-name G Name]: the name of a builtin goal, for the profile.
func native-name (pred) -> string.
native-name G Name :- constant G P _, !, term_to_string P N, Name is N ^ " (builtin)".
native-name (_ = _) "= (builtin)" :- !.
native-name _ "other builtins".

:nooc
func parent-name list frame -> string.
parent-name [frame _ _ P _|_] Name :- !, term_to_string P Name.
parent-name [] "(query)".

% Statistics of one predicate: calls, exits, redos, fails, clauses tried,
% self time (seconds).
data stats.
symb stats int -> int -> int -> int -> int -> float -> stats.

% [show-profile]: a flat profile.  Self time: the time between two
% consecutive events goes to the predicate running then, which is the one
% just called, redone or trying a clause, or the caller of the one that
% just exited or failed.
pred show-profile.
show-profile :-
  state "profile" S, open_safe S Events,
  std.string.map.empty M0,
  aggregate Events "(query)" -1.0 M0 M,
  std.string.map.bindings M Rows,
  print "Profile (ports per predicate; tries = clauses tried; self time):",
  say 1 [{pad 30 "predicate"}, {padl 8 "calls"}, {padl 8 "exits"}, {padl 8 "redos"},
         {padl 8 "fails"}, {padl 8 "tries"}, {padl 12 "time (ms)"}],
  std.forall Rows show-row.

pred aggregate i:list event, i:string, i:float, i:std.string.map stats, o:std.string.map stats.
aggregate [] _ _ M M.
aggregate [event Kind _ Name Parent T|Es] Running T0 M0 M :-
  DT is T - T0,
  elapsed T0 Running DT M0 M1,
  count Kind Name M1 M2,
  running-after Kind Name Parent Running1,
  aggregate Es Running1 T M2 M.

% [elapsed T0 Name DT M M1]: DT seconds go to Name (none before the first event).
func elapsed float, string, float, std.string.map stats -> std.string.map stats.
elapsed T0 _ _ M M :- T0 < 0.0, !.
elapsed _ Name DT M M1 :- add-time Name DT M M1.

func running-after string, string, string -> string.
running-after "call" N _ N :- !.
running-after "redo" N _ N :- !.
running-after "try" N _ N :- !.
running-after _ _ P P.

func add-time string, float, std.string.map stats -> std.string.map stats.
add-time Name DT M M1 :- get-stats Name M (stats C E R F Tr T), T1 is T + DT,
  std.string.map.add Name (stats C E R F Tr T1) M M1.

func count string, string, std.string.map stats -> std.string.map stats.
count Kind Name M M1 :- get-stats Name M St, bump Kind St St1, std.string.map.add Name St1 M M1.

func get-stats string, std.string.map stats -> stats.
get-stats Name M St :- std.string.map.find Name M St, !.
get-stats _ _ (stats 0 0 0 0 0 0.0).

func bump string, stats -> stats.
bump "call" (stats C E R F Tr T) (stats C1 E R F Tr T) :- !, C1 is C + 1.
bump "exit" (stats C E R F Tr T) (stats C E1 R F Tr T) :- !, E1 is E + 1.
bump "redo" (stats C E R F Tr T) (stats C E R1 F Tr T) :- !, R1 is R + 1.
bump "fail" (stats C E R F Tr T) (stats C E R F1 Tr T) :- !, F1 is F + 1.
bump "try"  (stats C E R F Tr T) (stats C E R F Tr1 T) :- !, Tr1 is Tr + 1.
bump _ S S.

func show-row pair string stats.
show-row (pr Name (stats C E R F Tr T)) :-
  Ms is T * 1000.0,
  say 1 [{pad 30 Name}, {padl 8 {std.any->string C}}, {padl 8 {std.any->string E}},
         {padl 8 {std.any->string R}}, {padl 8 {std.any->string F}},
         {padl 8 {std.any->string Tr}}, {padl 12 {ms-string Ms}}].

% [ms-string X S]: X with two decimals.
func ms-string float -> string.
ms-string X S :- N is truncate (X * 100.0), I is N div 100, F is N mod 100,
  std.any->string F FD, two-digits FD FS,
  S is {std.any->string I} ^ "." ^ FS.

func two-digits string -> string.
two-digits D S :- 1 is size D, !, S is "0" ^ D.
two-digits D D.

% [pad N S P]: S padded on the right to N characters; [padl] on the left.
func pad int, string -> string.
pad N S S :- L is size S, L >= N, !.
pad N S P :- S1 is S ^ " ", pad N S1 P.

func padl int, string -> string.
padl N S S :- L is size S, L >= N, !.
padl N S P :- S1 is " " ^ S, padl N S1 P.

}

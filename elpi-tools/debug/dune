; debug.elpi, the interpreter: the files lib/*.elpi, one per concern (README.md,
; "How the interpreter works"), in this order, inside one block
; namespace debug { }.  One block: Elpi resolves the names of a namespace
; block by block, so a block would not see the unqualified names of another.
(rule
 (targets debug.elpi)
 (deps
  lib/state.elpi lib/program.elpi lib/strategy.elpi lib/interpreter.elpi
  lib/compiled.elpi lib/natives.elpi lib/lprolog.elpi lib/ports.elpi lib/stepper.elpi
  lib/machine.elpi lib/explain.elpi lib/profile.elpi)
 (action
  (with-stdout-to
   debug.elpi
   (progn
    (echo "% Generated by dune from lib/*.elpi: do not edit.\nnamespace debug {\n")
    (cat lib/state.elpi) (cat lib/program.elpi) (cat lib/strategy.elpi)
    (cat lib/interpreter.elpi) (cat lib/compiled.elpi) (cat lib/natives.elpi) (cat lib/lprolog.elpi)
    (cat lib/ports.elpi) (cat lib/stepper.elpi) (cat lib/machine.elpi)
    (cat lib/explain.elpi)
    (cat lib/profile.elpi)
    (echo "}\n")))))

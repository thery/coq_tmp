; elpi-debug: the command line of the debugger (see ../README.md).
(executable
 (name elpi_debug_main)
 (public_name elpi-debug)
 (package elpi-tools)
 (libraries elpi elpi.parser elpi.util elpi_reflect str unix))

; The two Elpi files the driver loads, embedded in the executable.
(rule
 (targets embedded.ml)
 (deps ../debug.elpi ../../reflect/reflect.elpi)
 (action
  (with-stdout-to
   embedded.ml
   (progn
    (echo "let debug_elpi = {elpi|")
    (cat ../debug.elpi)
    (echo "|elpi}\n")
    (echo "let reflect_elpi = {elpi|")
    (cat ../../reflect/reflect.elpi)
    (echo "|elpi}\n")))))

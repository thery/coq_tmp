% program.elpi: the debugged program, as data.
%
% elpi-tools/reflect (../../reflect/README.md) gives the rules of the
% program as facts [reflect.clause P Index Loc Attributes Head Body] and its
% declarations as facts [reflect.signature Name P F Args Variadic Loc].


% ---- Rules ------------------------------------------------------------------

% Where a candidate clause comes from: a rule of the program (its location
% and its attributes, which give the source names of its binders), or a
% hypothetical clause (the text naming the call that added it, and a number
% of its own).  Turned into text only when shown.
data origin.
symb at reflect.srcloc -> list reflect.attribute -> origin.
symb added-by string -> int -> origin.

% [program-rule P I Head Body Origin]: by backtracking, the rules of P in
% Elpi's order (I is their index, from 1), with fresh variables.
pred program-rule i:any, o:int, o:(pred), o:(pred), o:origin.
program-rule P I Head Body (at Loc Attrs) :-
  reflect.clause P I Loc Attrs Head Body,
  constant Head Q _, same_term Q P.     % (the rules of an overloaded predicate have no index)

% [origin-string Origin S]: "file:line", or "hypothesis added by #N".
func origin-string origin -> string.
origin-string (added-by S _) S.
origin-string (at (reflect.srcloc File Line _) _) S :-
  rex.replace "^.*/" "" File Base,
  S is Base ^ ":" ^ {std.any->string Line}.

% [numbered-rules Rules]: the rules of the program, in the order of
% reflect's facts; the rule numbered N (from 1) is the N-th (the numbers of
% the commands + clause N, - clause N and of machine.elpi's listing).
pred numbered-rules o:list (pred).
numbered-rules Rules :- std.findall (reflect.clause _ _ _ _ _ _) Rules.

% [clause-location N Loc]: the location of the rule numbered N; the CHR
% rules are numbered after the rules, in the order of reflect's facts
% (chr.elpi, [chr-rule-number]).
pred clause-location i:int, o:reflect.srcloc.
clause-location N Loc :-
  numbered-rules Rules, std.length Rules Count, N >= 1, N =< Count, !,
  I is N - 1, std.nth I Rules Rule, Rule = reflect.clause _ _ Loc _ _ _.
clause-location N Loc :-
  numbered-rules Rules, std.length Rules Count, I is N - Count,
  reflect.chr-rule I Loc _ _ _ _ _ _.

% ---- Declarations and modes -------------------------------------------------

% The mode of an argument: [i] (input: the goal argument is matched, its
% variables are not assigned) or [o] (output: it is unified).
data mode.
symb i mode.
symb o mode.

% [declared P Modes]: P is a predicate of the program, declared with these
% modes ([run] installs one such local clause per signature, indexed by P).
pred declared o:any, o:list mode.

% [declarations Ds]: the [declared] clauses of the program's signatures.
pred declarations o:list (pred).
declarations Ds :-
  std.findall (reflect.signature _ _ _ _ _ _) Sigs,
  std.fold Sigs [] add-declaration Ds.

% [add-declaration Sig Ds Ds1]: the declaration of a predicate of the
% program (not of a builtin, nor of an overloaded symbol, whose constant
% reflect cannot give).
func add-declaration (pred), list (pred) -> list (pred).
add-declaration (reflect.signature _ P _ Args _ Loc) Ds [declared P Modes | Ds] :-
  program-signature P Loc, !, std.map Args arg-mode Modes.
add-declaration _ Ds Ds.

% [program-signature P Loc]: a signature of the program itself.
pred program-signature i:any, i:reflect.srcloc.
program-signature P Loc :- not (var P), not (builtin-loc Loc).

% [builtin-loc Loc]: a declaration of Elpi's builtins or standard library
% (printed by elpi-reflect -builtins), which run natively.
pred builtin-loc i:reflect.srcloc.
builtin-loc (reflect.srcloc File _ _) :- rex.match "^builtin[a-z_]*\\.elpi$" File.

func arg-mode reflect.arg -> mode.
arg-mode (reflect.arg reflect.in _) i.
arg-mode (reflect.arg reflect.out _) o.

% [modes-of P G Modes]: the modes of P (all outputs when undeclared).
pred modes-of i:any, i:(pred), o:list mode.
modes-of P _ Modes :- declared P Modes, !.
modes-of _ G Modes :- constant G _ Args, std.map Args (_\ m\ m = o) Modes.

% ---- Bridges ----------------------------------------------------------------
%
% Each predicate of the program gets one native rule, its bridge
%   P X1 .. Xn :- !, debug.bridge (P X1 .. Xn).
% which sends a native call of P (from std.map, not, a woken constraint...)
% back to the interpreter (natives.elpi).  The driver accumulates them
% after the program, whose own rules it removes.
%
% STAND-IN for the fix of an Elpi crash (../ELPI-WISHLIST.md §7,
% LPCIC/elpi#505): the bridges are static rules, written to a file by
% [write-bridges] in a first run of the driver, not local clauses
% [pi x1..xn\ ...] that [run] would install with the compiled rules: with
% those, Elpi crashes when a CHR rule fires.

% [write-bridges File]: write the bridges to File.
pred write-bridges i:string.
write-bridges File :-
  open_out File Out,
  output Out "% Bridges: the native rule of each program predicate (see debug/lib/program.elpi).\n",
  std.findall (reflect.signature _ _ _ _ ff _) Sigs,
  std.fold Sigs [] (write-bridge Out) _,
  close_out Out.

% [write-bridge Out Sig Done Done1]: the bridge of one predicate, once per
% name (an overloaded predicate has several signatures).
func write-bridge out_stream, (pred), list string -> list string.
write-bridge _ (reflect.signature Name _ _ _ _ _) Done Done :- std.mem! Done Name, !.
write-bridge Out (reflect.signature Name P _ Args _ Loc) Done [Name|Done] :-
  program-signature P Loc, !,
  std.length Args N, bridge-text Name N Text, output Out Text.
write-bridge _ _ Done Done.

% [bridge-text Name N Text]: "(Name X0 .. Xn-1) :- !, debug.bridge (Name X0 .. Xn-1).\n"
func bridge-text string, int -> string.
bridge-text Name N Text :-
  std.iota N Is,
  std.map Is (i\ s\ s is " X" ^ {std.any->string i}) Vars,
  std.string.concat "" ["(", Name | Vars] Open,
  Goal is Open ^ ")",
  Text is Goal ^ " :- !, debug.bridge " ^ Goal ^ ".\n".


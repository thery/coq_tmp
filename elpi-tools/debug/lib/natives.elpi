% natives.elpi: builtins, suspended goals (CHR at depth 1) and the way
% back from native code into the interpreter.


% ===== Builtins ====================================================================

% [native Ctx Entry G]: the builtin goal G, run natively (the program goals
% it calls back entered as Entry), with its call, exit and fail ports
% (shown with option builtins; none on the fast path, where no event is
% shown or recorded).  Only a builtin that fails without ever
% succeeding is a candidate for the failure explanation.
:nooc
pred native o:ctx, i:entry, i:(pred).
native Ctx _ G :- quiet, !,
  new_safe Exited,
  unseen-native Exited Ctx G.
native Ctx Entry G :-
  native-port call-port Ctx G,
  new_safe Exited,
  native-ports Exited Ctx Entry G.

:nooc
pred unseen-native i:safe, o:ctx, i:(pred).
unseen-native Exited Ctx G :- run-native Ctx called G, stash_in_safe Exited "exited".
unseen-native Exited Ctx G :- note-native-failure-if-first Exited Ctx G, fail.

% (alternatives as clauses, not ;, as for [box-ports])
:nooc
pred native-ports i:safe, o:ctx, i:entry, i:(pred).
native-ports Exited Ctx Entry G :-
  run-native Ctx Entry G, native-port exit-port Ctx G, stash_in_safe Exited "exited".
native-ports Exited Ctx _ G :-
  native-port fail-port Ctx G, note-native-failure-if-first Exited Ctx G, fail.

% [run-native Ctx Entry G]: run G, with Ctx as the context of the program
% goals it may call back (through their bridges), entered as Entry.
% Installing the local clause costs the same whatever the size of Ctx (measured: under 1 µs, with 1 or
% 50 frames of large goals), far less than looking into G for a possible
% call back, so it is always installed.  (Reading it back, at a call
% back only, walks Ctx: Elpi makes the occurs check on the head
% unification of every local clause, ../ELPI-FEATURE-REQUESTS.md §13.)
:nooc
pred run-native o:ctx, i:entry, i:(pred).
run-native Ctx Entry G :- (current-ctx Entry Ctx => G).

% ===== Suspended goals: CHR at depth 1 ==================================================
%
% [delay Ctx G Keys]: G suspended on Keys by the real declare_constraint,
% so that the CHR rules see the same constraints and fire natively.  The
% suspension gets a number, in force as [suspended-as K] in its context
% (chr-hooks.elpi); when G is woken, its bridge brings it back into the
% interpreter, where it enters through the resume port with that number
% (ECLiPSe's DELAY and RESUME ports).  The attempts of the CHR rules that
% the new constraint led to are shown after it (chr.elpi).
:nooc
pred delay o:ctx, i:(func), i:any.
delay Ctx G Keys :-
  suspension-number K,
  delay-port Ctx G Keys K,
  note-declaration Ctx,
  delay-or-explain Ctx G Keys K,
  show-rule-attempts Ctx.

:nooc
pred delay-or-explain o:ctx, i:(func), i:any, i:int.
delay-or-explain Ctx G Keys K :- suspension-clauses K Ctx Cs, (Cs => declare_constraint G Keys).
delay-or-explain Ctx G _ _ :-
  show-rule-attempts Ctx,
  note-goal-failure Ctx G ["declare_constraint failed: adding this constraint fired a CHR rule that failed"],
  fail.

% [suspension-clauses K Ctx Cs]: the local clauses in force for the
% goal suspended as K in the context Ctx: its context for the bridges,
% and its number for the guards of the CHR rules and the store (none on
% the fast path, where K is 0).
:nooc
pred suspension-clauses i:int, o:ctx, o:list (pred).
suspension-clauses 0 Ctx [current-ctx (woken 0) Ctx] :- !.
suspension-clauses K Ctx [current-ctx (woken K) Ctx, suspended-as K].

% [suspension-number K]: the number of a new suspension (0 on the fast path).
pred suspension-number o:int.
suspension-number 0 :- quiet, !.
suspension-number K :- new-number "suspension" K.

% ===== The way back: bridges ==============================================================

% [bridge G]: a goal of a program predicate called natively (by a builtin
% or by CHR) through its bridge (program.elpi): a call, in the context of
% the innermost builtin.
pred bridge i:(pred).
bridge G :- current-ctx Entry Ctx, !, program-goal G P, call Ctx P G Entry.


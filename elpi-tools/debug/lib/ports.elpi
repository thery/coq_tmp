% ports.elpi: the events of a run, shown by the trace and where the
% stepper stops (stepper.elpi).
%
% An event is a port of a call (call, exit, redo, fail; resume for a woken
% goal), or a step of λProlog inside a call: the head unification of the
% selected clause (unify), the entry into pi (pi) or into H => G (assume),
% the suspension of a goal (delay), a cut.


data event-kind.
symb call-port event-kind.
symb exit-port event-kind.
symb redo-port event-kind.
symb fail-port event-kind.
symb resume-port event-kind.   % the call port of a woken goal
symb unify-step event-kind.
symb pi-step event-kind.
symb assume-step event-kind.
symb delay-step event-kind.
symb cut-step event-kind.
symb try-step event-kind.      % a candidate clause tried (recorded for the profile only)
symb start-step event-kind.    % the start of a run, before its first event (option machine)

func event-label event-kind -> string.
event-label call-port "Call:".
event-label exit-port "Exit:".
event-label redo-port "Redo:".
event-label fail-port "Fail:".
event-label resume-port "Resume:".
event-label unify-step "Unify:".
event-label pi-step "Pi:".
event-label assume-step "Assume:".
event-label delay-step "Delay:".
event-label cut-step "Cut:".
event-label try-step "Try:".
event-label start-step "Start:".

% [box-event K]: K is a port of a call.
pred box-event i:event-kind.
box-event call-port. box-event exit-port. box-event redo-port.
box-event fail-port. box-event resume-port.

% [entry-event K]: K enters a call (where a breakpoint stops).
pred entry-event i:event-kind.
entry-event call-port. entry-event resume-port.

% [end-event K]: K leaves a call.
pred end-event i:event-kind.
end-event exit-port. end-event fail-port.

% ===== Printing ===================================================================

% [say Depth Parts]: print the concatenation of Parts, indented by Depth.
func say int, list string.
say D Parts :- indent D Ind, std.string.concat "" [Ind|Parts] S, print S.

func indent int -> string.
indent N "" :- N =< 0, !.
indent N S :- M is N - 1, indent M S1, S is S1 ^ "  ".

% [box-name Id S]: "#Id".
func box-name int -> string.
box-name Id S :- S is "#" ^ {std.any->string Id}.

% ===== Events ======================================================================

% [event Kind Indent Focus Text]: the event Kind about Focus, printed at
% indentation Indent when shown; then the stop, if any.  Text makes the
% text of the event after its label (Text T), only when the event is shown
% or stops: it prints goals, which may be large, and most events are
% neither (with option profile, or between breakpoints).  It fails while a
% retry or fail is unwinding the run, and when the command at the stop
% asks for it.  (The hot paths use clauses rather than std.if: its
% arguments are inputs, and the goals given to it would hold the whole
% stack of frames.)
:nooc
pred event i:event-kind, i:int, o:focus, i:(pred o:list string).
event _ _ _ _ :- pending, !, fail.
event Kind Ind F Text :- event-shown Kind F, !,
  Text T, say Ind [{event-label Kind}, " " | T],
  stop-if-stopping Kind F T.
event Kind _ F Text :- stop-reason Kind F Reason, !, Text T, stop Reason Kind F T.
event _ _ _ _.

:nooc
pred stop-if-stopping i:event-kind, o:focus, i:list string.
stop-if-stopping Kind F Text :- stop-reason Kind F Reason, !, stop Reason Kind F Text.
stop-if-stopping _ _ _.

% [event-shown Kind F]: the event is printed: with option trace, as the
% stepping mode says in interactive mode, at the ports of a breakpoint.
:nooc
pred event-shown i:event-kind, o:focus.
event-shown _ _ :- opt trace, !.
event-shown Kind F :- opt interactive, current-mode M, !, shown-in-mode M Kind F.
event-shown Kind (focus (frame _ _ P _) _) :- box-event Kind, breakpoint-on P.

% ===== The ports of a call ===========================================================

% [port Kind Box]: Box passes the port Kind (call-port is shown as
% resume-port for a woken goal, with the number of its suspension).
:nooc
pred port i:event-kind, o:box.
port _ _ :- quiet, !.
port Kind Box :-
  record-event Kind Box,
  box-split Box Frame Above Entry,
  entry-port Kind Entry Kind1 Tag,
  frame-depth Frame D,
  event Kind1 D (focus Frame Above) (port-text Tag Frame).

% [port-text Tag Frame T]: the text of a port, "[Sn] #Id goal".
:nooc
pred port-text i:string, i:frame, o:list string.
port-text Tag Frame [Tag | T] :- frame-text Frame T.

% [entry-port Kind Entry Kind1 Tag]: a woken goal enters through
% resume-port, all its ports tagged [Sn].
func entry-port event-kind, entry -> event-kind, string.
entry-port call-port (woken N) resume-port Tag :- !, suspension-tag N Tag.
entry-port Kind (woken N) Kind Tag :- !, suspension-tag N Tag.
entry-port Kind called Kind "".

func suspension-tag int -> string.
suspension-tag N Tag :- Tag is "[S" ^ {std.any->string N} ^ "] ".

% [frame-text Frame Text]: "#Id goal".
:nooc
func frame-text frame -> list string.
frame-text (frame Id _ _ G) [{box-name Id}, " ", {show-term G}].

:nooc
func frame-depth frame -> int.
frame-depth (frame _ D _ _) D.

% [try-port Ctx]: a candidate clause is tried by the call whose body would
% run in Ctx (for the profile: with option profile, it comes first in the
% head unification of every compiled clause, compiled.elpi).
:nooc
pred try-port i:ctx.
try-port (ctx _ [Frame | Above]) :- record-event try-step (box Frame Above called).

% ===== The steps of λProlog inside a call ===============================================

% [unify-port Ctx Origin Head Post]: the end of the head unification of
% the clause from Origin with head Head (Post: what follows the prefix that
% Elpi matched when it selected the clause, compiled.elpi), for the call
% whose body runs in Ctx, with its unify event when it is shown or when a
% breakpoint is set on the clause: the variables of the goal are looked at
% before and after, for the bindings it makes (the matching of the prefix
% binds none).  The event runs in the context of the clause: [runs Id
% Origin] and [made-bindings Bindings] are in force, for the stepper and
% the machine-readable channel (stepper.elpi, machine.elpi).
:nooc
pred unify-port i:ctx, i:origin, i:(pred), i:(pred).
unify-port (ctx _ [Frame | Above]) Origin _ Post :-
  not (event-shown unify-step (focus Frame Above)), not (clause-breakpoint-on Origin), !,
  Post.
unify-port (ctx _ [frame Id D P G | Above]) Origin Head Post :-
  logic-vars G Vs, snapshot Vs Before,
  Post,
  bindings-made Before Bindings,
  std.map Bindings binding-line Lines,
  [runs Id Origin, made-bindings Bindings] =>
    event unify-step D (focus (frame Id D P G) Above) (unify-text Id Origin Head Lines).

% [unify-text Id Origin Head Lines T]: the text of a unify event.
pred unify-text i:int, i:origin, i:(pred), i:list string, o:list string.
unify-text Id Origin Head Lines [{box-name Id}, " with ", {origin-string Origin}, ": ", {show-term Head} | Lines].

% [runs Id Origin]: the call Id runs the clause from Origin (in force in
% the body of the clause, with option machine, and at its unify event).
pred runs o:int, o:origin.

% [made-bindings Bindings]: the bindings made by the head unification of
% the unify event in progress.
pred made-bindings o:list binding.

% A logic variable before the unification: itself, as printed, and the
% eigenvariables it may depend on.
data snap.
symb snap any -> string -> list any -> snap.

pred snapshot i:list any, o:list snap.
snapshot [] [].
snapshot [V|Vs] [snap V Name Vis | Ss] :- show-term V Name, visible-eigens V Vis, snapshot Vs Ss.

% A binding made by a unification: the variable (as printed before), its
% value, and the pruning Elpi made ("" if none).
data binding.
symb binding string -> string -> string -> binding.

% [bindings-made Before Bindings]: a binding per variable assigned, with
% the pruning Elpi made if any.
pred bindings-made i:list snap, o:list binding.
bindings-made [] [].
bindings-made [snap V Name Vis | Ss] [binding Name Now Pruned | Bs] :-
  show-term V Now, not (Now = Name), !,
  pruning V Vis Pruned,
  bindings-made Ss Bs.
bindings-made [_ | Ss] Bs :- bindings-made Ss Bs.

% [binding-line B Line]: "\n      X := t", as the trace shows a binding.
func binding-line binding -> string.
binding-line (binding Name Value Pruned) Line :-
  std.string.concat "" ["\n      ", Name, " := ", Value, Pruned] Line.

% [pruning V Vis S]: what Elpi pruned when it assigned V: V is now
% x1..xn\ H a1..ak with k < n (H does not get all the arguments), or V is
% (headed by) a variable that may depend on fewer eigenvariables than Vis.
pred pruning i:any, i:list any, o:string.
pruning V _ S :- lambda-prefix V 0 N K H, N > 0, K < N, !,
  S is "   (pruned: " ^ {show-term H} ^ " gets " ^ {std.any->string K} ^ " of the "
       ^ {std.any->string N} ^ " arguments)".
pruning V Vis S :- var V H _, visible-eigens H Now, lost-eigens Vis Now Lost, not (Lost = []), !,
  eigen-names Lost Ns,
  S is "   (pruned: may no longer depend on " ^ {std.string.concat ", " Ns} ^ ")".
pruning _ _ "".

% [lambda-prefix T N0 N K H]: T is N-N0 binders around H a1..ak (H a
% variable, k = K); the test is made under the binders, where the body
% lives (H itself is older, so it can be returned).
pred lambda-prefix i:any, i:int, o:int, o:int, o:any.
lambda-prefix T N0 N K H :- shape-of T S, S = binder F, !, N1 is N0 + 1,
  pi x\ sigma B\ binder-body F x B, lambda-prefix B N1 N K H.
lambda-prefix T N N K H :- var T H Args, std.length Args K.

% [lost-eigens Before Now Lost]: the eigenvariables of Before not in Now.
pred lost-eigens i:list any, i:list any, o:list any.
lost-eigens [] _ [].
lost-eigens [E|Es] Now Lost :- std.exists Now (same_term E), !, lost-eigens Es Now Lost.
lost-eigens [E|Es] Now [E|Lost] :- lost-eigens Es Now Lost.

% [pi-port Ctx Name X Body N]: entering pi: X is a new eigenvariable, named
% N (its source name and a number), whose scope is Body.
:nooc
pred pi-port o:ctx, i:string, i:any, i:(pred), o:string.
pi-port _ Name _ _ Name :- quiet, !.
pi-port (ctx D Above) Name X Body N :-
  new-number "eigen" K, N is Name ^ "#" ^ {std.any->string K},
  (eigen X N => event pi-step D {ctx-focus Above} (pi-text N Body)).

% [pi-text N Body T]: the text of a pi step.
pred pi-text i:string, i:(pred), o:list string.
pi-text N Body [N, " is a new eigenvariable; its scope: ", {show-term Body}].

% [assume-port Ctx H B]: entering H => B: H is added to the local program,
% for B only.
:nooc
pred assume-port o:ctx, i:any, i:(pred).
assume-port _ _ _ :- quiet, !.
assume-port (ctx D Above) H B :-
  event assume-step D {ctx-focus Above} (assume-text H B).

% [assume-text H B T]: the text of an assume step.
pred assume-text i:any, i:(pred), o:list string.
assume-text H B [{show-term H}, "   (added to the local program, for ", {show-term B}, " only)"].

% [delay-port Ctx G Keys K]: G suspended on Keys, suspension number K.
:nooc
pred delay-port o:ctx, i:(pred), i:any, i:int.
delay-port _ _ _ _ :- quiet, !.
delay-port (ctx D Above) G Keys K :-
  event delay-step D {ctx-focus Above} (delay-text K G Keys).

% [delay-text K G Keys T]: the text of a delay step.
pred delay-text i:int, i:(pred), i:any, o:list string.
delay-text K G Keys [{suspension-tag K}, {show-term G}, " on ", {show-term Keys}].

% [cut-port Ctx]: a cut commits the call above Ctx to its current clause.
:nooc
pred cut-port o:ctx.
cut-port _ :- quiet, !.
cut-port (ctx _ [frame Id D P G | Above]) :- !,
  event cut-step D (focus (frame Id D P G) Above) (cut-text Id).

% [cut-text Id T]: the text of a cut step.
pred cut-text i:int, o:list string.
cut-text Id [{box-name Id}, " commits to its current clause"].
cut-port _.

% [ctx-focus Above F]: the focus of a step inside the body of the nearest
% call above (the query itself when there is none).
:nooc
func ctx-focus list frame -> focus.
ctx-focus [Frame | Above] (focus Frame Above) :- !.
ctx-focus [] (focus (frame 0 0 query true) []).

% ===== Builtins ==========================================================================

% [native-port Kind Ctx G]: a port of the builtin goal G (shown with option
% builtins; recorded for the profile).
:nooc
pred native-port i:event-kind, o:ctx, i:(pred).
native-port _ _ _ :- quiet, !.
native-port _ _ _ :- pending, !, fail.
native-port Kind Ctx G :-
  record-native-event Kind Ctx G,
  show-native-if-shown Kind Ctx G.

:nooc
pred show-native-if-shown i:event-kind, o:ctx, i:(pred).
show-native-if-shown Kind (ctx D _) G :- opt builtins, !,
  say D ["(builtin) ", {event-label Kind}, " ", {show-term G}].
show-native-if-shown _ _ _.


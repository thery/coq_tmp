% A random solver for the premises generated-by G.
%
% A small meta-interpreter over the reflected rules: for a goal whose
% predicate has rules in the program, the rules and the hypotheses added by
% => are tried in a random order, to a depth bound; the first solution is
% kept for each subgoal (no backtracking into a solved subgoal, so a failed
% search stays cheap).  The other goals (builtins, std, predicates without
% rules) run natively, under the hypotheses.  Cut is ignored: every rule is
% a candidate.
% This is the "generation by the program" of Blanco, Miller and Momigliano:
% the values come out of a random derivation of G.

namespace check.solve {

% [solve D Hyps G]: a random solution of G with derivations of depth at
% most D, under the hypotheses Hyps (the rules added by =>, newest first;
% kept in a list, not added with =>, so that their variables stay shared)
pred solve i:int, i:list (pred), i:(pred).
solve _ _ true :- !.
solve _ _ ! :- !.
solve D Hyps G :- check.goals.conjuncts G Gs, !, solve-all D Hyps Gs.
solve D Hyps (A ; B) :- !,
  if (check.random.chance 2) (solve D Hyps A ; solve D Hyps B) (solve D Hyps B ; solve D Hyps A).
solve D Hyps (pi x\ F x) :- !, pi x\ solve D Hyps (F x).
solve D Hyps (sigma x\ F x) :- !, solve D Hyps (F _).
solve D Hyps (H => G) :- !, assume H Hyps Hyps1, solve D Hyps1 G.
solve D Hyps (H ==> G) :- !, assume H Hyps Hyps1, solve D Hyps1 G.
solve D Hyps G :- check.goals.atom G _ Pred _, has-candidates Pred Hyps G, !, solve-atom D Hyps Pred G.
solve _ Hyps G :- Hyps => G, !.

% [solve-all D Hyps Gs]: each goal in turn, keeping its first solution
pred solve-all i:int, i:list (pred), i:list (pred).
solve-all _ _ [].
solve-all D Hyps [G | Gs] :- solve D Hyps G, !, solve-all D Hyps Gs.

% [assume H Hyps Hyps1]: Hyps1 is Hyps with the rule(s) H
pred assume i:any, i:list (pred), o:list (pred).
assume [] Hyps Hyps :- !.
:untyped
assume [H | Hs] Hyps Out :- !, assume Hs [H | Hyps] Out.
:untyped
assume H Hyps [H | Hyps].

pred has-candidates i:any, i:list (pred), i:(pred).
has-candidates Pred _ _ :- check.goals.has-rules Pred, !.
has-candidates _ Hyps G :- std.exists Hyps (h\ head-of h G), !.

% [head-of H G]: the hypothesis H is a rule for the goal G
pred head-of i:(pred), i:(pred).
head-of (Hd :- _) G :- !, same-predicate Hd G.
head-of Hd G :- same-predicate Hd G.
pred same-predicate i:(pred), i:(pred).
same-predicate A B :- check.goals.atom A _ P _, check.goals.atom B _ P _.

% A candidate to solve an atom: a rule of the program (by its index) or a
% hypothesis
data candidate.
symb program-rule int -> candidate.
symb assumed (pred) -> candidate.

% [solve-atom D Hyps Pred G]: G solved by one of its candidates, in random
% order
pred solve-atom i:int, i:list (pred), i:any, i:(pred).
solve-atom D Hyps Pred G :-
  D >= 0,
  check.goals.rules-count Pred N,
  program-rules 1 N Rules,
  std.filter Hyps (h\ head-of h G) Relevant,
  std.map Relevant assumed-candidate Assumed,
  std.append Assumed Rules All,
  check.random.shuffle All Ordered,
  D1 is D - 1,
  std.mem Ordered C,
  try C Pred D1 Hyps G, !.

func program-rules int, int -> list candidate.
program-rules I N [] :- I > N, !.
program-rules I N [program-rule I | Rules] :- I1 is I + 1, program-rules I1 N Rules.

func assumed-candidate (pred) -> candidate.
assumed-candidate H (assumed H).

pred try i:candidate, i:any, i:int, i:list (pred), i:(pred).
try (program-rule I) Pred D Hyps G :- reflect.clause Pred I _ _ Head Body, Head = G, solve D Hyps Body.
try (assumed (Head :- Body)) _ D Hyps G :- !, Head = G, solve D Hyps Body.
try (assumed Head) _ _ _ G :- Head = G.

}

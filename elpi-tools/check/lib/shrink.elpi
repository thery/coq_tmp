% Smaller candidates for a value, to shrink a counterexample.
%
% For a term of a data type, in this order (the smallest first):
% 1. the leaves of its type ([] for a list, leaf for a tree ...);
% 2. its arguments of the same type (the tail of a list, the subtrees; the
%    body of a binder when it does not use the bound variable);
% 3. the term with one argument replaced by one of its candidates.
% For an int N: 0, N/2, N-1 towards 0; for a string: ""; a float: 0.0.
% And for the values of a counterexample together: a literal that occurs
% more than once replaced everywhere by the same candidate ([together]).
% Every candidate weighs strictly less (weight: its size plus the absolute
% values of its integers), so the greedy loop in run.elpi stops.

namespace check.shrink {

% [candidate T X Y]: Y is a smaller term than X, both of type T
pred candidate i:reflect.ty, i:any, o:any.
candidate T X Y :- check.types.expand T T1, candidate.of T1 X Y, smaller Y X.

% [smaller Y X]: Y weighs less than X
pred smaller i:any, i:any.
smaller Y X :- weight Y WY, weight X WX, WY < WX.

% [weight X W]: the size of X plus the absolute values of its integers and
% the lengths of its strings: a candidate always weighs less, so shrinking
% stops
func weight any -> int.
weight X W :- check.gen.size X S, literals X L, W is S + L.

% [literals X N]: the absolute values of the integers of X plus the
% lengths of its strings
func literals any -> int.
literals X N :- occurrences X [] Ls, std.fold Ls 0 add-literal-weight N.

% [add-literal-weight L Acc N]: N is Acc plus the weight of the literal L
func add-literal-weight any, int -> int.
add-literal-weight L Acc N :- literal-weight L W, N is Acc + W.

% [literal-weight L W]: |L| for an int, the length for a string, else 0
func literal-weight any -> int.
literal-weight L W :- is_cdata L "int", !, int-abs L W.
literal-weight L W :- is_cdata L "string", !, W is size L.
literal-weight _ 0.

% [occurrences X Acc Ls]: Ls is the literals of X (ints, strings, floats
% .., every occurrence, binders included) followed by Acc
func occurrences any, list any -> list any.
occurrences X Acc Acc :- var X, !.
occurrences [] Acc Acc :- !.
occurrences [H | T] Acc Ls :- !, occurrences T Acc Acc1, occurrences H Acc1 Ls.
occurrences X Acc [X | Acc] :- is_cdata X _, !.
occurrences X Acc Ls :- constant X _ Args, !, occurrences-of Args Acc Ls.
occurrences X Acc Ls :- name X _ Args, !, occurrences-of Args Acc Ls.
occurrences (x\ B x) Acc Ls :- pi y\ occurrences (B y) Acc Ls.

% [occurrences-of Xs Acc Ls]: the literals of the terms Xs, then Acc
func occurrences-of list any, list any -> list any.
occurrences-of [] Acc Acc.
occurrences-of [X | Xs] Acc Ls :- occurrences-of Xs Acc Acc1, occurrences X Acc1 Ls.

% [int-abs N M]: M is the absolute value of the int N
func int-abs any -> int.
:untyped
int-abs N M :- if (N < 0) (M is 0 - N) (M = N).

pred candidate.of i:reflect.ty, i:any, o:any.
candidate.of _ X _ :- var X, !, fail.
candidate.of (reflect.tcon "int" []) N M :- !, int-candidate N M.
candidate.of (reflect.tcon "string" []) S "" :- !, not (S = "").
candidate.of (reflect.tcon "float" []) F 0.0 :- !, not (F = 0.0).
candidate.of (reflect.tarrow A B) F G :- !, pi x\ check.gen.bound-var x A => candidate B (F x) (G x).
candidate.of T X Y :- leaf-candidate T X Y.
candidate.of T X Y :- decompose X K Args, constructor-arguments K T ArgTypes,
  same-type-argument T Args ArgTypes Y.
candidate.of T X Y :- decompose X K Args, constructor-arguments K T ArgTypes,
  one-argument-smaller Args ArgTypes Args1, check.gen.apply K Args1 Y.

pred int-candidate i:int, o:int.
int-candidate N 0 :- not (N = 0).
int-candidate N M :- M is N div 2, not (M = 0), not (M = N).
int-candidate N M :- N > 0, M is N - 1, not (M = 0).
int-candidate N M :- N < 0, M is N + 1, not (M = 0).

% [leaf-candidate T X Y]: Y is a leaf of type T other than X
pred leaf-candidate i:reflect.ty, i:any, o:any.
leaf-candidate T X Y :-
  check.gen.choices T Leaves _, std.mem Leaves (check.gen.choice Y []), not (Y = X).

% [decompose X K Args]: X is the constructor (or bound variable) K applied
% to Args
pred decompose i:any, o:any, o:list any.
:untyped
decompose [H | T] (::) [H, T] :- !.
decompose X K Args :- constant X K Args, !.
decompose X K Args :- name X K Args, not (Args = []).

% [constructor-arguments K T ArgTypes]: the types of the arguments of K in a
% term of type T
pred constructor-arguments i:any, i:reflect.ty, o:list reflect.ty.
constructor-arguments K T ArgTypes :-
  term_to_string K Name, reflect.constructor Name _ KT _, !,
  check.types.split-arrows KT ArgTypes R, R = T.
constructor-arguments K T ArgTypes :-
  check.gen.bound-var K KT, !, check.types.split-arrows KT ArgTypes R, R = T.

% [same-type-argument T Args ArgTypes Y]: Y is an argument of type T; under a
% binder, a body that does not use its variable
pred same-type-argument i:reflect.ty, i:list any, i:list reflect.ty, o:any.
same-type-argument T [A | _] [AT | _] A :- AT = T.
same-type-argument T [A | _] [reflect.tarrow _ B | _] Y :- B = T, A = (_\ Y).
same-type-argument T [_ | As] [_ | ATs] Y :- same-type-argument T As ATs Y.

% [one-argument-smaller Args ArgTypes Args1]: one argument replaced by a
% candidate
pred one-argument-smaller i:list any, i:list reflect.ty, o:list any.
one-argument-smaller [A | As] [AT | _] [B | As] :- candidate AT A B.
one-argument-smaller [A | As] [_ | ATs] [A | Bs] :- one-argument-smaller As ATs Bs.

% -- Equal literals shrunk together ---------------------------------------
%
% A counterexample can need two literals to stay equal: [2, 2] for a sort
% that drops an element equal to another, X = 7 and L = [7] for an
% insertion that loses X.  Shrinking one occurrence alone makes the test
% pass, so the literals that occur more than once in the values of a
% counterexample (all its variables together) are also shrunk together:
% every occurrence is replaced by the same smaller candidate.

% [together Values Values1]: Values1 is Values with every occurrence of a
% repeated literal replaced by one of its candidates
pred together i:list (option any), o:list (option any).
together Values Values1 :-
  std.fold Values [] option-occurrences Ls,
  repeated Ls L,
  literal-candidate L M,
  std.map Values (option-replace L M) Values1.

% [option-occurrences V Acc Ls]: the literals of the value V (none for a
% computed variable), then Acc
func option-occurrences option any, list any -> list any.
option-occurrences none Acc Acc.
option-occurrences (some X) Acc Ls :- occurrences X Acc Ls.

% [repeated Ls L]: L occurs at least twice in Ls (each such L once)
pred repeated i:list any, o:any.
repeated [L | Ls] L :- std.mem! Ls L.
repeated [L | Ls] M :- std.filter Ls (different L) Rest, repeated Rest M.

func different any, any.
different L X :- not (X = L).

% [literal-candidate L M]: M is a smaller literal than L, of the same type
% (a float is not shrunk together: it does not count in the weight)
pred literal-candidate i:any, o:any.
literal-candidate N M :- is_cdata N "int", !, int-candidate N M.
literal-candidate S "" :- is_cdata S "string", not (S = "").

% [option-replace L M V V1]: every occurrence of L in the value V replaced
% by M
func option-replace any, any, option any -> option any.
option-replace _ _ none none.
option-replace L M (some X) (some Y) :- replace L M X Y.

% [replace L M X Y]: Y is X with every occurrence of the literal L replaced
% by M, the variables of X kept
func replace any, any, any -> any.
replace _ _ X X :- var X, !.
replace L M X M :- is_cdata X _, X = L, !.
replace _ _ X X :- is_cdata X _, !.
replace _ _ [] [] :- !.
replace L M [H | T] [H1 | T1] :- !, replace L M H H1, replace L M T T1.
replace L M X Y :- constant X K Args, !, std.map Args (replace L M) Args1, constant Y K Args1.
replace L M X Y :- name X K Args, !, std.map Args (replace L M) Args1, name Y K Args1.
replace L M (x\ B x) (x\ C x) :- pi y\ replace L M (B y) (C y).

}

% The simply typed lambda calculus with higher-order abstract syntax:
% binders are Elpi lambdas, the typing context is made of hypotheses
% added with pi x\ of x A => ...
accumulate property.

data ty.
symb base ty.
symb arr ty -> ty -> ty.

data tm.
symb c tm.                    % a constant of type base
symb app tm -> tm -> tm.
symb lam (tm -> tm) -> tm.

% [of M T]: M has type T (both arguments are outputs: of can build terms)
pred of o:tm, o:ty.
of c base.
of (app M N) B :- of M (arr A B), of N A.
of (lam F) (arr A B) :- pi x\ of x A => of (F x) B.

% [step M N]: M reduces to N in one beta step, anywhere in the term
pred step i:tm, o:tm.
step (app (lam F) N) (F N).
step (app M N) (app M1 N) :- step M M1.
step (app M N) (app M N1) :- step N N1.
step (lam F) (lam G) :- pi x\ step (F x) (G x).

% [step-wrong M N]: step with a wrong rule: app M N reduces to M
pred step-wrong i:tm, o:tm.
step-wrong (app (lam F) N) (F N).
step-wrong (app M _) M.
step-wrong (lam F) (lam G) :- pi x\ step-wrong (F x) (G x).

% [copy M N]: N is a copy of M, rebuilt under its binders
pred copy i:tm, o:tm.
copy c c.
copy (app M N) (app M1 N1) :- copy M M1, copy N N1.
copy (lam F) (lam G) :- pi x\ copy x x => copy (F x) (G x).

% [is-closed M]: M has no free variable (other than those under its binders)
pred is-closed i:tm.
is-closed c.
is-closed (app M N) :- is-closed M, is-closed N.
is-closed (lam F) :- pi x\ is-closed x => is-closed (F x).

% Typing is preserved by reduction.  M and T are generated by solving
% of M T at random: only well-typed terms are tested.
property "preservation"
  (pi M T N\ generated-by (of M T) ==> step M N ==> of N T).

% The same with the wrong rule: false.
property "preservation-wrong"
  (pi M T N\ generated-by (of M T) ==> step-wrong M N ==> of N T).

% Substitution: F is a binder (tm -> tm), the body of a lambda.
property "substitution"
  (pi F A B N\ generated-by (of (lam F) (arr A B)) ==> generated-by (of N A) ==> of (F N) B).

% copy rebuilds the same term (a property on terms generated from their
% type, binders included).
property "copy-identity" (pi M N\ copy M N ==> N = M).

% A typing in the empty context still holds under an extra hypothesis:
% pi in the conclusion runs as in Elpi.
property "weakening"
  (pi M T\ generated-by (of M T) ==> (pi y\ of y base => of M T)).

% False: a term generated from its type need not be typable.
property "all-typable" (pi M\ is-closed M ==> of M _).

; Each test program is checked with the default settings (seed 1); its
; report must be the expected one (FILE.expected).  Update with
;   dune build @runtest --auto-promote

(rule
 (with-stdout-to rev.out
  (with-accepted-exit-codes (or 0 1)
   (run %{exe:../bin/elpi_check_main.exe} %{dep:rev.elpi}))))
(rule (alias runtest) (action (diff rev.expected rev.out)))

(rule
 (with-stdout-to sort.out
  (with-accepted-exit-codes (or 0 1)
   (run %{exe:../bin/elpi_check_main.exe} %{dep:sort.elpi}))))
(rule (alias runtest) (action (diff sort.expected sort.out)))

(rule
 (with-stdout-to stlc.out
  (with-accepted-exit-codes (or 0 1)
   (run %{exe:../bin/elpi_check_main.exe} %{dep:stlc.elpi}))))
(rule (alias runtest) (action (diff stlc.expected stlc.out)))

; The machine-readable report (-json): json.t runs elpi-check and checks
; the replay goals with elpi-debug.
(cram
 (deps %{bin:elpi-check} %{bin:elpi-debug} (glob_files *.elpi) %{project_root}/check/lib/property.elpi))

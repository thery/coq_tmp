package "select" (
    directory = "."
    version = "dev"
    description = "run_tactic_string: run an Ltac tactic given as a string"
    requires = "rocq-runtime.plugins.ltac"
    archive(byte) = "select_plugin.cma"
    archive(native) = "select_plugin.cmxa"
    plugin(byte) = "select_plugin.cma"
    plugin(native) = "select_plugin.cmxs"
)
directory = "."

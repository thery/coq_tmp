/* types.elpi: the double annotation of proofs by type expressions, after
   chapter 3 of Y. Coscoy's thesis ("Calcul des expressions de type"),
   its definitive algorithm (3.3.4, Fig. 3.9) and its text production
   (3.4.1).

   Each subproof M gets a required type Tr (the proof obligation,
   inherited from the statement, 3.3.2) and a constrained type Tc (what
   the proof proves, partly synthesised, 3.3.1).  The thesis writes this
   as the annotated term ((M : Tc) : Tr).  The text says Tc, and adds
   "that is Tr" (the thesis's "ce qui est équivalent à Tr") when the two
   differ (3.4.1; Fig. 3.11, "doubles annotations redondantes": when
   Tr = Tc only one is kept).

   The strategy is xtext-annotation (Explain.v), or the variable
   XTEXT_ANNOTATION: "all" (the texts of the earlier rounds, where "that
   is" is added at the places listed in the README) or "thesis" (this
   algorithm).  The writer (xtext.elpi) calls: thesis-mode, thesis-hook
   (in tr-p, on every subproof), thesis-lam (the abstraction rule, in
   tr-lam), thesis-top (the statement, in top-run) and add-equiv.     */


% The writer's types and predicates used here (defined in xtext.elpi,
% which is accumulated after this file)
kind line type.
type it string -> list line -> line.
kind pf type.
type prf list line -> option line -> pf.
type prfp pf -> list term -> pf.
kind part type.
type wd string -> part.
type tx string -> part.
kind binder type.
pred typ i:term, o:term.
pred beta-ty i:term, o:term.
pred is-prop i:term.
pred gr-of i:term, o:gref.
pred fm i:term, o:string.
pred fm-fact i:term, o:string.
pred say i:list part, o:string.
pred say-cap i:list part, o:string.
pred ppf i:term, o:string.
pred xtext-annotation o:string.

% ------------------------------------------------------------------
% The strategy

pred annotation o:string.
annotation S :- getenv "XTEXT_ANNOTATION" (some S), not (S = ""), !.
annotation S :- xtext-annotation S, !.
annotation "all".

pred thesis-mode.
thesis-mode :- annotation "thesis".

% ------------------------------------------------------------------
% Fig. 3.3, the weak head normal form: the fewest delta and beta
% reductions that bring a type to a product, if it has one.  Rocq's
% lazy head reduction does this (it also does iota and zeta, which the
% calculus of constructions of the thesis does not have).
pred whnf i:term, o:term.
whnf T W :- coq.reduction.lazy.whd T W.

% Fig. 3.4, the synthesis of types: xtext's typ follows its rules (Var
% and Const: the declared type; Abs: the product of the binder over the
% type of the body; App: the head's type in whnf, instantiated), then
% beta-normalises for printing (end of 3.2.4).
pred synth i:term, o:term.
synth M T :- typ M T.

% Syntactic equality of type expressions (the condition Tr = T of Fig.
% 3.11), up to the names of bound variables and beta-reduction (the
% thesis presents types beta-normalised, 3.2.4).
pred same-ty i:term, i:term.
same-ty A B :- norm-ty A A1, norm-ty B B1, A1 = B1, !.
% (terms that differ only in what the printer does not show, e.g. universe
% instances, print the same: the reader sees one formula)
same-ty A B :- beta-ty A A1, beta-ty B B1, ppf A1 S, ppf B1 S.

pred norm-ty i:term, o:term.
norm-ty A B :- beta-ty A A1, flat-app A1 B.

% nested applications (app [app L1 | L2]), left by substitution, flattened
pred flat-app i:term, o:term.
flat-app A B :-
  (pi L1 L2 R\ copy (app [app L1 | L2]) R :- !,
     std.append L1 L2 L3, copy (app L3) R) => copy A B.

% ------------------------------------------------------------------
% Fig. 3.9, the double computation of types: Γ; Tr ⊢ M ↪ ((M:Tc):Tr).
% [d-annot Tr M Tc Subs]: the constrained type Tc of M, and the required
% types of its immediate subproofs (sub M' Tr').  The rule (Abs), whose
% subproof is under the binder, is d-abs.  Γ is Elpi's context (decl).

kind sub type.
type sub term -> term -> sub.

pred d-annot i:term, i:term, o:term, o:list sub.
% (Var)   (x:Tc) ∈ Γ  ⊢  Γ; Tr ⊢ x ↪ ((x:Tc):Tr)
d-annot _Tr X Tc [] :- name X, !, synth X Tc.
% (Const) (C:Tc) ∈ Γ  ⊢  Γ; Tr ⊢ C ↪ ((C:Tc):Tr)
d-annot _Tr C Tc [] :- gr-of C GR, !, coq.env.typeof GR Tc0, beta-ty Tc0 Tc.
% (App1)  Γ ⊢ M0 :s T0   Γ ⊢ T0 ▷whnf Πx:T1.T2   Γ, Πx:T1.T2 ⊢ M0 ↪ N0
%         Γ ⊢ T1 : Prop   Γ, T1 ⊢ M1 ↪ N1
%   ⊢  Γ; Tr ⊢ (M0 M1) ↪ (((N0 N1) : T2{x/M1}) : Tr)
d-annot _Tr (app L) Tc [sub M0 R0, sub M1 T1b] :-
  app-split L M0 M1, synth M0 T0, whnf T0 (prod N T1 T2),
  is-prop T1, !,
  beta-ty (T2 M1) Tc, beta-ty (prod N T1 T2) R0, beta-ty T1 T1b.
% (App2)  the same when Γ ⊢ T1 : s, s ≠ Prop: the argument is not a
%   proof and is not annotated further
%   ⊢  Γ; Tr ⊢ (M0 M1) ↪ (((N0 (M1 : T1)) : T2{x/M1}) : Tr)
% (Fig. 3.9 writes (M1 : s) and Πx:s.T2, Fig. 3.6 (M1 : T1) and Πx:T1.T2;
% the argument is shown, not annotated, in both readings)
d-annot _Tr (app L) Tc [sub M0 R0] :-
  app-split L M0 M1, synth M0 T0, whnf T0 (prod N T1 T2), !,
  beta-ty (T2 M1) Tc, beta-ty (prod N T1 T2) R0.

% (Abs)   Γ ⊢ Tr ▷whnf Πx:T0'.T1   (x:T0) + Γ; T1 ⊢ M ↪ N
%   ⊢  Γ; Tr ⊢ λx:T0.M ↪ (((λx:T0.N) : Πx:T0.T1) : Tr)
% [d-abs Tr N T0 Tc T1]: the constrained type Πx:T0.T1 (T0 from the
% binder, T1 from the required type) and the required type T1 of the body
pred d-abs i:term, i:name, i:term, o:term, o:(term -> term).
d-abs Tr N T0 (prod N T0 T1) T1 :- whnf Tr (prod _ _ T1).

% (M0 M1): the application L, its last argument taken apart
pred app-split i:list term, o:term, o:term.
app-split L M0 M1 :- std.last L M1, std.drop-last 1 L L0,
  (if (L0 = [M0]) true (M0 = app L0)).

% the required types of the subproofs of M, following the applications
% (the head and the partial applications are subproofs too, App1/App2)
pred subs-of i:term, i:term, o:list sub.
subs-of M Tr Subs :- d-annot Tr M _ S1, !,
  std.map S1 (s\ l\ sigma M1 R1\ s = sub M1 R1,
    if (not (var M1), M1 = app _) (subs-of M1 R1 l) (l = [])) S2,
  std.flatten [S1 | S2] Subs.
subs-of _ _ [].

% ------------------------------------------------------------------
% The required types, as the writer goes down the proof: [req M Tr] is
% assumed for the subproofs of the node being translated.
pred req o:term, o:term.
pred required i:term, o:term.
required T Tr :- req K Tr0, K == T, !, Tr = Tr0.

pred sub->req i:sub, o:prop.
sub->req (sub M Tr) (req M Tr).

% G, with the required types Subs assumed
pred with-reqs i:list sub, i:prop.
with-reqs [] G :- G.
with-reqs [sub M Tr | Subs] G :- req M Tr => with-reqs Subs G.

pred in-hook o:term.

% [thesis-hook T G P]: the text P of the subproof T, whose required type
% is known: G is translated with the required types of T's subproofs,
% then its conclusion says Tc, "that is" Tr if they differ.  An
% abstraction says it itself (thesis-lam).
pred thesis-hook i:term, i:(pf -> prop), o:pf.
thesis-hook T G P :- thesis-mode, not (var T), not (in-hook K, K == T),
  % (no required type: the parent is a form that Fig. 3.9 does not treat,
  % let, match, fix or a cast; the annotation starts again from the
  % synthesised type, Fig. 3.4)
  (required T Tr ; synth T Tr), !,
  subs-of T Tr Subs, with-reqs Subs (in-hook T => G P0),
  (if (T = fun _ _ _) (P = P0) (synth T Tc, add-equiv Tc Tr P0 P)).

% the conclusion of P says Tc; if Tr differs, it also says "that is Tr"
% (3.4.1: the constrained type first, as it is closer to the proof)
pred add-equiv i:term, i:term, i:pf, o:pf.
add-equiv Tc Tr (prfp P Ps) Q :- !, add-equiv Tc Tr P P1,
  (if (P1 = P) (Q = prfp P Ps) (Q = P1)).
add-equiv Tc Tr (prf L (some (it S Ch))) (prf L (some (it S1 Ch))) :-
  not (same-ty Tc Tr), !,
  beta-ty Tr Tr1, fm-fact Tr1 F, say-cap [tx S, tx ",", wd "that-is", tx F] S1.
add-equiv _ _ P P.

% the formula of a conclusion: Tc, then "that is Tr" if they differ
pred equiv-text i:term, i:term, o:string.
equiv-text Tc Tr S :- same-ty Tc Tr, !, fm Tc S.
equiv-text Tc Tr S :- fm Tc F1, beta-ty Tr Tr1, fm-fact Tr1 F2,
  say [tx F1, tx ",", wd "that-is", tx F2] S.

% ------------------------------------------------------------------
% (Abs) on a series of abstractions (the iterated rule of the paper).
% The weak contraction of abstractions (Fig. 3.11) drops the annotation
% of an inner abstraction only when it is single (Tc = Tr): the series
% stops at an abstraction whose annotation is double, which starts its
% own series.
% [thesis-lam T Tr]: the required type of the abstraction T is Tr.
pred thesis-lam i:term, o:term.
thesis-lam T Tr :- thesis-mode, required T Tr.

% [abs-step Tr N A Tc T1]: (Abs) on λN:A, with required type Tr
pred abs-step i:term, i:name, i:term, o:term, o:(term -> term).
abs-step Tr N A Tc T1 :- d-abs Tr N A Tc T1.

% the inner abstraction λN:A with required type Tr may join the series
pred abs-single i:term, i:name, i:term.
abs-single Tr N A :- d-abs Tr N A Tc _, same-ty Tc Tr.

% ------------------------------------------------------------------
% The statement (top-run): the binders at the top of the proof are
% followed along the declared type by (Abs).  The statement stops at the
% first abstraction whose annotation is double: it is then a step of the
% proof, so that its conversion is said ("We have proved Tc, that is Tr").
pred thesis-top-stop i:term, i:name, i:term.
thesis-top-stop Ty N A :- thesis-mode, not (abs-single Ty N A).

% [lam-join Acc T]: the abstraction T continues the series Acc (in the
% thesis mode, only if its annotation is single)
pred lam-join i:list binder, i:term.
lam-join _ _ :- not (thesis-mode), !.
lam-join [] _ :- !.
lam-join _ (fun N A _ as T) :- required T Tr, !, abs-single Tr N A.
lam-join _ _.

% [lam-under T x Cls]: under the binder x of the abstraction T, the
% required type of its body (rule Abs)
pred lam-under i:term, i:term, o:list prop.
lam-under (fun N A F as T) X [req (F X) (T1 X)] :- thesis-mode,
  required T Tr, d-abs Tr N A _ T1, !.
lam-under _ _ [].

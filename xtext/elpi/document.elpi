% xtext: The top level: the statement, the header, the document.
% (part of xtext's writer; the files are loaded in the order of Explain.v)

% ------------------------------------------------------------------
% Top level: the abstractions at the top of the proof make the
% statement (the * context of the paper, where the theorem is
% announced); the rest is the proof.

% The declared type of the theorem is followed along the abstractions:
% what is left is the statement, inherited by the body (thesis 3.3.2).
pred top-run i:list binder, i:term, i:term, o:string, o:list line.
top-run Acc (fun N A F) Ty Stmt L :- not (statement-stops-at Ty N A), !,
  binder-kind A K, binder-name N N1 Id,
  ppf A FA,
  (if (Ty = prod _ _ B) true (whnf Ty (prod _ _ B) ; B = (_\ Ty))),
  pi x\ (decl x N1 A, ctx-name Id) => top-run [b K Id FA|Acc] (F x) (B x) Stmt L.
top-run Acc Body Ty0 Stmt L :-
  std.rev Acc Bs, beta-ty Ty0 Ty, fm Ty FT,
  statement Bs Ss, say-cap [wd "we-prove", tx FT, tx "."] WP, std.append Ss [WP] Ss1,
  std.string.concat " " Ss1 Stmt,
  (if (staged-mode)
     % (thesis 3.3.4: the body has the statement as required type; an
     % abstraction left out of the statement says its conversion)
     ((if (Body = fun _ _ _) (Ctx = nostar) (Ctx = star)),
      (req Body Ty => (root-term Body :- !) => tr-root Body Ctx [] P))
     (((root-term Body :- !) => tr-root Body star [] P0), that-is Body Ty P0 P)),
  flatten P L.

% "that is" (the Cast' of the thesis, 5.2.2): when the type that a proof
% proves (synthesised) differs from the type expected at its place
% (inherited) but Rocq finds them convertible, its conclusion says both

that-is T Exp (prfp P Ps) Q :- !, that-is T Exp P P1,
  (if (P1 = P) (Q = prfp P Ps) (Q = P1)).
that-is T Exp (prf L (some (it S Ch))) (prf L (some (it S1 Ch))) :-
  not (off "thatis"), typ T Syn, not (Syn = Exp), coq.unify-eq Syn Exp ok, !,
  % the second form is shown, not claimed: Rocq checked the conversion,
  % and the step's justification is about the first form
  fm-fact Exp F, say-cap [tx S, tx ",", wd "that-is", tx F] S1.
that-is _ _ P P.

% the expected types of the arguments As of a term of type Ty

domains _ [] [] :- !.
domains (prod _ D B) [A|As] [D1|Ds] :- !, beta-ty D D1, domains (B A) As Ds.
domains Ty As Ds :- whnf Ty (prod N D B), !, domains (prod N D B) As Ds.
domains _ As Ds :- std.map As (_\ d\ true) Ds.

% subproofs as dashed lines, each with its expected type

dashed-exp [] _ _ [].
dashed-exp [T|Ts] Es Path [D|Ds] :-
  (if (Es = [E|Er]) true (Er = [])),
  tr T nostar Path P0,
  (if (ground_term E) (that-is T E P0 P) (P = P0)),
  dashed P D, dashed-exp Ts Er Path Ds.


statement [] [].
statement [b bk-assume Id FA|Bs] [S|Ss] :- !,
  assume-run [b bk-assume Id FA|Bs] Hs Rest,
  and-parts Hs HP, say-cap {std.append [wd "assume" | HP] [tx "."]} S,
  statement Rest Ss.
statement Bs [S|Ss] :-
  let-run Bs Ls Rest, let-lines Ls Lines,
  std.map Lines (l\ s\ sigma T\ l = it T [], s is T ^ ".") L,
  std.string.concat " " L S,
  statement Rest Ss.

pred assume-run i:list binder, o:list (list part), o:list binder.
assume-run [b bk-assume Id FA|Bs] [H|Hs] Rest :- !,
  assume-text (b bk-assume Id FA) H, assume-run Bs Hs Rest.
assume-run Bs [] Bs.

pred let-run i:list binder, o:list binder, o:list binder.
let-run [b bk-assume Id FA|Bs] [] [b bk-assume Id FA|Bs] :- !.
let-run [B|Bs] [B|Ls] Rest :- !, let-run Bs Ls Rest.
let-run [] [] [].

pred render i:string, i:list line, o:list string.
render _ [] [].
render I [it S Ch|L] Out :-
  end-dot S S1, Line is I ^ "- " ^ S1,
  I2 is I ^ "  ", render I2 Ch O1, render I L O2,
  std.append [Line|O1] O2 Out.

pred end-dot i:string, o:string.
end-dot S S :- rex.match "^.*[:.,]$" S, !.
end-dot S S1 :- S1 is S ^ ".".

% the cyp header; the file that defines the theorem is required too, so
% that the lemmas it uses are known to cyp

header GR H :- coq.gref->path GR Path, header-path Path H.

pred header-path i:list string, o:string.
header-path Path H :-
  (if (Path = [Lib|_], (Lib = "Stdlib" ; Lib = "Corelib"))
      (Req = "")
      (std.string.concat "." Path Mod, Req is " Require Import " ^ Mod ^ ".")),
  R is "require: From Stdlib Require Import Arith Lia List Bool. Import ListNotations." ^ Req,
  writer-lang Lg, (if (Lg = "en") (Ls = []) (Ls = [{calc ("lang: " ^ Lg)}])),
  std.string.concat "\n" {std.append ["---", R | Ls] [
    "by: tauto | congruence | lia | firstorder | auto",
    "---" ]} H.

% the text of a proof in progress (Explain_partial): its partial proof
% term P, where the open goals are holes (thesis of L. Théry, 3.3.3)
pred explain-partial i:string, i:term, o:string.
explain-partial Name P Text :-
  beta P P1, coq.typecheck P Ty0 ok, beta-ty Ty0 Ty,
  top-run [] P1 Ty Stmt L, render "" L Lines,
  coq.env.current-path Path, header-path Path Hd,
  Title is "# " ^ Name ^ " (proof in progress)",
  std.append [Hd, "", Title, "", Stmt, ""] Lines All,
  std.string.concat "\n" All Text0, Text is Text0 ^ "\n".

pred explain i:string, o:string.
explain Name Text :-
  coq.locate Name GR,
  ((GR = const C, coq.env.const-body C (some Bo)), !
   ; coq.error "xtext:" Name "is not a constant with a body"),
  % the beta-redexes left by tactics (intro patterns) are reduced first
  beta Bo Bo1,
  coq.env.const C _ CTy,
  top-run [] Bo1 CTy Stmt L, render "" L Lines,
  header GR Hd,
  Title is "# " ^ Name,
  std.append [Hd, "", Title, "", Stmt, ""] Lines All,
  std.string.concat "\n" All Text0, Text is Text0 ^ "\n".

% The vocabulary of the writer in language L (the lexicon): every use of
% English has a phrase in L, and every phrase of a role is in lower case
% (as the phrases of the lexicon are matched).  The failures are in Bad.
pred vocab-check i:string, o:list string.
vocab-check L Bad :-
  std.findall (write-role L _ _ _) Rs,
  std.map-filter Rs (r\ m\ sigma U P\ r = write-role L U P _,
     not (lower P P), m is "phrase \"" ^ P ^ "\" (" ^ U ^ ") not in lower case") B1,
  std.findall (write-role "en" _ _ _) Re, std.findall (write-word "en" _ _) We,
  std.map Re (r\ u\ sigma P R\ r = write-role "en" u P R) U1,
  std.map We (r\ u\ sigma P\ r = write-word "en" u P) U2,
  std.append U1 U2 Us,
  std.map-filter Us (u\ m\ not (write-role L u _ _ ; write-word L u _),
     m is "no phrase for " ^ u) B2,
  std.append B1 B2 Bad.

% xtext: The structure of a text: lines with sub-lines, the text of a proof,
% the kinds of binders and arguments, the * context.
% (part of xtext's writer; the files are loaded in the order of ExtractText.v)

% ------------------------------------------------------------------
% Text

% a line of text, with its indented sub-lines: a node of the proof (a list
% item; README of prooftext, "The format"), or a remark when its text has
% no tag
kind line type.
type it string -> list line -> line.
% a node in the forward style of the 2003 paper: its opening text, its
% sub-lines, then its closing paragraph, which holds its conclusion ("We
% prove `G` by induction on n: - Case 1 ... - Case 2 ...  These cases
% being exhaustive, we deduce `G`{.claim}.")
type with-closing string -> list line -> string -> line.

% the text of a proof: the lines above its conclusion, and the
% conclusion (none in the * context of the paper)
kind pf type.
type prf list line -> option line -> pf.
% an application step (modus ponens or specialisation), which can be
% contracted into the step that uses it: its text, and the types that
% its premise lines prove
type prfp pf -> list term -> pf.

% the kind of a lambda binder: its type is in Type, in Prop, or in Set
kind bk type.
type bk-let, bk-assume, bk-set bk.

% the kind of an argument: specialisation (forall) or modus ponens (=>)
kind ak type.
type ak-all, ak-imp ak.

% the * context: forget the conclusions of a series of abstractions
kind ctx type.
type star, nostar ctx.

% a binder of a lambda series: kind, name, printed type
kind binder type.
type b bk -> string -> string -> binder.
type bih string -> string -> binder.  % an induction hypothesis

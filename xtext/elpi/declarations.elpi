% xtext: the declarations of the predicates that one file of the writer
% uses and a later file defines (Elpi checks the files in order).

% defined in abstractions.elpi, used in transducer.elpi
pred tr-lam i:term, i:ctx, i:list int, o:pf.

% defined in abstractions.elpi, used in transducer.elpi
pred tr-let i:bool, i:name, i:term, i:term, i:(term -> term), i:ctx, i:list int, o:pf.

% defined in applications.elpi, used in transducer.elpi
pred tr-app i:term, i:list term, i:list int, o:pf.

% defined in inductive-text.elpi, used in applications.elpi
pred tr-intro i:list part, i:string, i:term, i:list term, i:list term, i:list int, o:pf.

% defined in inductive-text.elpi, used in applications.elpi
pred tr-elim1 i:string, i:string, i:term, i:term, i:list term, i:list case-info, i:list int, o:pf.

% defined in inductive-text.elpi, used in applications.elpi
pred tr-elim2 i:string, i:string, i:term, i:option term, i:option term, i:list term, i:list case-info, i:list int, o:pf.

% defined in inductive-text.elpi, used in applications.elpi
pred elim-app o:string, o:string.

% defined in inductive-text.elpi, used in transducer.elpi
pred tr-match i:term, i:term, i:list term, i:list int, o:pf.

% defined in inductive-text.elpi, used in transducer.elpi
pred tr-fix i:name, i:int, i:term, i:(term -> term), i:list int, o:pf.

% defined in inductive-text.elpi, used in applications.elpi
pred tr-rewrite i:string, i:string, i:term, i:term, i:term, i:list int, o:pf.

% defined in type-expressions.elpi, used in document.elpi: the type the
% body M of the proof is required to prove ([req M Tr], thesis 3.3.2)
pred req o:term, o:term.

% defined in staged.elpi, used in transducer.elpi and document.elpi: the
% staged translation is on, the terms the direct writer keeps, the text
% the staged translation gives, and where the statement stops
pred staged-mode.
pred is-direct-only i:term.
pred staged-text i:term, i:ctx, i:list int, o:pf.
pred statement-stops-at i:term, i:name, i:term.

% Building sentences.  A sentence is a list of parts (kind part, the writer:
% [wd Use] a word of the language of the text, [tx S] text as it is); this
% file adds the parts that the writer would otherwise build by hand, and
% [say]/[say-cap] (the writer) turn a list of parts into a string.

% a formula, from its term, with its role for cyp: `F`{.claim}
type fml role -> term -> part.
% a formula already printed, with its role: `x y : E`{.var}
type fmls role -> string -> part.
% a name (of a hypothesis, a constant, ...), as it is
type nm string -> part.
% an enumeration, "A, B and C", each element a list of parts
type enum list (list part) -> part.

part-text (fml R T) S :- formula R T S.
part-text (fmls R S0) S :- prooftext.formula R S0 S.
part-text (nm N) N.
part-text (enum Ls) S :- enum-parts Ls Ps, say Ps S.

% "A", "A and B", "A, B and C"
pred enum-parts i:list (list part), o:list part.
enum-parts [] [].
enum-parts [L] L :- !.
enum-parts [L1, L2] Ps :- !, std.append L1 [wd "and" | L2] Ps.
enum-parts [L | Ls] Ps :- enum-parts Ls Ps1, std.append L [tx "," | Ps1] Ps.

% the parts Ls, with the parts Sep between two of them
pred joined i:list part, i:list (list part), o:list part.
joined _ [] [].
joined _ [L] L :- !.
joined Sep [L | Ls] Ps :- joined Sep Ls Ps1, std.append L Sep L1, std.append L1 Ps1 Ps.

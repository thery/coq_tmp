% xtext: Words and sentences in the language of the text (from the lexicon).
% (part of xtext's writer; the files are loaded in the order of ExtractText.v)

% ------------------------------------------------------------------
% Words.  The writer takes its phrases from the lexicon
% (../lexicon/lang_*.elpi): [write-role Lang Use Phrase Role], a
% phrase that gives the role of the formula after it, which is also a
% phrase of the reading table [phrase], and [write-word Lang Use Words] for the
% other words.  A sentence is a list of parts: [wd Use], the phrase of a
% use in the language of the text, and [tx S], text as it is (formulas,
% names, punctuation).  The language is the switch "lang" (switches.elpi).
kind part type.
type wd string -> part.
type tx string -> part.
% a formula, from its term, with its role for cyp: `F`{.claim}
type fml role -> term -> part.
% a formula, from its term, with no role: `F`, shown and not used by cyp
% (a witness, the object of an induction, the first form of "A, that is
% B")
type untagged term -> part.
% a name (of a hypothesis, a constant, ...), as it is
type nm string -> part.
% a justification, written where the sentence names it: the name of a
% hypothesis, a lemma, a constructor or a tactic, *h4*{.just}
type jst string -> part.
% an enumeration, "A, B and C", each element a list of parts
type enum list (list part) -> part.

pred word i:string, o:string.
word U S :- switch "lang" L, (write-role L U S _ ; write-word L U S), !.
word U _ :- switch "lang" L, coq.error "xtext: no phrase for" U "in the vocabulary of" L.

% [text-of-parts Parts S]: the parts joined by spaces, none before , . : ; ) nor
% after (, empty parts left out
pred text-of-parts i:list part, o:string.
text-of-parts Ps0 S :- place Ps0 Ps, std.map Ps part-text Ss0, std.filter Ss0 (x\ not (x = "")) Ss, join-words Ss S.

% [sentence Parts S]: the same, at the start of a sentence: capitalised when
% it starts with a phrase (not with a name or a formula, after the
% placement of the phrases)
pred sentence i:list part, o:string.
sentence Ps S :- text-of-parts Ps S0, place Ps [P | _], !,
  (if (P = wd _) (capitalised S0 S) (S = S0)).
sentence _ "".

% A phrase that stands after its formula (lexicon: phrase-after) is put
% after the parts that follow it, up to the next phrase of a role, the next
% punctuation mark , . : ; outside parentheses, or the justification:
% [wd "assume", tx A, tx "(", tx "h", tx ")", wd "and", tx B] becomes, in
% Korean, A (h) 그리고 B 라고 가정하자 ("and" is not a phrase that gives a
% role, so the scope goes on after it; it ends at a phrase of a role).
pred place i:list part, o:list part.
place [] [].
place [wd U | Ps] Out :- after-use U, !,
  scope Ps 0 In Rest, place In In1, place Rest Rest1,
  std.append In1 [wd U | Rest1] Out.
place [P | Ps] [P | Qs] :- place Ps Qs.

pred after-use i:string.
after-use U :- switch "lang" L, word U S, phrase-after L S.

% [scope Parts Depth In Rest]: the parts in the scope of an after-phrase
pred scope i:list part, i:int, o:list part, o:list part.
scope [] _ [] [].
scope [P | Ps] 0 [] [P | Ps] :- scope-end P, !.
scope [tx "(" | Ps] D [tx "(" | In] Rest :- !, D1 is D + 1, scope Ps D1 In Rest.
scope [tx ")" | Ps] D [tx ")" | In] Rest :- D > 0, !, D1 is D - 1, scope Ps D1 In Rest.
scope [P | Ps] D [P | In] Rest :- scope Ps D In Rest.

pred scope-end i:part.
scope-end (wd U) :- switch "lang" L, write-role L U _ _.
scope-end (tx S) :- std.mem! [",", ".", ":", ";"] S.

pred part-text i:part, o:string.
part-text (wd U) S :- word U S.
part-text (tx S) S.
part-text (fml R T) S :- formula R T S.
part-text (untagged T) S :- ppf T F, prooftext.untagged-formula F S.
part-text (nm N) N.
part-text (jst N) S :- prooftext.justification-name N S.
part-text (enum Ls) S :- enumeration Ls Ps, text-of-parts Ps S.

pred join-words i:list string, o:string.
join-words [] "".
join-words [S] S :- !.
join-words [A, B | L] S :-
  (if (rex.match "^[,.:;)]" B ; rex.match ".*($" A) (Sp = "") (Sp = " ")),
  A1 is A ^ Sp ^ B, join-words [A1 | L] S.

% [with-name X N Ps]: the text X followed by the name N in parentheses: a
% hypothesis and its name, `A`{.hyp} (h), an inductive type and its rule,
% or (or_ind)
pred with-name i:string, i:string, o:list part.
with-name X N [tx X, tx "(", tx N, tx ")"].

% [enumeration Ls Ps]: the lists of parts Ls as an enumeration: "A", "A and
% B", "A, B and C"
pred enumeration i:list (list part), o:list part.
enumeration [] [].
enumeration [L] L :- !.
enumeration [L1, L2] Ps :- !, std.append L1 [wd "and" | L2] Ps.
enumeration [L | Ls] Ps :- enumeration Ls Ps1, std.append L [tx "," | Ps1] Ps.

% [separated Sep Ls Ps]: the lists of parts Ls, with the parts Sep between
% two of them
pred separated i:list part, i:list (list part), o:list part.
separated _ [] [].
separated _ [L] L :- !.
separated Sep [L | Ls] Ps :- separated Sep Ls Ps1, std.append L Sep L1, std.append L1 Ps1 Ps.

% [end-dot S S1]: the text S ending with a punctuation mark (a period
% added if it has none)
pred end-dot i:string, o:string.
end-dot S S :- rex.match "^.*[:.,]$" S, !.
end-dot S S1 :- S1 is S ^ ".".

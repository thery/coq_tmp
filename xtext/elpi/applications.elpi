% xtext: Applications: specialisations and modus ponens, and the contraction of
% their steps.
% (part of xtext's writer; the files are loaded in the order of Explain.v)


% rewriting with an equality (eq_ind, eq_ind_r, ...)
tr-app H Args Path P :-
  rewrite-info H Dir, std.length Args L, L >= 6, !,
  std.split-at 6 Args Cons Rest, Cons = [_, _, _, PX, _, E],
  coq.mk-app H Cons T0, typ T0 Tau, head-name H RN,
  tr-rewrite RN Dir Tau PX E Path P0,
  apply-rest T0 P0 Rest Path P.
% elimination theorems
tr-app H Args Path P :-
  elim-info H I Kind NC Ks Fls, std.length Args L, L >= NC, !,
  std.split-at NC Args Cons Rest,
  coq.mk-app H Cons T0, typ T0 Tau, ind-name I C, head-name H EN,
  branch-infos Ks Fls Cis0,
  % the full name of the theorem, for the justification of the closing step
  gr-of H GRE, qual-name GRE QE,
  ((elim-app EN QE :- !) =>
  (if (Kind = 1)
      (imp-args Ks Cons Imps, std.last Imps Maj, std.drop-last 1 Imps Ns,
       std.drop-last 1 Cis0 Cis,
       tr-elim1 C EN Tau Maj Ns Cis Path P0)
      (imp-args Ks Cons Ns, Cis = Cis0,
       (if (Rest = [_|_]) (typ (app [H|Args]) TF, Fin = some TF) (Fin = none)),
       tr-elim2 C EN Tau Fin none Ns Cis Path P0))),
  apply-rest T0 P0 Rest Path P.
% introduction theorems
tr-app H Args Path P :-
  intro-info H I NC, std.length Args L, L >= NC, !,
  std.split-at NC Args Cons Rest,
  coq.mk-app H Cons T0, typ T0 Tau, ind-name I C, typ H TyH,
  kinds TyH Cons Ks, imp-args Ks Cons Ns,
  domains TyH Cons Es0, imp-args Ks Es0 Es,
  head-name H K, gr-of H (indc KC), coq.env.indc KC NP _ _ _,
  % the arguments that are not parameters nor premises are witnesses
  std.drop NP Cons Ws0, std.drop NP Ks KWs,
  witnesses KWs Ws0 Ws,
  (if (Ws = []) (WP = [])
      (std.map Ws fm-fact FWs, std.map FWs (f\ p\ p = [tx f]) FWs1,
       sep-parts [tx ","] FWs1 WP0, WP = [wd "witness" | WP0])),
  CD = [tx C, tx "(", tx K, tx ")" | WP],
  qual-name (indc KC) QK, tr-intro CD QK Tau Ns Es Path P0,
  apply-rest T0 P0 Rest Path P.
tr-app H [] _ P :- name H, rec-var H, !,
  var-name H N, typ H Tau, fm Tau F,
  say-cap [wd "ih", tx "(", wd "recursive-call", tx N, tx ")", wd "have", tx F] S,
  one S P.
tr-app H [] _ P :- name H, !,
  var-name H N, typ H Tau, fm Tau F,
  say-cap [wd "by", tx N, wd "have", tx F] S, one S P.
tr-app H [] _ P :- gr-of H GR, !,
  coq.gref->id GR N, typ H Tau, fm Tau F, qual-name GR Q,
  by-part Q BJ, say-cap [wd "using", tx N, wd "get", tx F, BJ] S, one S P.

% the full name of a global reference, usable when its module is loaded
% but not imported
pred qual-name i:gref, o:string.
qual-name GR Q :- coq.gref->path GR P, coq.gref->id GR Id,
  std.append P [Id] L, std.string.concat "." L Q.
tr-app H Args Path P :-
  (if (is-sym H) (tr-app H [] Path P0) (tr-p H nostar Path P0)),
  apply-rest H P0 Args Path P.

pred dashed-all i:list term, i:list int, o:list line.
dashed-all Ts Path Ds :-
  std.map Ts (t\ d\ sigma P\ tr t nostar Path P, dashed P d) Ds.

% iterated application: the arguments of T0 (whose text is P0) are
% split into maximal runs of the same kind
pred apply-rest i:term, i:pf, i:list term, i:list int, o:pf.
apply-rest _ P0 [] _ P0 :- !.
% Arguments that can be inferred (thesis 5.4, the extended App): a run
% of specialisations followed by a run of premises is written as one
% step when the specialised arguments, left as holes, are found again
% by elaborating the application against its type.
apply-rest T0 P00 Args Path P :-
  typ T0 Ty0, kinds Ty0 Args Ks, run Ks Args ak-all Run Rest,
  not (off "args"), Rest = [_|_], head-unfold T0 Ty0 P00 P0,
  std.length Run NR, std.drop NR Ks Ks2, run Ks2 Rest ak-imp Run2 Rest2,
  coq.mk-app T0 Run T1, coq.mk-app T1 Run2 T2,
  inferable T0 Run Run2 T2, !,
  typ T1 Ty1, domains Ty1 Run2 Es,
  typ T2 Tau2,
  % (P0 is the text of T0: its line claims the type of T0)
  mp-step Run2 Es T0 P0 Tau2 Path P2,
  apply-rest T2 P2 Rest2 Path P.
apply-rest T0 P00 Args Path P :-
  typ T0 Ty0, kinds Ty0 Args Ks, run Ks Args K Run Rest, head-unfold T0 Ty0 P00 P0,
  coq.mk-app T0 Run T1, typ T1 Tau1,
  domains Ty0 Run Es,
  apply-run K Run Es T0 P0 Tau1 Path P1,
  apply-rest T1 P1 Rest Path P.

% a function whose type is a product only after unfolding: its
% conclusion says the unfolded type ("that is")
pred head-unfold i:term, i:term, i:pf, o:pf.
% (double annotation, rule App: the partial applications and the variables and
% constants at the head, whose text does not go through annotation-hook)
head-unfold T0 Ty0 P0 P :- double-annotation-mode, !,
  (if ((T0 = app _ ; is-sym T0), whnf Ty0 W, W = prod _ _ _)
      (beta-ty W W1, add-equiv Ty0 W1 P0 P) (P = P0)).
head-unfold _ (prod _ _ _) P P :- !.
head-unfold T0 Ty0 P0 P :- coq.reduction.lazy.whd Ty0 W, W = prod _ _ _, !,
  beta-ty W W1, that-is T0 W1 P0 P.
head-unfold _ _ P P.

% the arguments Run of T0 can be left out of T0 Run Run2 (of type T2's)
pred inferable i:term, i:list term, i:list term, i:term.
inferable T0 Run Run2 T2 :-
  std.map Run (_\ h\ true) Hs, coq.mk-app T0 Hs T0h, coq.mk-app T0h Run2 Sk,
  typ T2 Ty, coq.elaborate-skeleton Sk Ty T3 ok, ground_term T3,
  coq.unify-eq T3 T2 ok.

pred apply-run i:ak, i:list term, i:list term, i:term, i:pf, i:term, i:list int, o:pf.
apply-run ak-all _ _ T0 P0 Tau _ (prfp (prf L (some (it S []))) [Ty0]) :-
  flatten P0 L, fm Tau F, say-cap [wd "particular", tx F] S, typ T0 Ty0.
apply-run ak-imp Run Es T0 P0 Tau Path P :- mp-step Run Es T0 P0 Tau Path P.

% --- Contraction (thesis 3.4.2, "contraction gardée", Fig. 3.11-3.13).
% A modus ponens step: premises N1 .. Nk and the function (text P0),
% conclusion Tau.  A premise that is itself an application step, used
% here only, can be contracted: its own premises take its place, and its
% conclusion disappears.  Strategy (xtext-contraction, or the variable
% XTEXT_CONTRACTION): none; maximal (every such premise); guarded (a
% premise is contracted only if Tau still follows from the premises, as
% checked by one of the tactics of xtext-guard-tactic, and if its line
% does not say "that is", i.e. no conversion step is hidden).
kind cand type.
type cand line -> list line -> list term -> term -> bool -> cand.
% (its line, its premise lines, their types, its type, contractible)

pred mp-step i:list term, i:list term, i:term, i:pf, i:term, i:list int, o:pf.
mp-step Run Es T0 P0 Tau Path (prfp (prf L (some (it S []))) Tys) :-
  premise-cands Run Es Path Cs0,
  typ T0 Ty0, cand-of P0 Ty0 C0, std.append Cs0 [C0] Cs,
  contraction Strat, contract Strat Cs Tau L Tys By,
  fm Tau F, by-part By J, say-cap [wd "deduce", tx F, J] S.

% the candidates of the premises (with their expected types)
pred premise-cands i:list term, i:list term, i:list int, o:list cand.
premise-cands [] _ _ [].
premise-cands [T|Ts] Es Path [C|Cs] :-
  (if (Es = [E|Er]) true (Er = [])),
  tr-p T nostar Path P0, typ T Ty,
  (if (ground_term E) (that-is T E P0 P) (P = P0)),
  cand-of P Ty C, premise-cands Ts Er Path Cs.

pred cand-of i:pf, i:term, o:cand.
cand-of (prfp (prf L (some (it S Ch))) Tys) Ty (cand D Lift Tys Ty tt) :- !,
  dashed (prf L (some (it S Ch))) D, std.append L Ch Lift.
cand-of P Ty (cand D [] [] Ty ff) :- dashed P D.

pred contraction o:string.
contraction S :- getenv "XTEXT_CONTRACTION" (some S), !.
contraction S :- xtext-contraction S, !.

% [contract Strat Cs Tau L Tys]: the lines L of the step and the types
% Tys they prove, after contracting some of the candidates Cs
% By: the justification of the step after a guarded contraction (the
% tactic that closed the last accepted configuration), "" otherwise
pred contract i:string, i:list cand, i:term, o:list line, o:list term, o:string.
contract Strat Cs Tau L Tys By :-
  std.map Cs (c\ b\ b = ff) Dec0,
  decide Strat Cs Tau 0 Dec0 "" Dec By,
  lines-of Cs Dec L Tys.

pred decide i:string, i:list cand, i:term, i:int, i:list bool, i:string, o:list bool, o:string.
decide _ Cs _ I D B D B :- std.length Cs N, I >= N, !.
decide Strat Cs Tau I D0 B0 D B :-
  std.nth I Cs (cand _ _ _ _ Ok),
  (if (Ok = tt, contract-ok Strat Cs Tau I D0 B1) (set-nth I D0 tt D1, B2 = B1) (D1 = D0, B2 = B0)),
  I1 is I + 1, decide Strat Cs Tau I1 D1 B2 D B.

pred contract-ok i:string, i:list cand, i:term, i:int, i:list bool, o:string.
contract-ok "maximal" _ _ _ _ "" :- !.
contract-ok "guarded" Cs Tau I D0 By :-
  set-nth I D0 tt D1, lines-of Cs D1 _ Tys, guard Tys Tau By.

pred set-nth i:int, i:list bool, i:bool, o:list bool.
set-nth 0 [_|L] B [B|L] :- !.
set-nth I [X|L] B [X|L1] :- I1 is I - 1, set-nth I1 L B L1.

pred lines-of i:list cand, i:list bool, o:list line, o:list term.
lines-of [] _ [] [].
lines-of [cand D Lift Ps Ty _|Cs] [B|Bs] L Tys :-
  lines-of Cs Bs L1 Tys1,
  (if (B = tt) (std.append Lift L1 L, std.append Ps Tys1 Tys)
               (L = [D|L1], Tys = [Ty|Tys1])).

% Tau follows from the premises Tys, by the tactic By
pred guard i:list term, i:term, o:string.
guard Tys Tau By :- arrows Tys Tau G, xtext-guard-tactic L By, try-tactic L G, !.

pred arrows i:list term, i:term, o:term.
arrows [] T T.
arrows [A|As] T (prod `_` A (_\ R)) :- arrows As T R.

pred witnesses i:list ak, i:list term, o:list term.
witnesses [ak-all|Ks] [W|Ws] [W|R] :- !, witnesses Ks Ws R.
witnesses [_|Ks] [_|Ws] R :- !, witnesses Ks Ws R.
witnesses _ _ [].

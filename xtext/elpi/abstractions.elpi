% xtext: Abstractions (series of binders) and local definitions.
% (part of xtext's writer; the files are loaded in the order of Explain.v)

% --- abstraction: iterated abstraction rules

tr-lam (fun _ A _ as T) Ctx Path P :-
  (if (cur-ih Fl0) (Fl = Fl0) (Fl = [])),
  binder-kind A K, typ T Tau0, formula rclaim Tau0 FT, lam-run K [] T FT Fl Ctx Path P.

pred lam-run i:bk, i:list binder, i:term, i:string, i:list bool, i:ctx, i:list int, o:pf.
lam-run K Acc (fun N A F) FT Fl Ctx Path P :- binder-kind A K1, K1 = K, !,
  (if (Fl = [F0|Fr]) true (F0 = ff, Fr = [])),
  binder-name N N1 Id,
  ppf A FA,
  (if (F0 = tt, K = bk-assume) (B = bih Id FA) (B = b K Id FA)),
  pi x\ (decl x N1 A, ctx-name Id) => lam-run K [B|Acc] (F x) FT Fr Ctx Path P.
lam-run K Acc Body FT Fl Ctx Path P :-
  std.rev Acc Bs,
  ((cur-ih Fl :- !) => tr Body Ctx Path PB), flatten PB LB,
  lam-text K Bs FT LB Ctx P.

pred lam-text i:bk, i:list binder, i:string, i:list line, i:ctx, o:pf.
lam-text bk-let Bs FT LB Ctx (prf L C) :-
  let-lines Bs Ls, std.append Ls LB L,
  concl Ctx [wd "proved", tx FT] C.
lam-text bk-assume Bs FT LB Ctx (prf [it H LB] C) :-
  std.map Bs assume-text L, and-parts L Ps,
  say-cap [wd "assume" | Ps] H,
  concl Ctx [wd "proved", tx FT] C.
lam-text bk-set [b _ Id FA] FT LB Ctx (prf [it H LB] C) :- !,
  declaration-formula [Id] FA V, prooftext.formula rfact Id X,
  say-cap [wd "consider", tx V] H,
  concl Ctx [wd "have", tx FT, tx ",", wd "since", tx X, wd "arbitrary"] C.
lam-text bk-set Bs FT LB Ctx (prf [it H LB] C) :-
  std.map Bs (x\ y\ sigma Id FA\ x = b _ Id FA,
     declaration-formula [Id] FA y) L,
  std.map L (v\ p\ p = [tx v]) L1, sep-parts [tx ","] L1 Ps,
  say-cap [wd "choose" | Ps] H,
  concl Ctx [wd "thus-have", tx FT] C.

% [sep-parts Sep Ls Ps]: the lists of parts Ls, with Sep between them
pred sep-parts i:list part, i:list (list part), o:list part.
sep-parts _ [] [].
sep-parts _ [L] L :- !.
sep-parts Sep [L | Ls] Ps :- sep-parts Sep Ls Ps1, std.append L Sep L1, std.append L1 Ps1 Ps.

pred and-parts i:list (list part), o:list part.
and-parts L Ps :- sep-parts [wd "and"] L Ps.

pred assume-text i:binder, o:list part.
assume-text (b _ Id FA) [tx F, tx "(", tx Id, tx ")"] :- prooftext.formula rhyp FA F.
assume-text (bih Id FA) [wd "ih", tx F, tx "(", tx Id, tx ")"] :- prooftext.formula rhyp FA F.

pred concl i:ctx, i:list part, o:option line.
concl star _ none.
concl nostar Ps (some (it S [])) :- say-cap Ps S.

% "Let A B : T" for consecutive binders with the same type
pred let-lines i:list binder, o:list line.
let-lines [] [].
let-lines [b _ Id FA|Bs] [it S []|Ls] :-
  same-type FA Bs Ids Rest,
  declaration-formula [Id|Ids] FA V,
  (if (Ids = []) (U = "let") (U = "let-plural")), say-cap [wd U, tx V] S,
  let-lines Rest Ls.

pred same-type i:string, i:list binder, o:list string, o:list binder.
same-type FA [b _ Id FA|Bs] [Id|Ids] Rest :- !, same-type FA Bs Ids Rest.
same-type _ Bs [] Bs.

% --- local definitions: let x : A := V in M.  The variable keeps its
% value in the context (so that types computed under it stay
% convertible).  A proof V of a proposition A is a lemma proved on the
% way (a cut): its subproof, then the rest; otherwise x names a value.

tr-let R N Ty V F Ctx Path (prf [L1|LB] C) :-
  binder-name N N1 Id,
  (if (binder-kind Ty KL, KL = bk-assume)
      (tr V nostar Path PV, dashed PV (it S0 Ch),
       L1 = it {calc (S0 ^ " (" ^ Id ^ ")")} Ch)
      (ppf V FV, ppf Ty FTy,
       prooftext.formula rvar {calc (Id ^ " : " ^ FTy ^ " := " ^ FV)} LV,
       say-cap [wd "let", tx LV] SL, L1 = it SL [])),
  (pi x\ (def x N1 Ty V, ctx-name Id) =>
     if (R = tt) ((root-term (F x) :- !) => tr-root (F x) Ctx Path PB)
                 (tr (F x) Ctx Path PB)),
  unwrap PB (prf LB C).

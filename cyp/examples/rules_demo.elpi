% The rules of rules_demo.md: a product of nonnegative numbers is
% monotone; its premises, linear, are left to the default tactic (lra).
justify {{ (_ * _ <= _ * _)%R }} (apply {{ Rmult_le_compat }}).
justify {{ (_ * _ <= _ * _)%R }} (apply {{ Rmult_le_compat_r }}).
justify {{ (_ * _ <= _ * _)%R }} (apply {{ Rmult_le_compat_l }}).

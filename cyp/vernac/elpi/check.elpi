% Closing a goal: by the justifications and the facts of its node, or by the rules, or by the
% default tactics.
%
% The rules are in the database cyp.db (Cyp.v): [justify_first], [named],
% [justify] clauses, tried in this order; their tactics [ltac N], [apply T]
% and [lemma T].  Conjunctions and disjunctions are split here.

% [tactic-name Name Ltac]: a tactic added by a proof's rules, and the Ltac
% definition that runs it (Cyp.v).  The tactics every proof text may name
% are prooftext's (prooftext/tactics.elpi): the tactic Name runs the Ltac
% cyp_Name (Cyp.v).  A tactic of the proof, defined with Ltac, is named by a
% clause tactic-name Name Ltac in its rules
pred tactic-name o:string, o:string.

% the default tactics of the proof being checked (its header's by:), then
% cyp's own ones (default-ltac in cyp.db)
pred proof-default o:string.

pred close i:goal.
close (goal _ _ {{ _ /\ _ }} _ _ as G) :-
  coq.ltac.call-ltac1 "cyp_split" G GL, subgoals GL.
close (goal _ _ {{ _ \/ _ }} _ _ as G) :-
  coq.ltac.call-ltac1 "cyp_left" G GL, subgoals GL.
close (goal _ _ {{ _ \/ _ }} _ _ as G) :-
  coq.ltac.call-ltac1 "cyp_right" G GL, subgoals GL.
close (goal _ _ Ty _ _ as G) :- justify_first Ty Tac, run Tac G.
close (goal _ _ Ty _ _ as G) :- named _ Ty Tac, run Tac G.
close (goal _ _ Ty _ _ as G) :- justify Ty Tac, run Tac G.

% [run Tac G]: the tactic Tac of a rule run on G: an Ltac tactic that closes
% it, or a lemma whose premises are then closed (premises)
pred run i:cyptac, i:goal.
run (ltac N) G :- coq.ltac.call-ltac1 N G [].
run (lemma T) G :- refine T G GL, premises GL.
run (apply T) G :- coq.ltac.call "cyp_eapply" [trm T] G GL, premises GL.

% the premises of a lemma: the rules, else the default tactics.  A premise
% may be closed by another lemma, whose premises are closed the same way:
% the search goes at most premise-depth-max lemmas deep (cyp.db), so that
% it ends.  [premise-depth D]: D lemmas are being applied above this goal
pred premise-depth o:int.
premise-depth 0.

% [subgoals GL]: the goals of a conjunction or of one side of a
% disjunction, closed like premises at the same depth
pred subgoals i:list sealed-goal.
subgoals GL :- coq.ltac.all (coq.ltac.open close-tac) GL [].

% [premises GL]: the premises GL of a lemma closed, one lemma deeper (fails
% at premise-depth-max)
pred premises i:list sealed-goal.
premises GL :-
  premise-depth D, !, premise-depth-max Max, D < Max, D1 is D + 1,
  premise-depth D1 => subgoals GL.

% [close-tac G GL]: close-default as a tactic, leaving no goal
pred close-tac i:goal, o:list sealed-goal.
close-tac G [] :- close-default G.

% a hypothesis that is the goal (cyp_hypothesis, Cyp.v; cheap, and it often happens: the claims of
% the steps before are hypotheses), else the rules, else the default
% tactics, first those of the proof.  The check comes first because a
% default tactic may take very long on a goal it would close: tauto runs
% for minutes on ((A \/ B) \/ C -> A \/ B -> A \/ B \/ C) ->
% ((A \/ B) \/ C -> A \/ B \/ C) -> (A \/ B) \/ C -> A \/ B \/ C
pred close-default i:goal.
close-default G :- coq.ltac.call-ltac1 "cyp_hypothesis" G [], !.
close-default G :- close G, !.
% the tactics only on a goal with no existential variable (a premise of a
% lemma that is still to be found: a tactic could run for very long, e.g.
% firstorder on z /\ ?B after eapply proj1)
close-default G :- coq.ltac.call-ltac1 "cyp_evar_free" G _, proof-default N, run-name N G, !.
close-default G :- coq.ltac.call-ltac1 "cyp_evar_free" G _, default-ltac N, coq.ltac.call-ltac1 N G [], !.
% at last, once, the goal with its head unfolded (its weak head normal form):
% a text may state a conclusion with a definition that the steps before it
% prove unfolded ("R z x, that is `Inv E R x z`{.claim}", Inv E R x z being
% R z x by definition), and the default tactics do not unfold it
close-default G :- not head-unfolded,
  coq.ltac.call-ltac1 "cyp_head_unfolded" G [SG],
  coq.ltac.open (g\ gl\ head-unfolded => close-tac g gl) SG [], !.

% [head-unfolded]: the goal is already in weak head normal form
pred head-unfolded.

% [tactic-known X]: X names a tactic: prooftext's, or one that the rules
% of the proof add (tactic-name)
pred tactic-known i:string.
tactic-known X :- tactic-name X _, !.
tactic-known X :- prooftext.tactic X.

% [run-name N G]: the tactic named N run on G
pred run-name i:string, i:goal.
run-name N G :- tactic-name N L, !, coq.ltac.call-ltac1 L G [].
run-name N G :- prooftext.tactic N, L is "cyp_" ^ N, coq.ltac.call-ltac1 L G [].

% ------------------------------------------------------------------ %
% The justifications of a node (rule 9 of the format): the names of rules
% and tactics choose the method, tried in turn; the names of hypotheses,
% nodes and lemmas are what the method is given, put first in the context
% (the paper reorders the assumptions by the justification, 2003, §2.3);
% so are the hypotheses that the facts of the node are.  With no rule or
% tactic name, the names given are applied, one after the other, as a
% single *by X* is today; with no name at all, the rules and the default
% tactics run.

% [classify Names Methods Given Unknown]: the names of the justifications
% of a node sorted: rule and tactic names (Methods), names given (Given),
% and the names that name nothing known.  A name is, in this order: the
% name of rules, a local name (a hypothesis, the conclusion of a node, a
% variable: it hides a lemma of that name, as in Rocq), a lemma (a name,
% possibly qualified), a tactic
pred classify i:list string, o:list string, o:list given, o:list string.
classify [] [] [] [].
classify [X | Xs] [X | Ms] Gs Us :- std.findall (named X _ _) [_ | _], !, classify Xs Ms Gs Us.
classify [X | Xs] Ms [given-local X | Gs] Us :- local-in-scope _ X _, !, classify Xs Ms Gs Us.
classify [X | Xs] Ms [given-lemma GR | Gs] Us :-
  prooftext.is-name X, coq.locate-all X L, std.mem L (loc-gref GR), !, classify Xs Ms Gs Us.
classify [X | Xs] [X | Ms] Gs Us :- tactic-known X, !, classify Xs Ms Gs Us.
classify [X | Xs] Ms Gs [X | Us] :- classify Xs Ms Gs Us.

% [justify-step M G]: the goal G closed by the method M
pred justify-step i:method, i:goal.
% no name: the rules and the default tactics, the facts first
justify-step (method [] [] Fs) G :- !,
  std.map Fs (f\ g\ g = given-local f) First, with-first First close-default G.
% names given, no rule or tactic: each applied in turn, its premises closed
% by the rules; when none of them applies, the rules and the default
% tactics, with the names given and the facts first (a text may name the
% lemma a step comes from without its conclusion being the step's: "Applying
% *proj1*{.just}, we have z", from (proj1 H1) x)
justify-step (method [] Gs Fs) G :- !,
  (std.mem Gs X, std.filter Gs (g\ not (g = X)) Others, apply-given X Others G, !
  ; std.map Fs (f\ g\ g = given-local f) FGs, std.append Gs FGs First,
    with-first First close-default G).
% rule or tactic names: each tried in turn, the names given and the facts
% first in the context
justify-step (method Ms Gs Fs) G :-
  std.map Fs (f\ g\ g = given-local f) FGs, std.append Gs FGs First,
  with-first First (g\ std.mem Ms M, run-method M g, !) G.

% [apply-given X Others G]: the name given X applied to the goal G; its
% premises that are one of the other names given, Others, closed by them
% first (so that the premises after them have no hole left: "and_ind in
% h1"), the others by the rules
pred apply-given i:given, i:list given, i:goal.
apply-given (given-local X) Others (goal Ctx _ _ _ _ as G) :-
  local-name Ctx X H, coq.ltac.call "cyp_eapply" [trm H] G GL, given-premises Others GL.
apply-given (given-lemma GR) Others G :- apply-lemma GR Others G.

% [given-premises Others GL]: the premises GL, those that a name of Others
% is closed by it, then the rest by the rules
pred given-premises i:list given, i:list sealed-goal.
given-premises Others GL :-
  coq.ltac.all (coq.ltac.open (premise-by-given Others)) GL Rest, premises Rest.

% [premise-by-given Others G GL]: G closed by one of the names Others (GL =
% []), or left as it is
pred premise-by-given i:list given, i:goal, o:list sealed-goal.
premise-by-given Others (goal Ctx _ _ _ _ as G) [] :-
  std.mem Others X, given-term Ctx X H, coq.ltac.call "cyp_exact" [trm H] G [], !.
premise-by-given _ G GL :- coq.ltac.call-ltac1 "idtac" G GL.

% [run-method M G]: the rules named M (only them, if there are any), or
% the tactic M, run on G
pred run-method i:string, i:goal.
run-method M (goal _ _ Ty _ _ as G) :-
  std.findall (named M _ _) [_ | _], !, named M Ty T, run T G.
run-method M G :- run-name M G.

% [with-first Gs K G]: K run on the goal G with the hypotheses given Gs
% moved last in its context (where tactics look first), and the lemmas
% given added to it (cyp_first, Cyp.v)
pred with-first i:list given, i:(pred i:goal), i:goal.
with-first [] K G :- K G.
with-first [X | Ns] K (goal Ctx _ _ _ _ as G) :-
  given-term Ctx X H,
  coq.ltac.call "cyp_first" [trm H] G [SG], !,
  coq.ltac.open (with-first-tactic Ns K) SG [].
with-first [_ | Ns] K G :- with-first Ns K G.

% [with-first-tactic Ns K G GL]: with-first as a tactic, leaving no goal
pred with-first-tactic i:list given, i:(pred i:goal), i:goal, o:list sealed-goal.
with-first-tactic Ns K G [] :- with-first Ns K G.

% [given-term Ctx X H]: the term of the name given X, in the context Ctx of
% a goal
pred given-term i:goal-ctx, i:given, o:term.
given-term Ctx (given-local N) H :- local-name Ctx N H, !.
given-term _ (given-lemma GR) (global GR).

% [local-name Ctx X H]: H is the variable, hypothesis or local definition
% named X in the context Ctx of a goal
pred local-name i:goal-ctx, i:string, o:term.
local-name Ctx X H :- std.mem Ctx (decl H N _), coq.name->id N X.
local-name Ctx X H :- std.mem Ctx (def H N _ _), coq.name->id N X.

% [apply-lemma GR Others G]: the lemma GR applied to the goal, its premises
% closed by the other names given (given-premises) and the rules: directly (its conclusion unified with the goal), else, for
% an elimination principle (its first argument is the predicate it proves,
% the motive), as Rocq's elim does: the goal abstracted over one of its
% variables, so that the motive is that abstraction (eapply alone unifies
% ?P ?x with the goal first-order: on n <= n + m it takes P := le n)
pred apply-lemma i:gref, i:list given, i:goal.
apply-lemma GR Others G :-
  coq.ltac.call "cyp_eapply" [trm (global GR)] G GL, given-premises Others GL, !.
apply-lemma GR Others (goal Ctx _ Ty _ _ as G) :-
  elimination-principle GR,
  std.mem Ctx (decl X _ _), occurs X Ty,
  coq.ltac.call "cyp_elim_on" [trm (global GR), trm X] G GL, given-premises Others GL, !.

% [elimination-principle GR]: the type of GR starts with a predicate
% (forall P : ... -> Prop or Type or Set, ...)
pred elimination-principle i:gref.
elimination-principle GR :- coq.env.typeof GR (prod _ PT _), conclusion-sort PT.

% [conclusion-sort T]: T is A1 -> .. -> An -> a sort
pred conclusion-sort i:term.
conclusion-sort (sort _).
conclusion-sort (prod _ _ B) :- pi x\ conclusion-sort (B x).


% [solve-step M G]: as [justify-step], and again after introducing the
% premises of the goal
pred solve-step i:method, i:goal, o:list sealed-goal.
solve-step M G [] :- justify-step M G, !.
solve-step M G [] :-
  coq.ltac.call-ltac1 "cyp_intros" G [SG], coq.ltac.open (solve-step M) SG [].

% [prove M T P]: a proof P of T, in the current context, by the method M
pred prove i:method, i:term, o:term.
prove M T P :-
  coq.typecheck P T ok,
  coq.ltac.collect-goals P [SG] _,
  coq.ltac.open (solve-step M) SG [].
% else the coarse gap tactic (gaps.elpi)
prove M T P :-
  coq.typecheck P T ok,
  coq.ltac.collect-goals P [SG] _,
  coq.ltac.open (close-gap M) SG [].

% Closing a goal: by the justifications and the facts of its node, or by the rules, or by the
% default tactics.
%
% The rules are in the database cyp.db (Cyp.v): [justify_first], [named],
% [justify] clauses, tried in this order; their tactics [ltac N], [apply T]
% and [lemma T].  Conjunctions and disjunctions are split here.

% The words of the justifications are declared (CypJustification, Cyp.v):
% [justification-word Word Meaning Origin] in cyp.db, Meaning an Ltac
% tactic (meaning-tactic) or the rules named Word (meaning-rules).  The
% tactics every proof text may name (prooftext/tactics.elpi) are declared
% at the end of Cyp.v, each the Ltac word_Name of prooftext/Tactics.v.

% the default tactics of the proof being checked (its header's by:), then
% cyp's own ones (default-ltac in cyp.db)
pred proof-default o:string.

% Each predicate that closes a goal also gives the Ltac script that does
% the same in plain Rocq (Sc, after How: script-call, stats.elpi), for
% cyp --extract; its terms are printed only when scripts-on.

% [close G How Sc]: close the goal G by the rules: a conjunction split, one
% side of a disjunction, else a rule of the proof (justify_first, named,
% justify); How, how it was closed (timing.elpi); Sc, the script
pred close i:goal, o:string, o:string.
close (goal _ _ {{ _ /\ _ }} _ _ as G) How Sc :-
  coq.ltac.call-ltac1 "cyp_split" G GL, subgoals GL Hs Ss, how-call "split" Hs How,
  script-call "cyp_split" Ss Sc.
close (goal _ _ {{ _ \/ _ }} _ _ as G) How Sc :-
  coq.ltac.call-ltac1 "cyp_left" G GL, subgoals GL Hs Ss, how-call "left" Hs How,
  script-call "cyp_left" Ss Sc.
close (goal _ _ {{ _ \/ _ }} _ _ as G) How Sc :-
  coq.ltac.call-ltac1 "cyp_right" G GL, subgoals GL Hs Ss, how-call "right" Hs How,
  script-call "cyp_right" Ss Sc.
close (goal _ _ Ty _ _ as G) How Sc :- justify_first Ty Tac, run Tac G H Sc, How is "rule " ^ H.
close (goal _ _ Ty _ _ as G) How Sc :- named N Ty Tac, run Tac G H Sc, How is "rule " ^ N ^ ": " ^ H.
close (goal _ _ Ty _ _ as G) How Sc :- justify Ty Tac, run Tac G H Sc, How is "rule " ^ H.

% [run Tac G How Sc]: the tactic Tac of a rule run on G: an Ltac tactic that
% closes it, or a lemma whose premises are then closed (premises)
pred run i:cyptac, i:goal, o:string, o:string.
run (ltac N) G N N :- coq.ltac.call-ltac1 N G [].
run (lemma T) G How Sc :- script-term T TS, refine T G GL, premises GL Hs Ss,
  how-call {calc ("lemma " ^ {head-name T})} Hs How,
  script-call {calc ("refine " ^ TS)} Ss Sc.
run (apply T) G How Sc :- coq.ltac.call "cyp_eapply" [trm T] G GL, premises GL Hs Ss,
  how-call {calc ("apply " ^ {head-name T})} Hs How,
  script-call {calc ("cyp_eapply " ^ {script-term T})} Ss Sc.

% the premises of a lemma: the rules, else the default tactics.  A premise
% may be closed by another lemma, whose premises are closed the same way:
% the search goes at most premise-depth-max lemmas deep (cyp.db), so that
% it ends.  [premise-depth D]: D lemmas are being applied above this goal
pred premise-depth o:int.
premise-depth 0.

% [all-how K GL Hows Scs]: the tactic K run on each goal of GL, one after the
% other, leaving no goal, as coq.ltac.all does; Hows, how each was closed
% (a variable for a goal already solved by another one's solution), Scs
% the scripts
pred all-how i:(pred i:goal, o:list sealed-goal, o:string, o:string), i:list sealed-goal,
  o:list string, o:list string.
all-how _ [] [] [].
all-how K [SG | GL] [H | Hs] [S | Ss] :- coq.ltac.open (g\ gl\ K g gl H S) SG [], all-how K GL Hs Ss.

% [subgoals GL Hows Scs]: the goals of a conjunction or of one side of a
% disjunction, closed like premises at the same depth; Hows, how
pred subgoals i:list sealed-goal, o:list string, o:list string.
subgoals GL Hs Ss :- all-how close-tac GL Hs Ss.

% [premises GL Hows Scs]: the premises GL of a lemma closed, one lemma deeper
% (fails at premise-depth-max)
pred premises i:list sealed-goal, o:list string, o:list string.
premises GL Hs Ss :-
  premise-depth D, !, premise-depth-max Max, D < Max, D1 is D + 1,
  premise-depth D1 => subgoals GL Hs Ss.

% [close-tac G GL How Sc]: close-default as a tactic, leaving no goal
pred close-tac i:goal, o:list sealed-goal, o:string, o:string.
close-tac G [] How Sc :- close-default G How Sc.

% a hypothesis that is the goal (cyp_hypothesis, Cyp.v; cheap, and it often happens: the claims of
% the steps before are hypotheses), else the rules, else the default
% tactics, first those of the proof.  The check comes first because a
% default tactic may take very long on a goal it would close: tauto runs
% for minutes on ((A \/ B) \/ C -> A \/ B -> A \/ B \/ C) ->
% ((A \/ B) \/ C -> A \/ B \/ C) -> (A \/ B) \/ C -> A \/ B \/ C
pred close-default i:goal, o:string, o:string.
close-default G "hypothesis" "cyp_hypothesis" :- coq.ltac.call-ltac1 "cyp_hypothesis" G [], !.
close-default G How Sc :- close G How Sc, !.
% the tactics only on a goal with no existential variable (a premise of a
% lemma that is still to be found: a tactic could run for very long, e.g.
% firstorder on z /\ ?B after eapply proj1)
close-default G How Sc :- coq.ltac.call-ltac1 "cyp_evar_free" G _, proof-default N, run-name N G How Sc, !.
close-default G How N :- coq.ltac.call-ltac1 "cyp_evar_free" G _, default-ltac N, coq.ltac.call-ltac1 N G [], !,
  ltac-how N How.
% at last, once, the goal with its head unfolded (its weak head normal form):
% a text may state a conclusion with a definition that the steps before it
% prove unfolded ("R z x, that is `Inv E R x z`{.claim}", Inv E R x z being
% R z x by definition), and the default tactics do not unfold it
close-default G How Sc :- not head-unfolded,
  coq.ltac.call-ltac1 "cyp_head_unfolded" G [SG],
  coq.ltac.open (g\ gl\ head-unfolded => close-tac g gl H S) SG [], !,
  How is "hnf, " ^ H, script-then "cyp_head_unfolded" S Sc.

% [head-unfolded]: the goal is already in weak head normal form
pred head-unfolded.

% [run-name N G How Sc]: the declared word N run on G: its Ltac tactic, or
% its rules (only them); How, how
pred run-name i:string, i:goal, o:string, o:string.
run-name N G N L :- justification-word N (meaning-tactic L) _, !, coq.ltac.call-ltac1 L G [].
run-name N (goal _ _ Ty _ _ as G) How Sc :- justification-word N meaning-rules _, !, named N Ty T, run T G H Sc,
  How is "rule " ^ N ^ ": " ^ H.

% ------------------------------------------------------------------ %
% The justifications of a node (rule 9 of the format): the declared words
% (rules and tactics) choose the method, tried in turn; the names of
% hypotheses, nodes and lemmas are what the method is given, put first in
% the context (the paper reorders the assumptions by the justification,
% 2003, §2.3); so are the hypotheses that the facts of the node are.  With
% no declared word, the names given are applied, one after the other, as a
% single justification *X*{.just} is; with no name at all, the rules and
% the default tactics run.  The fixed methods *match* and *induction*
% (prooftext's method) first eliminate the objects named (proof.elpi,
% node-method), then close each case so.

% [classify Names Methods Given Unknown]: the names of the justifications
% of a node sorted: methods (the fixed ones and the declared words),
% names given (Given), and the names that name nothing known.  A name is,
% in this order:
%   1. a fixed method, match or induction;
%   2. a local name: a hypothesis, the conclusion of a node, a variable
%      (the text's own names come first, as in Rocq a local name hides a
%      global one);
%   3. a word declared by CypJustification (justification-word: a tactic
%      or rules);
%   4. a lemma (a name, possibly qualified), applied or given;
% else it names nothing known (an error of the node)
pred classify i:list string, o:list string, o:list given, o:list string.
classify [] [] [] [].
% the fixed methods match and induction first: induction may also be a
% name of Rocq, but as a justification it is the method
classify [X | Xs] [X | Ms] Gs Us :- prooftext.method X, !, classify Xs Ms Gs Us.
classify [X | Xs] Ms [given-local X | Gs] Us :- local-in-scope _ X _, !, classify Xs Ms Gs Us.
classify [X | Xs] [X | Ms] Gs Us :- justification-word X _ _, !, classify Xs Ms Gs Us.
classify [X | Xs] Ms [given-lemma GR | Gs] Us :-
  prooftext.is-name X, coq.locate-all X L, std.mem L (loc-gref GR), !, classify Xs Ms Gs Us.
classify [X | Xs] Ms Gs [X | Us] :- classify Xs Ms Gs Us.

% [justify-step M G How Sc]: the goal G closed by the method M; How, how
pred justify-step i:method, i:goal, o:string, o:string.
% a fixed method, match or induction: the case analysis or the induction
% on each object named (eliminate), then each case closed by the rest of
% the method (the other names, the rules, the default tactics)
justify-step (eliminating E Ts M) G How Sc :- !,
  eliminate E Ts G GL, all-how (solve-step M) GL Hs Ss,
  std.string.concat " " [E | Ts] Head, how-call Head Hs How,
  std.map Ts (t\ s\ s is "cyp_" ^ E ^ " " ^ t) Es,
  (Es = [] , EHead = "idtac" ; std.string.concat "; " Es EHead), !,
  script-call {calc ("(" ^ EHead ^ ")")} Ss Sc.
% no name: the rules and the default tactics, the facts first
justify-step (method [] [] Fs) G How Sc :- !,
  std.map Fs (f\ g\ g = given-local f) First, with-first First close-default G How Sc.
% names given, no declared word: each applied in turn, its premises closed
% by the rules; when none of them applies, the rules and the default
% tactics, with the names given and the facts first (a text may name the
% lemma a step comes from without its conclusion being the step's: "Applying
% *proj1*{.just}, we have z", from (proj1 H1) x)
justify-step (method [] Gs Fs) G How Sc :- !,
  (std.mem Gs X, std.filter Gs (g\ not (g = X)) Others, apply-given X Others G How Sc, !
  ; std.map Fs (f\ g\ g = given-local f) FGs, std.append Gs FGs First,
    with-first First close-default G H Sc, How is "no name applies, " ^ H).
% declared words (rules, tactics): each tried in turn, the names given and the facts
% first in the context
justify-step (method Ms Gs Fs) G How Sc :-
  std.map Fs (f\ g\ g = given-local f) FGs, std.append Gs FGs First,
  with-first First (g\ h\ s\ std.mem Ms M, run-name M g h s, !) G How Sc.

% [apply-given X Others G How Sc]: the name given X applied to the goal G; its
% premises that are one of the other names given, Others, closed by them
% first (so that the premises after them have no hole left: "and_ind in
% h1"), the others by the rules
pred apply-given i:given, i:list given, i:goal, o:string, o:string.
apply-given (given-local X) Others (goal Ctx _ _ _ _ as G) How Sc :-
  local-name Ctx X H, coq.ltac.call "cyp_eapply" [trm H] G GL, given-premises Others GL Hs Ss,
  how-call {calc ("apply " ^ X)} Hs How,
  script-call {calc ("cyp_eapply " ^ X)} Ss Sc.
apply-given (given-lemma GR) Others G How Sc :- apply-lemma GR Others G How Sc.

% [given-premises Others GL Hows Scs]: the premises GL, those that a name of
% Others is closed by it, then the rest by the rules (Hows: how; Scs: the
% script of each goal of GL)
pred given-premises i:list given, i:list sealed-goal, o:list string, o:list string.
given-premises Others GL Hs Ss :-
  std.map GL (sg\ r\ sigma Left\ coq.ltac.open (premise-by-given Others r) sg Left, r = pr _ Left) Rs,
  std.map Rs (r\ l\ r = pr _ l) Lefts, std.flatten Lefts Rest,
  premises Rest Hs SsRest,
  given-scripts Rs SsRest Ss.

% [given-scripts Rs SsRest Ss]: the script of each premise: cyp_exact for
% one closed by a name given, the next of SsRest for one left to the
% rules, idtac for one solved before its turn
pred given-scripts i:list (pair (option string) (list sealed-goal)), i:list string, o:list string.
given-scripts [] _ [] :- !.
given-scripts [pr X _ | Rs] Rest [S | Ss] :- not (var X), X = some S, !, given-scripts Rs Rest Ss.
given-scripts [pr X [_] | Rs] [S | Rest] [S | Ss] :- not (var X), !, given-scripts Rs Rest Ss.
given-scripts [_ | Rs] Rest ["idtac" | Ss] :- given-scripts Rs Rest Ss.

% [premise-by-given Others R G GL]: G closed by one of the names Others (GL =
% [], R = some its script), or left as it is (R = none)
pred premise-by-given i:list given, o:pair (option string) (list sealed-goal), i:goal, o:list sealed-goal.
premise-by-given Others (pr (some S) _) (goal Ctx _ _ _ _ as G) [] :-
  std.mem Others X, given-term Ctx X H, coq.ltac.call "cyp_exact" [trm H] G [], !,
  S is "cyp_exact " ^ {script-term H}.
premise-by-given _ (pr none _) G GL :- coq.ltac.call-ltac1 "idtac" G GL.

% [eliminate E Ts G GL]: the goal G after the method E (match: a case
% analysis, cyp_match; induction: cyp_induction, Cyp.v) on the
% hypotheses or variables named Ts, in turn, in each case of the ones
% before
pred eliminate i:string, i:list string, i:goal, o:list sealed-goal.
eliminate _ [] G GL :- coq.ltac.call-ltac1 "idtac" G GL.
eliminate E [T | Ts] (goal Ctx _ _ _ _ as G) GL :-
  local-name Ctx T H, L is "cyp_" ^ E, coq.ltac.call L [trm H] G GL1,
  coq.ltac.all (coq.ltac.open (eliminate E Ts)) GL1 GL.

% [with-first Gs K G How Sc]: K run on the goal G with the hypotheses given Gs
% moved last in its context (where tactics look first), and the lemmas
% given added to it (cyp_first, Cyp.v); How, how K closed it
pred with-first i:list given, i:(pred i:goal, o:string, o:string), i:goal, o:string, o:string.
with-first [] K G How Sc :- K G How Sc.
with-first [X | Ns] K (goal Ctx _ _ _ _ as G) How Sc :-
  given-term Ctx X H,
  coq.ltac.call "cyp_first" [trm H] G [SG], !,
  coq.ltac.open (g\ gl\ with-first-tactic Ns K g gl How S) SG [],
  script-then {calc ("cyp_first " ^ {script-term H})} S Sc.
with-first [_ | Ns] K G How Sc :- with-first Ns K G How Sc.

% [with-first-tactic Ns K G GL How Sc]: with-first as a tactic, leaving no goal
pred with-first-tactic i:list given, i:(pred i:goal, o:string, o:string), i:goal, o:list sealed-goal,
  o:string, o:string.
with-first-tactic Ns K G [] How Sc :- with-first Ns K G How Sc.

% [given-term Ctx X H]: the term of the name given X, in the context Ctx of
% a goal
pred given-term i:goal-ctx, i:given, o:term.
given-term Ctx (given-local N) H :- local-name Ctx N H, !.
given-term _ (given-lemma GR) (global GR).

% [local-name Ctx X H]: H is the variable, hypothesis or local definition
% named X in the context Ctx of a goal
pred local-name i:goal-ctx, i:string, o:term.
local-name Ctx X H :- std.mem Ctx (decl H N _), coq.name->id N X.
local-name Ctx X H :- std.mem Ctx (def H N _ _), coq.name->id N X.

% [apply-lemma GR Others G How Sc]: the lemma GR applied to the goal, its premises
% closed by the other names given (given-premises) and the rules: directly (its conclusion unified with the goal), else, for
% an elimination principle (its first argument is the predicate it proves,
% the motive), as Rocq's elim does: the goal abstracted over one of its
% variables, so that the motive is that abstraction (eapply alone unifies
% ?P ?x with the goal first-order: on n <= n + m it takes P := le n)
pred apply-lemma i:gref, i:list given, i:goal, o:string, o:string.
apply-lemma GR Others G How Sc :-
  coq.ltac.call "cyp_eapply" [trm (global GR)] G GL, given-premises Others GL Hs Ss, !,
  how-call {calc ("apply " ^ {coq.gref->id GR})} Hs How,
  script-call {calc ("cyp_eapply " ^ {script-term (global GR)})} Ss Sc.
apply-lemma GR Others (goal Ctx _ Ty _ _ as G) How Sc :-
  elimination-principle GR,
  std.mem Ctx (decl X _ _), occurs X Ty,
  coq.ltac.call "cyp_elim_on" [trm (global GR), trm X] G GL, given-premises Others GL Hs Ss, !,
  how-call {calc ("elim " ^ {coq.gref->id GR})} Hs How,
  script-call {calc ("cyp_elim_on " ^ {script-term (global GR)} ^ " " ^ {script-term X})} Ss Sc.

% [elimination-principle GR]: the type of GR starts with a predicate
% (forall P : ... -> Prop or Type or Set, ...)
pred elimination-principle i:gref.
elimination-principle GR :- coq.env.typeof GR (prod _ PT _), conclusion-sort PT.

% [conclusion-sort T]: T is A1 -> .. -> An -> a sort
pred conclusion-sort i:term.
conclusion-sort (sort _).
conclusion-sort (prod _ _ B) :- pi x\ conclusion-sort (B x).


% [solve-step M G GL How Sc]: as [justify-step], and again after introducing
% the premises of the goal
pred solve-step i:method, i:goal, o:list sealed-goal, o:string, o:string.
solve-step M G [] How Sc :- justify-step M G How Sc, !.
solve-step M G [] How Sc :-
  coq.ltac.call-ltac1 "cyp_intros" G [SG], coq.ltac.open (g\ gl\ solve-step M g gl H S) SG [],
  How is "intros, " ^ H, script-then "cyp_intros" S Sc.

% [prove M T P How Sc]: a proof P of T, in the current context, by the method
% M; How, how (timing.elpi); Sc, the script
pred prove i:method, i:term, o:term, o:string, o:string.
prove M T P How Sc :-
  coq.typecheck P T ok,
  coq.ltac.collect-goals P [SG] _,
  coq.ltac.open (g\ gl\ solve-step M g gl How Sc) SG [].
% else the coarse gap tactic (gaps.elpi)
prove M T P How "cyp_gap" :-
  coq.typecheck P T ok,
  coq.ltac.collect-goals P [SG] _,
  gap-how How,
  coq.ltac.open (close-gap M) SG [].

% A proof: its statement and its steps, turned into a Rocq proof.
%
% A proof is a verification condition generator: each step gives
% conditions, goals in their own context (the variables and hypotheses of
% the statement, the claims of the steps before it, and the variables,
% hypotheses and definitions of the scopes it is in; a claim is a
% hypothesis, whatever its proof).  Each condition is discharged by the
% rules or the default tactics; in proof mode (proof-mode), one that is not
% becomes a goal of the Proof block.  Conditions are numbered after their
% step, in Dewey notation: 2.1 is the first sub-step of step 2, 2a and 2b
% the two claims of step 2, 0 the statement after the steps.
% The proof term:
%   a forward step with claim C:   cyp_have C G P (fun c : C => ...) (C
%                                  proved by P, by its sub-steps if any);
%   a backward step with claim C:  (P : C -> G) (proof of C by the rest);
%   a scope (Let `x : T`, Assume `A`, Let `u := e`, no claim): its body
%   (its sub-steps, or else the steps after it) is proved under those
%   binders, and each claim C of the body is known after the scope as
%   forall x, A -> C (a projection of the body's proof);
%   the end of a list of steps: its goal, by the default tactics, or by
%   the justification of the step whose sub-steps they are.

% a step: its number (Dewey), its elements, its justification, its sub-steps
kind step type.
type step string -> list element -> option string -> list step -> step.

% a formula given as a term (Cyp Lemma) rather than as text (Cyp File)
type eltt role -> term -> element.

% the notation scope of the formulas (header's scope:), "" for none
pred current-scope o:string.

% the report of a step
kind status type.
type ok status.
type ko string -> status.               % the goal not proved
type bad string -> status.              % a formula that does not parse
type todo string -> status.             % a goal left to the Proof block
kind report type.
type rep string -> status -> report.    % the number of a condition

% proof mode: the conditions not discharged are left to the Proof block
pred proof-mode.

% the condition I of step S: S itself if it is the only one, else S
% followed by a letter
pred condition-id i:string, i:int, i:int, o:string.
condition-id S _ 1 S :- !.
condition-id S I _ Id :- letter I L, Id is S ^ L.
pred letter i:int, o:string.
letter I L :-
  std.nth {calc (I - 1)} ["a","b","c","d","e","f","g","h","i","j","k","l","m",
    "n","o","p","q","r","s","t","u","v","w","x","y","z"] L.

% the step of a condition: its number without the letter
pred step-of i:string, o:string.
step-of Id S :- rex.replace "[a-z]$" "" Id S.

% ------------------------------------------------------------------ %
% Formulas

% [parse E T]: the term of a formula, in the current context
pred parse i:element, o:term, o:diagnostic.
parse (elt _ S) T D :-
  current-scope Sc, P is "(" ^ S ^ ")",
  coq.parse.argument P ff Sc A D, (D = ok, A = trm T ; true), !.
parse (eltt _ T0) T D :- coq.elaborate-skeleton T0 _ T D.

pred is-prop i:term.
is-prop T :- coq.typecheck T Ty ok, coq.unify-eq Ty (sort prop) ok.

pred conj i:list term, o:term.
conj [C] C :- !.
conj [C | L] {{ lp:C /\ lp:R }} :- conj L R.

% the parts of a step
pred claims i:list element, o:list element.
claims L C :- std.filter L is-claim C.
pred is-claim i:element.
is-claim (elt rclaim _).
is-claim (elt rback _).
is-claim (eltt rclaim _).
is-claim (eltt rback _).
pred binders i:list element, o:list element.
binders L C :- std.filter L is-var C.
pred is-var i:element.
is-var (elt rvar _).
pred backward i:list element.
backward L :- std.exists L is-back.
pred is-back i:element.
is-back (elt rback _).
is-back (eltt rback _).

% the hypotheses of a step, with the name written after each, if any
pred hyps i:list element, o:list (pair element (option string)).
hyps [] [].
hyps [elt rhyp S, hname N | L] [pr (elt rhyp S) (some N) | H] :- !, hyps L H.
hyps [eltt rhyp T, hname N | L] [pr (eltt rhyp T) (some N) | H] :- !, hyps L H.
hyps [elt rhyp S | L] [pr (elt rhyp S) none | H] :- !, hyps L H.
hyps [eltt rhyp T | L] [pr (eltt rhyp T) none | H] :- !, hyps L H.
hyps [_ | L] H :- hyps L H.

% the claims of a step as terms; those that are not propositions are
% mentions; Bad: the formulas that do not parse
pred claim-terms i:list element, o:list term, o:list string.
claim-terms [] [] [].
claim-terms [E | L] Ts Bad :-
  parse E T D,
  if (D = ok)
     (if (is-prop T) (Ts = [T | Ts1]) (Ts = Ts1), Bad = Bad1)
     (D = error M, Ts = Ts1, Bad = [M | Bad1]),
  claim-terms L Ts1 Bad1.

% ------------------------------------------------------------------ %
% Proving a step

pred step-proof i:option string, i:string, i:term, o:term, o:report.
step-proof Tac I T P (rep I ok) :- prove Tac T P, !.
step-proof _ I T P (rep I (todo S)) :- proof-mode, !,
  condition-hole I T P, coq.term->string T S.
step-proof _ I T _ (rep I (ko S)) :- coq.term->string T S.

% a hole for the condition I, of type T, under a definition
% condition := "I" that names it in its goal
pred condition-hole i:string, i:term, o:term.
condition-hole I T (let `condition` {{ PrimString.string }} Lab H) :-
  Lab = primitive (pstring {coq.string->pstring I}),
  pi x\ def x `condition` {{ PrimString.string }} Lab => coq.typecheck (H x) T ok.

% the hypothesis of claim Id: c followed by its number, dots as _
pred claim-name i:string, o:name.
claim-name Id N :- rex.replace "[.]" "_" Id S, coq.id->name {calc ("c" ^ S)} N.

% [level Own OTac Steps G P Rs]: P proves G from the steps, in the current
% context; the last condition (G follows) belongs to the step Own and is
% closed by its justification OTac
pred level i:string, i:option string, i:list step, i:term, o:term, o:list report.
level Own OTac [] G P [R] :- step-proof OTac Own G P R.
level Own OTac [step I Es Tac Ch | Rest] G P Rs :-
  claims Es Cs0, claim-terms Cs0 Cs Bad,
  binders Es Vs, hyps Es Hs,
  if (Bad = [_ | _])
     % a formula does not parse: the step is reported, and skipped
     (std.string.concat "; " Bad M, Rs = [rep I (bad M) | Rs1],
      level Own OTac {std.append Ch Rest} G P Rs1)
  (if (Cs = [], (Vs = [_ | _] ; Hs = [_ | _]))
     % a scope: its sub-steps, or else the steps after it
     (if (Ch = []) (Body = Rest, Rest1 = []) (Body = Ch, Rest1 = Rest),
      scope Vs Hs Body ExTy ExPf N Rs1,
      if (N = 0) (level Own OTac Rest1 G P Rs2)
                 (exports I Own OTac ExTy ExPf 1 N Rest1 G P Rs2),
      std.append Rs1 Rs2 Rs)
  (if (Cs = [])
     % a comment
     (level Own OTac {std.append Ch Rest} G P Rs)
  (conj Cs C,
   if (backward Es)
     % the new goal C implies G; the sub-steps and the rest prove C
     (step-proof Tac I (prod `_` C (_\ G)) P1 R1,
      level Own OTac {std.append Ch Rest} C P2 Rs2,
      P = app [P1, P2], Rs = [R1 | Rs2])
     % the claims one after the other, each knowing those before it; or,
     % with sub-steps, their conjunction proved by them and then each claim
     % on its own
     (std.length Cs NC,
      if (Ch = []) (claims-then I 1 NC Tac Cs Own OTac Rest G P Rs)
        (level I Tac Ch C P1 Rs1,
         exports I Own OTac C P1 1 NC Rest G P Rs2,
         std.append Rs1 Rs2 Rs))))).

% [claims-then S J N Tac Cs ...]: the claims J.. of the N claims Cs of step
% S, each proved and then a hypothesis, then the rest of the steps
pred claims-then i:string, i:int, i:int, i:option string, i:list term,
  i:string, i:option string, i:list step, i:term, o:term, o:list report.
claims-then _ _ _ _ [] Own OTac Rest G P Rs :- level Own OTac Rest G P Rs.
claims-then S J N Tac [C | Cs] Own OTac Rest G {{ cyp_have lp:C lp:G lp:P1 lp:K }} [R | Rs] :-
  condition-id S J N Id,
  step-proof Tac Id C P1 R,
  claim-name Id Nm, J1 is J + 1,
  K = fun Nm C P2,
  pi x\ decl x Nm C => claims-then S J1 N Tac Cs Own OTac Rest G (P2 x) Rs.

% ------------------------------------------------------------------ %
% Scopes

% [scope Vs Hs Body ExTy ExPf N Rs]: under the variables, definitions
% and hypotheses, the N claims of Body: ExTy = forall .., C1 /\ .. /\ CN
% (let for a definition), ExPf its proof
pred scope i:list element, i:list (pair element (option string)),
  i:list step, o:term, o:term, o:int, o:list report.
scope [] [] Body Ty Pf N Rs :- open-level [] Body Ty Pf N Rs.
scope [elt rvar S | Vs] Hs Body Ty Pf N Rs :- rex.match ".*:=" S, !,
  % a definition u := e (or u : T := e)
  P is "Definition " ^ S,
  std.assert-ok! (coq.parse.argument P ff {current-scope} (const-decl Id (some Bo) Ar))
    {calc ("cyp: the definition does not parse: " ^ S)},
  coq.arity->term Ar T, coq.id->name Id Nm,
  Ty = let Nm T Bo TyR, Pf = let Nm T Bo PfR,
  pi x\ def x Nm T Bo => scope Vs Hs Body (TyR x) (PfR x) N Rs.
scope [elt rvar S | Vs] Hs Body Ty Pf N Rs :-
  P is "Context (" ^ S ^ ")",
  std.assert-ok! (coq.parse.argument P ff "" (ctx-decl C))
    {calc ("cyp: the variables do not parse: " ^ S)},
  scope-ctx C Vs Hs Body Ty Pf N Rs.
scope [] [pr E Nm0 | Hs] Body (prod Nm A TyR) (fun Nm A PfR) N Rs :-
  std.assert-ok! (parse E A) "cyp: a hypothesis does not parse",
  hyp-name Nm0 Nm,
  pi h\ decl h Nm A => scope [] Hs Body (TyR h) (PfR h) N Rs.

pred scope-ctx i:context-decl, i:list element,
  i:list (pair element (option string)), i:list step, o:term, o:term, o:int,
  o:list report.
scope-ctx context-end Vs Hs Body Ty Pf N Rs :- scope Vs Hs Body Ty Pf N Rs.
scope-ctx (context-item Id _ T _ C) Vs Hs Body (prod Nm T TyR) (fun Nm T PfR) N Rs :-
  coq.id->name Id Nm,
  pi x\ decl x Nm T => scope-ctx (C x) Vs Hs Body (TyR x) (PfR x) N Rs.

pred hyp-name i:option string, o:name.
hyp-name (some S) N :- coq.id->name S N.
hyp-name none N :- coq.id->name "H" N.

% [open-level Acc Steps Ty Pf N Rs]: the claims of the steps, with no goal;
% Acc the claims so far (their types and the variables naming them)
pred open-level i:list (pair term term), i:list step, o:term, o:term,
  o:int, o:list report.
open-level Acc [] Ty Pf N [] :-
  std.rev Acc Acc1, std.length Acc1 N,
  std.map Acc1 fst Ts, std.map Acc1 snd Ps,
  (N = 0, Ty = {{ True }}, Pf = {{ I }} ; conj Ts Ty, conj-proof Ts Ps Pf), !.
open-level Acc [step I Es Tac Ch | Rest] Ty Pf N Rs :-
  claims Es Cs0, claim-terms Cs0 Cs Bad,
  binders Es Vs, hyps Es Hs,
  if (Bad = [_ | _])
     (std.string.concat "; " Bad M, Rs = [rep I (bad M) | Rs1],
      open-level Acc {std.append Ch Rest} Ty Pf N Rs1)
  (if (Cs = [], (Vs = [_ | _] ; Hs = [_ | _]))
     (if (Ch = []) (Body = Rest, Rest1 = []) (Body = Ch, Rest1 = Rest),
      scope Vs Hs Body ExTy ExPf N0 Rs1,
      open-exports I Acc ExTy ExPf 1 N0 Rest1 Ty Pf N Rs2,
      std.append Rs1 Rs2 Rs)
  (if (Cs = [])
     (open-level Acc {std.append Ch Rest} Ty Pf N Rs)
  (conj Cs C,
   if (backward Es)
     (Rs = [rep I (bad "a backward step needs a goal: not inside Let/Assume") | Rs1],
      open-level Acc Rest Ty Pf N Rs1)
     (std.length Cs NC,
      if (Ch = []) (open-claims I 1 NC Tac Cs Acc Rest Ty Pf N Rs)
        (level I Tac Ch C P1 Rs1,
         open-exports I Acc C P1 1 NC Rest Ty Pf N Rs2,
         std.append Rs1 Rs2 Rs))))).

pred open-claims i:string, i:int, i:int, i:option string, i:list term,
  i:list (pair term term), i:list step, o:term, o:term, o:int, o:list report.
open-claims _ _ _ _ [] Acc Rest Ty Pf N Rs :- open-level Acc Rest Ty Pf N Rs.
open-claims S J NC Tac [C | Cs] Acc Rest Ty {{ cyp_have lp:C lp:Ty lp:P1 lp:K }} N [R | Rs] :-
  condition-id S J NC Id,
  step-proof Tac Id C P1 R,
  claim-name Id Nm, J1 is J + 1,
  K = fun Nm C Pf,
  pi x\ decl x Nm C => open-claims S J1 NC Tac Cs [pr C x | Acc] Rest Ty (Pf x) N Rs.

pred conj-proof i:list term, i:list term, o:term.
conj-proof [_] [P] P :- !.
conj-proof [A | Ts] [P | Ps] {{ @conj lp:A lp:B lp:P lp:Q }} :-
  conj Ts B, conj-proof Ts Ps Q.

% ------------------------------------------------------------------ %
% The claims of a scope, known after it

% [proj-type ExTy I N T]: forall .., Ci from forall .., C1 /\ .. /\ CN
pred proj-type i:term, i:int, i:int, o:term.
proj-type (prod Nm A B) I N (prod Nm A B1) :- !, pi x\ proj-type (B x) I N (B1 x).
proj-type (let Nm A V B) I N (let Nm A V B1) :- !, pi x\ proj-type (B x) I N (B1 x).
proj-type B I N T :- component B I N T.

pred component i:term, i:int, i:int, o:term.
component B _ 1 B :- !.
component {{ lp:A /\ _ }} 1 _ A :- !.
component {{ _ /\ lp:R }} I N T :- I1 is I - 1, N1 is N - 1, component R I1 N1 T.

% [proj-proof ExTy E I N P]: P proves proj-type ExTy I N from E : ExTy
pred proj-proof i:term, i:term, i:int, i:int, o:term.
proj-proof (prod Nm A B) E I N (fun Nm A P) :- !,
  pi x\ proj-proof (B x) {coq.mk-app E [x]} I N (P x).
proj-proof (let Nm A V B) E I N (let Nm A V P) :- !,
  pi x\ def x Nm A V => proj-proof (B x) E I N (P x).
proj-proof B E I N P :- component-proof B E I N P.

pred component-proof i:term, i:term, i:int, i:int, o:term.
component-proof _ E _ 1 E :- !.
component-proof {{ lp:A /\ lp:R }} E 1 _ {{ @proj1 lp:A lp:R lp:E }} :- !.
component-proof {{ lp:A /\ lp:R }} E I N P :-
  I1 is I - 1, N1 is N - 1,
  component-proof R {{ @proj2 lp:A lp:R lp:E }} I1 N1 P.

% [exports S Own OTac ExTy ExPf I N Rest G P Rs]: the claims I..N of a
% scope or of a step S with sub-steps, as hypotheses named after S, then
% the rest of the steps
pred exports i:string, i:string, i:option string, i:term, i:term, i:int, i:int,
  i:list step, i:term, o:term, o:list report.
exports _ Own OTac _ _ I N Rest G P Rs :- I > N, !, level Own OTac Rest G P Rs.
exports S Own OTac ExTy ExPf I N Rest G {{ cyp_have lp:T lp:G lp:Pi lp:K }} Rs :-
  proj-type ExTy I N T, proj-proof ExTy ExPf I N Pi,
  condition-id S I N Id, claim-name Id Nm, I1 is I + 1,
  K = fun Nm T P,
  pi x\ decl x Nm T => exports S Own OTac ExTy ExPf I1 N Rest G (P x) Rs.

pred open-exports i:string, i:list (pair term term), i:term, i:term, i:int, i:int,
  i:list step, o:term, o:term, o:int, o:list report.
open-exports _ Acc _ _ I N0 Rest Ty Pf N Rs :- I > N0, !, open-level Acc Rest Ty Pf N Rs.
open-exports S Acc ExTy ExPf I N0 Rest Ty {{ cyp_have lp:T lp:Ty lp:Pi lp:K }} N Rs :-
  proj-type ExTy I N0 T, proj-proof ExTy ExPf I N0 Pi,
  condition-id S I N0 Id, claim-name Id Nm, I1 is I + 1,
  K = fun Nm T Pf,
  pi x\ decl x Nm T => open-exports S [pr T x | Acc] ExTy ExPf I1 N0 Rest Ty (Pf x) N Rs.

% ------------------------------------------------------------------ %
% The statement

% [statement Vs Hs Gs Steps Ty Pf Rs]: the lemma's type and its proof; the
% hypotheses of the statement are named after the name written after them,
% or H1, H2, ...
pred statement i:list element, i:list (pair element (option string)),
  i:list element, i:list step, o:term, o:term, o:list report.
statement [elt rvar S | Vs] Hs Gs Steps Ty Pf Rs :-
  P is "Context (" ^ S ^ ")",
  std.assert-ok! (coq.parse.argument P ff "" (ctx-decl C))
    {calc ("cyp: the variables of the statement do not parse: " ^ S)},
  statement-ctx C Vs Hs Gs Steps Ty Pf Rs.
statement [] Hs Gs Steps Ty Pf Rs :- statement-hyps 1 Hs Gs Steps Ty Pf Rs.

pred statement-ctx i:context-decl, i:list element,
  i:list (pair element (option string)), i:list element, i:list step,
  o:term, o:term, o:list report.
statement-ctx context-end Vs Hs Gs Steps Ty Pf Rs :- statement Vs Hs Gs Steps Ty Pf Rs.
statement-ctx (context-item Id _ T _ C) Vs Hs Gs Steps (prod Nm T TyR) (fun Nm T PfR) Rs :-
  coq.id->name Id Nm,
  pi x\ decl x Nm T => statement-ctx (C x) Vs Hs Gs Steps (TyR x) (PfR x) Rs.

pred statement-hyps i:int, i:list (pair element (option string)), i:list element,
  i:list step, o:term, o:term, o:list report.
statement-hyps _ [] Gs Steps G Pf Rs :-
  claim-terms Gs Cs Bad,
  std.assert! (Bad = [], Cs = [_ | _]) "cyp: the conclusion of the statement does not parse",
  conj Cs G, level "0" none Steps G Pf Rs.
statement-hyps J [pr E Nm0 | Hs] Gs Steps (prod Nm A TyR) (fun Nm A PfR) Rs :-
  std.assert-ok! (parse E A) "cyp: a hypothesis of the statement does not parse",
  (Nm0 = some S, ! ; S is "H" ^ {std.any->string J}), coq.id->name S Nm,
  J1 is J + 1,
  pi h\ decl h Nm A => statement-hyps J1 Hs Gs Steps (TyR h) (PfR h) Rs.

% A proof: its statement and its steps, turned into a Rocq proof.
%
% A proof is a verification condition generator: each step gives
% conditions, goals in their own context (the variables and hypotheses of
% the statement, the claims of the steps before it, and the variables,
% hypotheses and definitions of the scopes it is in; a claim is a
% hypothesis, whatever its proof).  Each condition is discharged by the
% rules or the default tactics; in proof mode (proof-mode), one that is not
% becomes a goal of the Proof block.  Conditions are numbered after their
% step, in Dewey notation: 2.1 is the first sub-step of step 2, 2a and 2b
% the two claims of step 2, 0 the statement after the steps.
% The proof term:
%   a forward step with claim C:   cyp_have C G P (fun c : C => ...) (C
%                                  proved by P, by its sub-steps if any);
%   a backward step with claim C:  (P : C -> G) (proof of C by the rest);
%   a scope (Let `x : T`, Assume `A`, Let `u := e`, no claim): its body
%   (its sub-steps, or else the steps after it) is proved under those
%   binders, and each claim C of the body is known after the scope as
%   forall x, A -> C (a projection of the body's proof);
%   the end of a list of steps: its goal, by the default tactics, or by
%   the justification of the step whose sub-steps they are.

% a step: its number (Dewey), its elements, its justification, its sub-steps
kind step type.
type step string -> list element -> option string -> list step -> step.

% ------------------------------------------------------------------ %
% Declarations: each variable, hypothesis, claim or definition of the
% proof is declared with its name recorded (under-decl, under-def), so
% that a hypothesis with no name gets one that nothing in scope has
% (hyp-name).  (Rocq-Elpi's decl cannot be listed: its first argument is
% an input.)

% [name-in-scope S]: S is the name of something declared in scope
pred name-in-scope o:string.

% [under-decl Nm T G]: G x, for a new variable x : T named Nm, declared in
% the context with its name recorded
pred under-decl i:name, i:term, i:(term -> prop).
under-decl Nm T G :- coq.name->id Nm Id, pi x\ (decl x Nm T, name-in-scope Id) => G x.

% [under-def Nm T B G]: G x, for a new local definition x : T := B named
% Nm, declared in the context with its name recorded
pred under-def i:name, i:term, i:term, i:(term -> prop).
under-def Nm T B G :- coq.name->id Nm Id, pi x\ (def x Nm T B, name-in-scope Id) => G x.

% [under-context C Ty Pf G]: Ty = forall x1 .. xn, T and Pf = fun x1 ..
% xn => P, for the variables x1 .. xn of the context C (read by
% coq.parse: "x y : nat"), each declared by under-decl, with G T P under
% them
pred under-context i:context-decl, o:term, o:term, i:(term -> term -> prop).
under-context context-end Ty Pf G :- G Ty Pf.
under-context (context-item Id _ T _ C) (prod Nm T TyR) (fun Nm T PfR) G :-
  coq.id->name Id Nm,
  under-decl Nm T (x\ under-context (C x) (TyR x) (PfR x) G).

% [current-scope Sc]: the notation scope of the formulas (the header's
% scope:), "" for none
pred current-scope o:string.

% the report of a step
kind status type.
type ok status.
type ko string -> status.               % the goal not proved
type bad string -> status.              % a formula that does not parse
type todo string -> status.             % a goal left to the Proof block
kind report type.
type rep string -> status -> report.    % the number of a condition

% proof mode: the conditions not discharged are left to the Proof block
pred proof-mode.
% bare mode: no condition is tried; each is printed with its context and
% left as a hole (implies proof mode)
pred bare-mode.

% the condition I of step S: S itself if it is the only one, else S
% followed by a letter
pred condition-id i:string, i:int, i:int, o:string.
condition-id S _ 1 S :- !.
condition-id S I _ Id :- letter I L, Id is S ^ L.
% [letter I L]: the I-th letter of the alphabet, a for 1
pred letter i:int, o:string.
letter I L :-
  std.nth {calc (I - 1)} ["a","b","c","d","e","f","g","h","i","j","k","l","m",
    "n","o","p","q","r","s","t","u","v","w","x","y","z"] L.

% the step of a condition: its number without the letter
pred step-of i:string, o:string.
step-of Id S :- rex.replace "[a-z]$" "" Id S.

% ------------------------------------------------------------------ %
% Formulas

% [parse E T]: the term of a formula, in the current context
pred parse i:element, o:term, o:diagnostic.
parse (elt _ S) T D :-
  current-scope Sc, P is "(" ^ S ^ ")",
  coq.parse.argument P ff Sc A D, (D = ok, A = trm T ; true), !.
parse (eltt _ T0) T D :- coq.elaborate-skeleton T0 _ T D.

% [variables S C D]: the variables S of a Let (e.g. "a b : Z"), as a
% context C, in the current context; D the diagnostic.  The declaration
% "Context (S)" is parsed raw and its types elaborated here: elaborated by
% coq.parse.argument, a Context keeps only its own universes in the
% universe state (Rocq's interp_context restricts the state to them), so
% the universes of the formulas parsed before it would be lost and the
% lemma could not be defined ("Universe ... undefined").
pred variables i:string, o:context-decl, o:diagnostic.
variables S C D :-
  P is "Context (" ^ S ^ ")",
  coq.parse.argument P tt "" A D0,
  if (D0 = ok, A = ctx-decl R) (elaborate-context R C D) (D = D0).

% [elaborate-context R C D]: the raw context R elaborated, each variable
% known to the types after it
pred elaborate-context i:context-decl, o:context-decl, o:diagnostic.
elaborate-context context-end context-end ok.
elaborate-context (context-item Id Imp T0 none R) (context-item Id Imp T none C) D :-
  coq.elaborate-ty-skeleton T0 _ T D0,
  if (D0 = ok)
     (coq.id->name Id N,
      under-decl N T (x\ elaborate-context (R x) (C x) D))
     (D = D0).
elaborate-context (context-item Id Imp T0 (some B0) R) (context-item Id Imp T (some B) C) D :-
  coq.elaborate-ty-skeleton T0 _ T D0,
  if (D0 = ok) (coq.elaborate-skeleton B0 T B D1) (D1 = D0),
  if (D1 = ok)
     (coq.id->name Id N,
      under-def N T B (x\ elaborate-context (R x) (C x) D))
     (D = D1).

% [is-prop T]: the term T is a proposition
pred is-prop i:term.
is-prop T :- coq.typecheck T Ty ok, coq.unify-eq Ty (sort prop) ok.

% [conj Cs C]: the conjunction C of the non-empty list Cs, C1 /\ (C2 /\ ...)
pred conj i:list term, o:term.
conj [C] C :- !.
conj [C | L] {{ lp:C /\ lp:R }} :- conj L R.

% the parts of a step
pred claims i:list element, o:list element.
claims L C :- std.filter L is-claim C.
% [is-claim E]: the element E is a claim, forward or backward
pred is-claim i:element.
is-claim (elt rclaim _).
is-claim (elt rback _).
is-claim (eltt rclaim _).
is-claim (eltt rback _).
% [binders Es Vs]: the variables (and definitions) introduced by the
% elements Es
pred binders i:list element, o:list element.
binders L C :- std.filter L is-var C.
% [is-var E]: the element E introduces variables
pred is-var i:element.
is-var (elt rvar _).
% [backward Es]: the step of elements Es is backward: one of its claims
% replaces the goal
pred backward i:list element.
backward L :- std.exists L is-back.
% [is-back E]: the element E is a backward claim
pred is-back i:element.
is-back (elt rback _).
is-back (eltt rback _).

% the hypotheses of a step, with the name written after each, if any
pred hyps i:list element, o:list (pair element (option string)).
hyps [] [].
hyps [E | L] [pr E Name | H] :- is-hyp E, !, name-after L Name L1, hyps L1 H.
hyps [_ | L] H :- hyps L H.
% [is-hyp E]: the element E is a hypothesis
pred is-hyp i:element.
is-hyp (elt rhyp _).
is-hyp (eltt rhyp _).
% [name-after L Name Rest]: the name at the head of the elements L, hname
% N (Name = some N; none if L starts with no name), and the elements
% after it
pred name-after i:list element, o:option string, o:list element.
name-after [hname N | L] (some N) L :- !.
name-after L none L.

% the claims of a step as terms; those that are not propositions are
% mentions; Bad: the formulas that do not parse
pred claim-terms i:list element, o:list term, o:list string.
claim-terms [] [] [].
claim-terms [E | L] Ts Bad :-
  parse E T D,
  if (D = ok)
     (if (is-prop T) (Ts = [T | Ts1]) (Ts = Ts1), Bad = Bad1)
     (D = error M, Ts = Ts1, Bad = [M | Bad1]),
  claim-terms L Ts1 Bad1.

% ------------------------------------------------------------------ %
% Proving a step

% [step-proof Tac I T P R]: the condition I, of type T, proved by P or
% else left to the Proof block or not proved; with CYP_TIME set, the time
% spent on it is printed
pred step-proof i:option string, i:string, i:term, o:term, o:report.
step-proof Tac I T P R :-
  gettimeofday T0, condition-proof Tac I T P R, gettimeofday T1,
  say-time I {calc (T1 - T0)}.

% [condition-proof Tac I T P R]: as step-proof, without the timing
pred condition-proof i:option string, i:string, i:term, o:term, o:report.
condition-proof _ I T P (rep I (todo S)) :- bare-mode, !,
  condition-hole I T P, coq.term->string T S.
condition-proof Tac I T P (rep I ok) :- prove Tac T P, !.
condition-proof _ I T P (rep I (todo S)) :- proof-mode, !,
  condition-hole I T P, coq.term->string T S.
condition-proof _ I T _ (rep I (ko S)) :- coq.term->string T S.

% a hole for the condition I, of type T: a goal of the Proof block, named
% after the condition (condition-ident: the goal of 2.1b is ?c2_1b)
pred condition-hole i:string, i:term, o:term.
condition-hole I T H :-
  coq.typecheck H T ok, coq.ltac.name-uvar H {condition-ident I}.

% the identifier of condition Id: c followed by its number, dots as _
% (2.1b gives c2_1b; a Rocq name cannot begin with a digit nor hold a
% dot); the name of its goal in the Proof block and of its claim in the
% goals after it
pred condition-ident i:string, o:id.
condition-ident Id N :- rex.replace "[.]" "_" Id S, N is "c" ^ S.

% the hypothesis of claim Id, named by condition-ident
pred claim-name i:string, o:name.
claim-name Id N :- coq.id->name {condition-ident Id} N.

% What a step does, by its elements (step-kind): level and open-level
% prove a list of steps with and without a goal, each by its kind.
kind step-kind type.
type unparsed string -> step-kind.           % a formula does not parse (the messages)
type opens-scope list element -> list (pair element (option string)) -> step-kind.
                                             % variables or hypotheses and no claim
type comment step-kind.                      % no variable, hypothesis or claim
type backward-claim term -> step-kind.       % the claims (their conjunction)
                                             % replace the goal
type forward-claims list term -> step-kind.  % the claims, proved and then known

% [step-kind Es K]: the kind of the step of elements Es; its claims are
% parsed in the current context (a claim that is not a proposition is a
% mention, claim-terms)
pred step-kind i:list element, o:step-kind.
step-kind Es K :-
  claims Es Cs0, claim-terms Cs0 Cs Bad,
  binders Es Vs, hyps Es Hs,
  if (Bad = [_ | _]) (std.string.concat "; " Bad M, K = unparsed M)
  (if (Cs = [], (Vs = [_ | _] ; Hs = [_ | _])) (K = opens-scope Vs Hs)
  (if (Cs = []) (K = comment)
  (if (backward Es) (conj Cs C, K = backward-claim C) (K = forward-claims Cs)))).

% [scope-parts Ch Rest Body After]: the body of a scope is its sub-steps
% Ch, or else, when it has none, the steps Rest after it; After: the
% steps after the body
pred scope-parts i:list step, i:list step, o:list step, o:list step.
scope-parts [] Rest Rest [] :- !.
scope-parts Ch Rest Ch Rest.

% [level Own OTac Steps G P Rs]: P proves G from the steps, in the current
% context; the last condition (G follows) belongs to the step Own and is
% closed by its justification OTac
pred level i:string, i:option string, i:list step, i:term, o:term, o:list report.
level Own OTac [] G P [R] :- step-proof OTac Own G P R.
level Own OTac [step I Es Tac Ch | Rest] G P Rs :-
  step-kind Es K, level-step K I Tac Ch Rest Own OTac G P Rs.

% [level-step K I Tac Ch Rest Own OTac G P Rs]: as level, for the step I
% of kind K, with its justification Tac and its sub-steps Ch, followed by
% the steps Rest
pred level-step i:step-kind, i:string, i:option string, i:list step, i:list step,
  i:string, i:option string, i:term, o:term, o:list report.
% a formula does not parse: the step is reported, and skipped
level-step (unparsed M) I _ Ch Rest Own OTac G P [rep I (bad M) | Rs] :-
  level Own OTac {std.append Ch Rest} G P Rs.
% a scope: its body, then the steps after it
level-step (opens-scope Vs Hs) I _ Ch Rest Own OTac G P Rs :-
  scope-parts Ch Rest Body After,
  scope Vs Hs Body ExTy ExPf N Rs1,
  if (N = 0) (level Own OTac After G P Rs2)
             (shared I ExTy G ExPf N (e\ p\ exports I ExTy e 1 N [] (prove-goal Own OTac After G) p Rs2) P),
  std.append Rs1 Rs2 Rs.
level-step comment _ _ Ch Rest Own OTac G P Rs :-
  level Own OTac {std.append Ch Rest} G P Rs.
% the new goal C implies G; the sub-steps and the rest prove C
level-step (backward-claim C) I Tac Ch Rest Own OTac G (app [P1, P2]) [R1 | Rs] :-
  step-proof Tac I (prod `_` C (_\ G)) P1 R1,
  level Own OTac {std.append Ch Rest} C P2 Rs.
% the claims one after the other, each knowing those before it
level-step (forward-claims Cs) I Tac [] Rest Own OTac G P Rs :- !,
  std.length Cs NC, claims-then I 1 NC Tac Cs [] (prove-goal Own OTac Rest G) P Rs.
% with sub-steps: the conjunction of the claims proved by them, and then
% each claim on its own
level-step (forward-claims Cs) I Tac Ch Rest Own OTac G P Rs :-
  std.length Cs NC, conj Cs C,
  level I Tac Ch C P1 Rs1,
  shared I C G P1 NC (e\ p\ exports I C e 1 NC [] (prove-goal Own OTac Rest G) p Rs2) P,
  std.append Rs1 Rs2 Rs.

% What comes after the claims of a step, once they are hypotheses: the
% rest of the steps, with a goal (level) or with none (open-level)
kind after-claims type.
type prove-goal string -> option string -> list step -> term -> after-claims.
                          % level Own OTac Steps G: the steps prove G
type collect-claims list step -> term -> int -> after-claims.
                          % open-level: the steps' claims, Ty their
                          % conjunction (with those known), N their number

% [after-claims-goal A G]: the goal of the proof after the claims: G, or
% the conjunction of the claims, Ty
pred after-claims-goal i:after-claims, o:term.
after-claims-goal (prove-goal _ _ _ G) G.
after-claims-goal (collect-claims _ Ty _) Ty.

% [prove-after-claims A Known P Rs]: P proves the goal of A by the rest of
% the steps; Known: the claims known (their types and the variables
% naming them), kept by open-level
pred prove-after-claims i:after-claims, i:list (pair term term), o:term, o:list report.
prove-after-claims (prove-goal Own OTac Steps G) _ P Rs :- level Own OTac Steps G P Rs.
prove-after-claims (collect-claims Steps Ty N) Known P Rs :- open-level Known Steps Ty P N Rs.

% [claims-then S J N Tac Cs Known A P Rs]: the claims J.. of the N claims
% Cs of step S, each proved and then a hypothesis (added to Known), then
% what comes after them, A
pred claims-then i:string, i:int, i:int, i:option string, i:list term,
  i:list (pair term term), i:after-claims, o:term, o:list report.
claims-then _ _ _ _ [] Known A P Rs :- prove-after-claims A Known P Rs.
claims-then S J N Tac [C | Cs] Known A {{ cyp_have lp:C lp:G lp:P1 lp:K }} [R | Rs] :-
  after-claims-goal A G,
  condition-id S J N Id,
  step-proof Tac Id C P1 R,
  claim-name Id Nm, J1 is J + 1,
  K = fun Nm C P2,
  under-decl Nm C (x\ claims-then S J1 N Tac Cs [pr C x | Known] A (P2 x) Rs).

% ------------------------------------------------------------------ %
% Scopes

% [scope Vs Hs Body ExTy ExPf N Rs]: under the variables, definitions
% and hypotheses, the N claims of Body: ExTy = forall .., C1 /\ .. /\ CN
% (let for a definition), ExPf its proof
pred scope i:list element, i:list (pair element (option string)),
  i:list step, o:term, o:term, o:int, o:list report.
scope [] [] Body Ty Pf N Rs :- open-level [] Body Ty Pf N Rs.
scope [elt rvar S | Vs] Hs Body Ty Pf N Rs :- rex.match ".*:=" S, !,
  % a definition u := e (or u : T := e)
  P is "Definition " ^ S,
  std.assert-ok! (coq.parse.argument P ff {current-scope} (const-decl Id (some Bo) Ar))
    {msg "definition-not-parsed" [S]},
  coq.arity->term Ar T, coq.id->name Id Nm,
  Ty = let Nm T Bo TyR, Pf = let Nm T Bo PfR,
  under-def Nm T Bo (x\ scope Vs Hs Body (TyR x) (PfR x) N Rs).
scope [elt rvar S | Vs] Hs Body Ty Pf N Rs :-
  std.assert-ok! (variables S C) {msg "variables-not-parsed" [S]},
  under-context C Ty Pf (ty\ pf\ scope Vs Hs Body ty pf N Rs).
scope [] [pr E Nm0 | Hs] Body (prod Nm A TyR) (fun Nm A PfR) N Rs :-
  std.assert-ok! (parse E A) {msg "hypothesis-not-parsed" []},
  hyp-name Nm0 Nm,
  under-decl Nm A (h\ scope [] Hs Body (TyR h) (PfR h) N Rs).

% [hyp-name Given Name]: the name of a hypothesis: the one the text gives
% it, else the first of H1, H2, ... that no variable, hypothesis or claim
% in scope has, so that every name in scope names one hypothesis (Rocq
% would rename a second H behind the text's back)
pred hyp-name i:option string, o:name.
hyp-name (some S) N :- !, coq.id->name S N.
hyp-name none N :- names-in-scope Used, prooftext.numbered-name Used "H" 1 S, coq.id->name S N.

% [names-in-scope Used]: the names of the variables, hypotheses, claims and
% definitions declared so far
pred names-in-scope o:list string.
names-in-scope Used :- std.findall (name-in-scope _) L, std.map L (c\ s\ c = name-in-scope s) Used.

% [open-level Acc Steps Ty Pf N Rs]: the claims of the steps, with no goal;
% Acc the claims so far (their types and the variables naming them)
pred open-level i:list (pair term term), i:list step, o:term, o:term,
  o:int, o:list report.
open-level Acc [] Ty Pf N [] :-
  std.rev Acc Acc1, std.length Acc1 N,
  std.map Acc1 fst Ts, std.map Acc1 snd Ps,
  (N = 0, Ty = {{ True }}, Pf = {{ I }} ; conj Ts Ty, conj-proof Ts Ps Pf), !.
open-level Acc [step I Es Tac Ch | Rest] Ty Pf N Rs :-
  step-kind Es K, open-level-step K I Tac Ch Rest Acc Ty Pf N Rs.

% [open-level-step K I Tac Ch Rest Acc Ty Pf N Rs]: as open-level, for the
% step I of kind K, with its justification Tac and its sub-steps Ch,
% followed by the steps Rest
pred open-level-step i:step-kind, i:string, i:option string, i:list step,
  i:list step, i:list (pair term term), o:term, o:term, o:int, o:list report.
% a formula does not parse: the step is reported, and skipped
open-level-step (unparsed M) I _ Ch Rest Acc Ty Pf N [rep I (bad M) | Rs] :-
  open-level Acc {std.append Ch Rest} Ty Pf N Rs.
% a scope: its body, then the steps after it
open-level-step (opens-scope Vs Hs) I _ Ch Rest Acc Ty Pf N Rs :-
  scope-parts Ch Rest Body After,
  scope Vs Hs Body ExTy ExPf N0 Rs1,
  shared I ExTy Ty ExPf N0 (e\ p\ exports I ExTy e 1 N0 Acc (collect-claims After Ty N) p Rs2) Pf,
  std.append Rs1 Rs2 Rs.
open-level-step comment _ _ Ch Rest Acc Ty Pf N Rs :-
  open-level Acc {std.append Ch Rest} Ty Pf N Rs.
% a backward step needs a goal: it is reported, and skipped with its
% sub-steps
open-level-step (backward-claim _) I _ _ Rest Acc Ty Pf N [rep I (bad M) | Rs] :-
  msg "backward-no-goal" [] M,
  open-level Acc Rest Ty Pf N Rs.
% the claims one after the other, each knowing those before it
open-level-step (forward-claims Cs) I Tac [] Rest Acc Ty Pf N Rs :- !,
  std.length Cs NC, claims-then I 1 NC Tac Cs Acc (collect-claims Rest Ty N) Pf Rs.
% with sub-steps: the conjunction of the claims proved by them, and then
% each claim on its own
open-level-step (forward-claims Cs) I Tac Ch Rest Acc Ty Pf N Rs :-
  std.length Cs NC, conj Cs C,
  level I Tac Ch C P1 Rs1,
  shared I C Ty P1 NC (e\ p\ exports I C e 1 NC Acc (collect-claims Rest Ty N) p Rs2) Pf,
  std.append Rs1 Rs2 Rs.

% [conj-proof Ts Ps P]: the proof P of the conjunction of Ts (conj) from the
% proofs Ps of its members
pred conj-proof i:list term, i:list term, o:term.
conj-proof [_] [P] P :- !.
conj-proof [A | Ts] [P | Ps] {{ @conj lp:A lp:B lp:P lp:Q }} :-
  conj Ts B, conj-proof Ts Ps Q.

% ------------------------------------------------------------------ %
% The claims of a scope, known after it

% [proj-type ExTy I N T]: forall .., Ci from forall .., C1 /\ .. /\ CN
pred proj-type i:term, i:int, i:int, o:term.
proj-type (prod Nm A B) I N (prod Nm A B1) :- !, pi x\ proj-type (B x) I N (B1 x).
proj-type (let Nm A V B) I N (let Nm A V B1) :- !, pi x\ proj-type (B x) I N (B1 x).
proj-type B I N T :- component B I N T.

% [component B I N T]: the I-th of the N members T of the conjunction B
pred component i:term, i:int, i:int, o:term.
component B _ 1 B :- !.
component {{ lp:A /\ _ }} 1 _ A :- !.
component {{ _ /\ lp:R }} I N T :- I1 is I - 1, N1 is N - 1, component R I1 N1 T.

% [proj-proof ExTy E I N P]: P proves proj-type ExTy I N from E : ExTy
pred proj-proof i:term, i:term, i:int, i:int, o:term.
proj-proof (prod Nm A B) E I N (fun Nm A P) :- !,
  pi x\ proj-proof (B x) {coq.mk-app E [x]} I N (P x).
proj-proof (let Nm A V B) E I N (let Nm A V P) :- !,
  under-def Nm A V (x\ proj-proof (B x) E I N (P x)).
proj-proof B E I N P :- component-proof B E I N P.

% [component-proof B E I N P]: the proof P of the I-th of the N members of
% the conjunction B, from a proof E of B (proj1, proj2)
pred component-proof i:term, i:term, i:int, i:int, o:term.
component-proof _ E _ 1 E :- !.
component-proof {{ lp:A /\ lp:R }} E 1 _ {{ @proj1 lp:A lp:R lp:E }} :- !.
component-proof {{ lp:A /\ lp:R }} E I N P :-
  I1 is I - 1, N1 is N - 1,
  component-proof R {{ @proj2 lp:A lp:R lp:E }} I1 N1 P.

% [shared S ExTy G ExPf N Use P]: P proves G by [Use E P'] with E a proof
% of ExTy, the N claims of a scope or of the step S with sub-steps.  With
% several claims, ExPf is given once to cyp_have and E is the variable that
% names it: each claim is then a projection of that variable, instead of a
% projection of its own copy of ExPf (copies that double the proof term at
% each nested level, and so its type-check and definition).  The variable
% is not declared in the context of the conditions: it is not one of the
% claims, and no condition refers to it.
pred shared i:string, i:term, i:term, i:term, i:int, i:(term -> term -> prop), o:term.
shared _ _ _ ExPf N Use P :- N < 2, !, Use ExPf P.
shared S ExTy G ExPf _ Use {{ cyp_have lp:ExTy lp:G lp:ExPf lp:K }} :-
  claim-name S Nm, K = fun Nm ExTy P,
  pi e\ Use e (P e).

% [exports S ExTy ExPf I N Known A P Rs]: the claims I..N of a scope or of
% a step S with sub-steps, as hypotheses named after S (added to Known),
% then what comes after them, A (claims-then)
pred exports i:string, i:term, i:term, i:int, i:int,
  i:list (pair term term), i:after-claims, o:term, o:list report.
exports _ _ _ I N Known A P Rs :- I > N, !, prove-after-claims A Known P Rs.
exports S ExTy ExPf I N Known A {{ cyp_have lp:T lp:G lp:Pi lp:K }} Rs :-
  after-claims-goal A G,
  proj-type ExTy I N T, proj-proof ExTy ExPf I N Pi,
  condition-id S I N Id, claim-name Id Nm, I1 is I + 1,
  K = fun Nm T P,
  under-decl Nm T (x\ exports S ExTy ExPf I1 N [pr T x | Known] A (P x) Rs).

% ------------------------------------------------------------------ %
% The statement

% [statement Vs Hs Gs Steps Ty Pf Rs]: the lemma's type and its proof; the
% hypotheses of the statement are named after the name written after them,
% or H1, H2, ...
pred statement i:list element, i:list (pair element (option string)),
  i:list element, i:list step, o:term, o:term, o:list report.
statement [elt rvar S | Vs] Hs Gs Steps Ty Pf Rs :-
  std.assert-ok! (variables S C) {msg "statement-variables-not-parsed" [S]},
  under-context C Ty Pf (ty\ pf\ statement Vs Hs Gs Steps ty pf Rs).
statement [] Hs Gs Steps Ty Pf Rs :- statement-hyps Hs Gs Steps Ty Pf Rs.

% [statement-hyps Hs Gs Steps Ty Pf Rs]: the hypotheses Hs of the statement,
% then its conclusion Gs proved by the steps
pred statement-hyps i:list (pair element (option string)), i:list element,
  i:list step, o:term, o:term, o:list report.
statement-hyps [] Gs Steps G Pf Rs :-
  claim-terms Gs Cs Bad,
  std.assert! (Bad = [], Cs = [_ | _]) {msg "conclusion-not-parsed" []},
  conj Cs G, level "0" none Steps G Pf Rs.
statement-hyps [pr E Nm0 | Hs] Gs Steps (prod Nm A TyR) (fun Nm A PfR) Rs :-
  std.assert-ok! (parse E A) {msg "statement-hypothesis-not-parsed" []},
  hyp-name Nm0 Nm,
  under-decl Nm A (h\ statement-hyps Hs Gs Steps (TyR h) (PfR h) Rs).

% cyp's messages in English: [message Lang Key Template], %1, %2, ... the
% arguments.  The messages of the other languages are in messages_xx.elpi;
% a message missing in a language is given in English.  The prefix cyp: is
% the program's tag, the same in every language (the driver shows the
% lines that carry it).
message "en" "proved" "cyp: %1 proved, %2 steps".
message "en" "proved-lemma" "cyp: %1 proved".
message "en" "not-proved" "cyp: %1 of %2 steps of %3 not proved (%4), see %5".
message "en" "conditions" "cyp: %1, %2 steps, %3 conditions".
message "en" "all-discharged" "cyp: %1, %2 steps, every condition discharged".
message "en" "left" "cyp: %1, %2 steps, %3 condition(s) left for the Proof block: %4".
message "en" "left-line" "  🔶 condition %1: %2".
message "en" "no-typecheck" "cyp: the proof does not type-check".
message "en" "holes" "cyp: some conditions are not proved".
message "en" "errors" "cyp: %1, %2 node(s) with an error (❌ above): %3".
message "en" "statement-not-read" "cyp: the statement of %1 cannot be read: %2".
message "en" "statement-no-typecheck" "cyp: the statement does not type-check".
message "en" "md-not-proved" "not proved: %1".
message "en" "md-not-parsed" "does not parse: %1".
message "en" "md-todo" "condition %1, to prove in the Proof block: %2".
message "en" "time" "cyp: time %1 %2 ms".
message "en" "time-condition" "cyp: time %1 %2 ms, %3".
message "en" "time-slowest" "cyp: time of the %1 conditions: %2 ms; the slowest:".
message "en" "time-slow-line" "cyp:   %1  %2 ms  %3  | %4".
message "en" "header-key-ignored" "cyp: the header line %1: is ignored, %1 is no key of a header".
message "en" "definition-not-parsed" "the definition %1 does not parse".
message "en" "variables-not-parsed" "the variables %1 do not parse: %2".
message "en" "hypothesis-not-parsed" "the hypothesis %1 does not parse: %2".
message "en" "conclusion-not-prop" "the conclusion %1 is not a proposition".
message "en" "fact-unknown" "the fact %1 is no hypothesis or conclusion visible here".
message "en" "name-unknown" "%1 names nothing known: no hypothesis, node, lemma or declared justification word (declare it: CypJustification \"%1\" := tactic. or := rules.)".
message "en" "at-line" "line %1: %2".
% the errors of the tree are prooftext's (prooftext/nodes.elpi,
% error-template), in English; their keys may be translated here
% the open goals of a text ({.goal}) and the fixed methods (*match*,
% *induction*)
message "en" "goal-line" "  🔶 open goal %1 of the text: %2".
message "en" "md-goal" "open goal of the text, not tried: condition %1, to prove in the Proof block: %2".
message "en" "method-no-object" "*%1*{.just} names nothing to eliminate: name the hypothesis or the variable (*h*{.just}), or its type (*T*{.just})".
message "en" "type-objects" "no single hypothesis or variable of type %1 in scope to eliminate (%2 found): name it".
message "en" "not-of-type" "%1 is not of type %2".
message "en" "type-alone" "%1 is an inductive type: it justifies a step only with *match*{.just} or *induction*{.just}".
% the debugging tools (elpi/stats.elpi)
message "en" "stats-condition" "cyp: stats %1 %2 ms, %3 hyps=%4, %5".
message "en" "stats-heaviest" "cyp: stats of the %1 conditions: %2 matches, %3 nodes; the heaviest by %4:".
message "en" "stats-heavy-line" "cyp:   %1  %2  %3 ms  %4  | %5".
message "en" "stats-whole" "cyp: stats %1 %2".
message "en" "extracted" "cyp: condition %1 written to %2".
message "en" "no-condition" "cyp: %2 has no condition %1".
message "en" "extract-holes" "cyp: condition %1: %2 hole(s) in its context, printed _ (a formula whose implicit arguments another step fixes): the file may not compile".

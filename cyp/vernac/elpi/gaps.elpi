% The coarse gap tactic: a last try on a condition that its justification,
% the rules and the default tactics leave open.
%
% A short text skips intermediate formulas, so that the claim of a step no
% longer follows from the step before it by one rule.  The gap tactic is
% the Ltac tactic cyp_gap of Gaps.v: a few bounded searches (no time
% limit), so that a condition it cannot close costs a bounded number of
% steps.
%
% A proof turns it off with the header line  gaps: off  (Cyp File), or the
% attribute #[gaps="off"] (Cyp File, Cyp Lemma).

% [gaps-off]: the gap tactic is not tried
pred gaps-off.
gaps-off :- attributes A, std.mem A (attribute "gaps" (leaf-str "off")), !.

% the header line gaps: off, as a clause of gaps-off
pred gaps-clauses i:string, o:list prop.
gaps-clauses "off" [gaps-off] :- !.
gaps-clauses _ [].

% [gap-justification M]: the conditions the gap tactic may close: those
% whose justifications name no rule (a node justified by named rules,
% *monotonicity*{.just}, is closed by them only)
pred gap-justification i:method.
gap-justification (method Ms _ _) :- not (std.exists Ms (m\ named m _ _)).

% [close-gap M G]: the condition G, closed by the method M, closed by the
% gap tactic
pred close-gap i:method, i:goal, o:list sealed-goal.
close-gap M G [] :-
  not gaps-off, gap-justification M, coq.ltac.call-ltac1 "cyp_gap" G [].

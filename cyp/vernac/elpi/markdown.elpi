% A cyp proof in Markdown: reading it, and writing it back checked.
%
%   ---
%   scope: Z            the notation scope of the formulas (name or key)
%   by: lia | nia       the default tactics of the proof
%   lang: en            the language of the text (en, fr, it)
%   gaps: off           no gap tactic (gaps.elpi)
%   ---
%   # name
%   The statement: Let `x : T`. If `A` (h) then `C`.
%   - a step
%     - a sub-step
%
% The other fields of the header (require:, rules:, flags:) are for the
% driver: the libraries and the rules are loaded by the .v file.  The keys
% are those of prooftext/header.elpi.

% The text is read by prooftext's reader (prooftext/document.elpi,
% read-document), into its document: the fields of the header, the name,
% the statement, the tree of steps (prooftext.step), with their lines.

% [field Fields Key Value]: the value of the field Key of the header, ""
% when there is none
pred field i:list prooftext.field, i:string, o:string.
field Fields Key Value :- std.mem Fields (prooftext.field Key Value), !.
field _ _ "".

% [dewey Prefix K Id]: the number of the K-th item of a list whose parent
% has the number Prefix ("" at the top): 2.1 is the first sub-step of 2
pred dewey i:string, i:int, o:string.
dewey "" K Id :- !, Id is {std.any->string K}.
dewey P K Id :- Id is P ^ "." ^ {std.any->string K}.

% the steps of a tree, numbered in Dewey notation
pred steps-of i:string, i:int, i:list prooftext.step, o:list step.
steps-of _ _ [] [].
steps-of P K [prooftext.step _ T Ch | Ns] [step Id Es Tac Sub | Ss] :-
  justification T Tac T1, pieces T1 Pc, elements Pc rclaim Es,
  dewey P K Id, steps-of Id 1 Ch Sub, K1 is K + 1, steps-of P K1 Ns Ss.

% ------------------------------------------------------------------ %
% The checked Markdown and the JSON

% the status of step S: of its conditions (S, or S with a letter), the worst
pred status-of i:list report, i:string, o:string, o:string.
status-of Rs S "ko" M :- std.mem Rs (rep I (ko G)), step-of I S, !, msg "md-not-proved" [G] M.
status-of Rs S "ko" M :- std.mem Rs (rep I (bad E)), step-of I S, !, msg "md-not-parsed" [E] M.
status-of Rs S "todo" M :-
  std.findall (std.mem Rs (rep I (todo _)), step-of I S) L, L = [_ | _], !,
  std.map L (x\ m\ sigma I G\ x = (std.mem Rs (rep I (todo G)), step-of I S),
    msg "md-todo" [I, G] m) Ms,
  std.string.concat "; " Ms M.
status-of Rs S "ok" "" :- std.mem Rs (rep I ok), step-of I S, !.
status-of _ _ "none" "".

% the conditions of step S left to the Proof block
pred todo-ids i:list report, i:string, o:list string.
todo-ids Rs S Ts :-
  std.filter Rs (r\ sigma I G\ r = rep I (todo G), step-of I S) L,
  std.map L (r\ i\ sigma G\ r = rep i G) Ts.

pred write-md i:string, i:list prooftext.field, i:string, i:string,
  i:list prooftext.step, i:list report.
write-md Out H Name Stmt Ns Rs :-
  open_out Out O,
  prooftext.header-lines H HeaderLines,
  std.forall HeaderLines (l\ output O {calc (l ^ "\n")}), output O "\n",
  output O {calc ("# " ^ Name ^ "\n\n")},
  status-of Rs "0" S M, prooftext.status-mark S Mk,
  output O {calc (Mk ^ " " ^ Stmt ^ "\n")}, details O "" M,
  output O "\n",
  write-nodes O "" "" 1 Ns Rs,
  close_out O.

pred details i:out_stream, i:string, i:string.
details _ _ "" :- !.
details O Pad M :-
  output O {calc ("\n" ^ Pad ^ {prooftext.message-block M} ^ "\n\n")}.

% [write-nodes O Pad P K Ns Rs]: the nodes, numbered as in steps-of; a step
% with a condition left shows its number
pred write-nodes i:out_stream, i:string, i:string, i:int, i:list prooftext.step, i:list report.
write-nodes _ _ _ _ [] _.
write-nodes O Pad P K [prooftext.step _ T Ch | Ns] Rs :-
  dewey P K Id, status-of Rs Id S M, prooftext.status-mark S Mk,
  (S = "todo", todo-ids Rs Id Ts, std.string.concat ", " Ts TS,
   Num is " " ^ {prooftext.conditions-mark TS} ; Num = ""), !,
  output O {calc (Pad ^ "- " ^ Mk ^ Num ^ " " ^ T ^ "\n")},
  details O {calc (Pad ^ "  ")} M,
  write-nodes O {calc (Pad ^ "  ")} Id 1 Ch Rs,
  K1 is K + 1, write-nodes O Pad P K1 Ns Rs.

% the JSON for the editor: per step its lines, status, formulas, message
pred json-string i:string, o:string.
json-string S J :-
  rex.replace "\\\\" "\\\\\\\\" S S1, rex.replace "\"" "\\\\\"" S1 S2,
  rex.replace "\n" "\\\\n" S2 S3, J is "\"" ^ S3 ^ "\"".

pred write-json i:string, i:int, i:int, i:list element, i:list prooftext.step, i:list report.
write-json Out F La SEs Ns Rs :-
  open_out Out O,
  output O "{\"steps\":[",
  json-step O "0" F La SEs Rs,
  json-nodes O "" 1 Ns Rs,
  output O "]}\n",
  close_out O.

pred json-step i:out_stream, i:string, i:int, i:int, i:list element, i:list report.
json-step O K F La Es Rs :-
  status-of Rs K S M,
  std.filter Es (e\ sigma R X\ e = elt R X) Fs,
  std.map Fs json-formula Js, std.string.concat "," Js J,
  (K = "0", Sep = "" ; Sep = ","), !,
  output O {calc (Sep ^ "{\"id\":\"" ^ K ^ "\",\"first\":" ^ {std.any->string F} ^ ",\"last\":" ^
     {std.any->string La} ^ ",\"status\":\"" ^ S ^ "\",\"formulas\":[" ^ J ^
     "],\"message\":" ^ {json-string M} ^ "}")}.

pred json-formula i:element, o:string.
json-formula (elt R X) J :-
  prooftext.role-tag R N, !, J is "{\"role\":\"" ^ N ^ "\",\"text\":" ^ {json-string X} ^ "}".

pred json-nodes i:out_stream, i:string, i:int, i:list prooftext.step, i:list report.
json-nodes _ _ _ [] _.
json-nodes O P K [prooftext.step (prooftext.lines F La) T Ch | Ns] Rs :-
  justification T _ T1, pieces T1 Pc, elements Pc rclaim Es,
  dewey P K Id, json-step O Id F La Es Rs,
  json-nodes O Id 1 Ch Rs, K1 is K + 1, json-nodes O P K1 Ns Rs.

% A cyp proof in Markdown: writing it back checked.
%
%   ---
%   scope: Z            the notation scope of the formulas (name or key)
%   by: lia | nia       the default tactics of the proof
%   lang: en            the language of cyp's messages
%   gaps: off           no gap tactic (gaps.elpi)
%   ---
%   # name
%   the statement and its proof: the tree of nodes
%
% The other fields of the header (require:, rules:, flags:) are for the
% driver: the libraries and the rules are loaded by the .v file.  The keys
% are those of prooftext/header.elpi.  The text is read by prooftext's
% reader (prooftext/tree.elpi, read-tree), into its tree of nodes, with
% their lines.

% ------------------------------------------------------------------ %
% The status of a node

% [status-of Rs Id Status M]: the status of node Id and its message: an
% error, a condition not proved, left to the Proof block, proved, or
% nothing to check (a remark)
pred status-of i:list report, i:string, o:string, o:string.
status-of Rs Id "ko" E :- std.mem Rs (rep Id (bad E)), !.
status-of Rs Id "ko" M :- std.mem Rs (rep Id (ko G)), !, msg "md-not-proved" [G] M.
status-of Rs Id "todo" M :- std.mem Rs (rep Id (todo G)), !, msg "md-todo" [Id, G] M.
status-of Rs Id "ok" "" :- std.mem Rs (rep Id ok), !.
status-of _ _ "none" "".

% ------------------------------------------------------------------ %
% The checked Markdown: the lines of the text, each node with the mark of
% its status at the start of its own text (and, for a condition left to
% the Proof block, its number), and its message in a folded block after
% the paragraph where it starts

% a change to the lines of the text
kind insertion type.
type mark-at int -> int -> string -> insertion.   % a text at a line and a column
type message-after int -> string -> insertion.    % a line after a line

% [write-md Out Lines Top Rs]: the checked text of the lines of a file,
% whose top node is Top, written to the file Out
pred write-md i:string, i:list string, i:prooftext.node, i:list report.
write-md Out Lines Top Rs :-
  prooftext.all-nodes "0" Top All,
  std.map All (node-insertions Rs) Inss, std.flatten Inss Ins,
  prooftext.number-lines 0 Lines Numbered,
  std.map Numbered (checked-lines Ins) Outs, std.flatten Outs OutLines,
  open_out Out O,
  std.forall OutLines (l\ output O {calc (l ^ "\n")}),
  close_out O.

% [node-insertions Rs Node Ins]: the mark and the message of a numbered
% node
pred node-insertions i:list report, i:pair string prooftext.node, o:list insertion.
node-insertions Rs (pr Id (prooftext.node _ _ (prooftext.spot L C) (prooftext.spot ML MC) _)) Ins :-
  status-of Rs Id S M, prooftext.status-mark S Mk,
  (if (S = "todo") (Num is " " ^ {prooftext.conditions-mark Id}) (Num = "")),
  Mark = mark-at L C {calc (Mk ^ Num ^ " ")},
  (if (M = "") (Ins = [Mark])
     (spaces MC Pad, Ins = [Mark, message-after ML {calc (Pad ^ {prooftext.message-block M})}])).

% [spaces N S]: N spaces
pred spaces i:int, o:string.
spaces N "" :- N =< 0, !.
spaces N S :- N1 is N - 1, spaces N1 S1, S is " " ^ S1.

% [checked-lines Ins Line Out]: the line with its marks (from the right,
% so that the columns of the others stay right), then the messages after
% it, each between empty lines
pred checked-lines i:list insertion, i:prooftext.numbered-line, o:list string.
checked-lines Ins (prooftext.nl N S) [S1 | After] :-
  std.map-filter Ins (i\ m\ sigma C T\ i = mark-at N C T, m = pr C T) Marks,
  by-column-down Marks Sorted,
  std.fold Sorted S insert-mark S1,
  std.map-filter Ins (i\ m\ i = message-after N m) Ms,
  std.map Ms (m\ ls\ ls = ["", m, ""]) Mss, std.flatten Mss After.

% [insert-mark Mark S S1]: S with the text of Mark at its column
pred insert-mark i:pair int string, i:string, o:string.
insert-mark (pr C T) S S1 :-
  L is size S, (C < L, C1 = C ; C1 = L), !,
  S1 is substring S 0 C1 ^ T ^ substring S C1 (L - C1).

% [by-column-down Marks Sorted]: the marks, their columns from the largest
pred by-column-down i:list (pair int string), o:list (pair int string).
by-column-down [] [].
by-column-down [M | Ms] Sorted :- by-column-down Ms S1, insert-by-column M S1 Sorted.

% [insert-by-column M Ms Ms1]: M inserted in Ms, sorted by column down
pred insert-by-column i:pair int string, i:list (pair int string), o:list (pair int string).
insert-by-column M [] [M].
insert-by-column (pr C T) [pr C1 T1 | Ms] [pr C T, pr C1 T1 | Ms] :- C >= C1, !.
insert-by-column M [X | Ms] [X | Ms1] :- insert-by-column M Ms Ms1.

% ------------------------------------------------------------------ %
% The JSON for the editor: per node its number, its lines, its status,
% its formulas and its message

% [json-string S J]: S as a JSON string
pred json-string i:string, o:string.
json-string S J :-
  rex.replace "\\\\" "\\\\\\\\" S S1, rex.replace "\"" "\\\\\"" S1 S2,
  rex.replace "\n" "\\\\n" S2 S3, J is "\"" ^ S3 ^ "\"".

% [write-json Out Top Rs]: the JSON file Out for the editor: each node of
% the tree of Top, in the order of the text
pred write-json i:string, i:prooftext.node, i:list report.
write-json Out Top Rs :-
  prooftext.all-nodes "0" Top All,
  std.map All (json-node Rs) Js, std.string.concat "," Js J,
  open_out Out O, output O {calc ("{\"steps\":[" ^ J ^ "]}\n")}, close_out O.

% [json-node Rs Node J]: the JSON object of a numbered node
pred json-node i:list report, i:pair string prooftext.node, o:string.
json-node Rs (pr Id (prooftext.node _ Place _ _ _ as N)) J :-
  place-lines Place F La,
  status-of Rs Id S M,
  prooftext.node-parts N Ps, std.map-filter Ps json-formula Fs, std.string.concat "," Fs FJ,
  J is "{\"id\":\"" ^ Id ^ "\",\"first\":" ^ {std.any->string F} ^ ",\"last\":" ^
     {std.any->string La} ^ ",\"status\":\"" ^ S ^ "\",\"formulas\":[" ^ FJ ^
     "],\"message\":" ^ {json-string M} ^ "}".

% [place-lines P First Last]: the lines of a place
pred place-lines i:prooftext.place, o:int, o:int.
place-lines (prooftext.lines F L) F L.
place-lines prooftext.unplaced 0 0.

% [json-formula P J]: a formula of a role, as a JSON object
pred json-formula i:prooftext.text-part, o:string.
json-formula (prooftext.formula-part C X _) J :-
  prooftext.role-tag _ C, !, J is "{\"role\":\"" ^ C ^ "\",\"text\":" ^ {json-string X} ^ "}".
